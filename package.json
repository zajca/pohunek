{
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "sdk/ts/*",
    "web/*"
  ],
  "scripts": {
    "dev": "bun run web/scripts/dev.ts",
    "build:frontend": "cd web/frontend && bun run build",
    "typecheck": "bun run web/scripts/typecheck.ts",
    "lint": "eslint \"sdk/ts/**/*.ts\" \"web/**/*.{ts,svelte}\" --max-warnings=0",
    "test": "bun test",
    "test:e2e": "bun run build:frontend && bun ./node_modules/@playwright/test/cli.js test --config web/frontend/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@pohunek/backend": "workspace:*",
    "@pohunek/protocol": "workspace:*",
    "@pohunek/testkit": "workspace:*",
    "@types/bun": "1.3.11",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-svelte": "3.22.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "8.1.5"
  }
}
