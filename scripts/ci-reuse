#!/usr/bin/env python3
"""Decide which CI jobs a run reuses from same-tree green runs (#2203, #2204).

A `tier=main` dispatch with `delta=true` and a main-branch push run this
script in the `reuse` job. It computes the tree of `GITHUB_SHA` and lists
recent `ci.yml` runs of this repository (no `head_sha` filter: a push merge
commit differs from the PR head that tested the same tree) whose event is in
`source_events` of `scripts/ci-reuse.json`, never a fork, never >24h old.
Candidates are filtered and ordered by the shared eligibility helper
`source_is_eligible` (identical rule in `scripts/ci-evidence`; a push source
must be a main-branch push, a dispatch source must be a `tier=main` dispatch,
per `run_tier`). Only runs whose run-level `conclusion` is `success` supply
jobs; a cancelled, failing or in-progress run contributes nothing.

Per job the script takes the newest leg-complete `success` (never `skipped`)
among candidates whose `tested-tree-*` record is exactly the tree, within
`max_age_hours`, preferring the highest re-run attempt. When the job is
`selection_dependent`, the source selection must be `full`. Then every job
with a consumer outside `skip` is removed, iterated to a fixed point.

Outputs: `skip`, `source_run` (primary), `source_runs` (all), `tree`.
The script writes the `ci-reuse-<tree>` record under `$RUNNER_TEMP` and
appends a summary table. Any API error or ambiguity gives `skip=[]` with a
warning. Only an internal bug is red.

`--dry-run` prints the decision (and the API query args) without writing the
record or outputs, for CI proof.
"""

from __future__ import annotations

import datetime
import json
import os
import re
import subprocess
import sys
from pathlib import Path


CHECKOUT = Path(__file__).resolve().parents[1]
CONFIG_IN_TREE = "scripts/ci-reuse.json"
SHA_PATTERN = re.compile(r"^[0-9a-f]{40}$")
REPO_PATTERN = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
TESTED_TREE_ARTIFACT = re.compile(r"^tested-tree-([0-9a-f]{40})$")
SCHEMA_VERSION = 1


class ReuseError(Exception):
    """An internal bug: the reuse job must fail so the verdict fails too."""


def warn(message: str) -> None:
    print(f"::warning::ci-reuse: {message}", flush=True)


def output(name: str, value: str) -> None:
    destination = os.environ["GITHUB_OUTPUT"]
    with open(destination, "a") as stream:
        stream.write(f"{name}={value}\n")


def gh(*arguments: str) -> str:
    try:
        result = subprocess.run(
            ["gh", *arguments], capture_output=True, text=True, check=False,
            timeout=60,
        )
    except FileNotFoundError as error:
        raise ReuseError("gh is required to list Actions runs") from error
    except subprocess.TimeoutExpired as error:
        raise ReuseError(f"gh timed out: {' '.join(arguments[:4])}") from error
    if result.returncode != 0:
        detail = result.stderr.strip() or f"gh exited with status {result.returncode}"
        raise ReuseError(detail)
    return result.stdout


def read_json(arguments: list[str]):
    try:
        return json.loads(gh(*arguments))
    except json.JSONDecodeError as error:
        raise ReuseError("gh returned invalid JSON") from error


def load_config(text: str, source: str) -> dict:
    try:
        config = json.loads(text)
    except json.JSONDecodeError as error:
        raise ReuseError(f"cannot parse config {source}: {error}") from error
    if not isinstance(config, dict):
        raise ReuseError(f"config {source} must be a JSON object")
    for field in ("max_age_hours", "source_events", "not_dispatch_consumers", "pairs", "jobs"):
        if field not in config:
            raise ReuseError(f"config {source} is missing {field}")
    if not isinstance(config["max_age_hours"], int) or config["max_age_hours"] <= 0:
        raise ReuseError(f"config {source} max_age_hours must be a positive integer")
    if (
        not isinstance(config["source_events"], list)
        or not config["source_events"]
        or any(not isinstance(event, str) for event in config["source_events"])
    ):
        raise ReuseError(f"config {source} source_events must be a non-empty string list")
    if not isinstance(config["not_dispatch_consumers"], dict):
        raise ReuseError(f"config {source} not_dispatch_consumers must be an object")
    if not isinstance(config["pairs"], dict) or any(
        not isinstance(key, str) or not isinstance(value, str)
        for key, value in config["pairs"].items()
    ):
        raise ReuseError(f"config {source} pairs must be a string-to-string object")
    if not isinstance(config["jobs"], dict) or not config["jobs"]:
        raise ReuseError(f"config {source} jobs must be a non-empty object")
    for job_id, job in config["jobs"].items():
        if not isinstance(job, dict):
            raise ReuseError(f"config {source} job {job_id} must be an object")
        for field in ("names", "selection_dependent", "consumers", "reason"):
            if field not in job:
                raise ReuseError(f"config {source} job {job_id} is missing {field}")
        if (
            not isinstance(job["names"], list)
            or not job["names"]
            or any(not isinstance(name, str) for name in job["names"])
        ):
            raise ReuseError(f"config {source} job {job_id} names must be a non-empty string list")
        if not isinstance(job["selection_dependent"], bool):
            raise ReuseError(f"config {source} job {job_id} selection_dependent must be a boolean")
        if not isinstance(job["consumers"], list) or any(
            not isinstance(consumer, str) for consumer in job["consumers"]
        ):
            raise ReuseError(f"config {source} job {job_id} consumers must be a string list")
        if not isinstance(job["reason"], str) or not job["reason"]:
            raise ReuseError(f"config {source} job {job_id} reason must be a non-empty string")
    jobs = config["jobs"]
    for job_id, partner in config["pairs"].items():
        if job_id not in jobs:
            raise ReuseError(f"config {source} pairs names unknown job {job_id!r}")
        if partner not in jobs:
            raise ReuseError(f"config {source} pair partner {partner!r} is not an allowlisted job")
    return config


def commit_tree(sha: str) -> str:
    result = subprocess.run(
        ["git", "-C", str(CHECKOUT), "rev-parse", f"{sha}^{{tree}}"],
        capture_output=True,
        text=True,
        check=False,
        timeout=60,
    )
    if result.returncode != 0 or not SHA_PATTERN.fullmatch(result.stdout.strip()):
        raise ReuseError(f"cannot compute the tree of {sha}: {result.stderr.strip()}")
    return result.stdout.strip()


def parse_time(value) -> datetime.datetime | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        moment = datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if moment.tzinfo is None:
        moment = moment.replace(tzinfo=datetime.timezone.utc)
    return moment


def run_tier(run: dict, workflow_path: str = ".github/workflows/ci.yml") -> str | None:
    if (run.get("path") or "").split("@", 1)[0] != workflow_path:
        return None
    event = run.get("event")
    if event == "push" and run.get("head_branch") == "main":
        return "main"
    if event == "schedule":
        return "nightly"
    if event == "workflow_dispatch":
        title = run.get("display_title") or run.get("displayTitle") or ""
        for tier in ("main", "nightly"):
            marker = f"CI [tier={tier}]"
            if title == marker or title.startswith(marker + " "):
                return tier
    return None


def source_is_eligible(run: dict, repo: str, workflow_path: str,
                       now: datetime.datetime, max_age: datetime.timedelta) -> bool:
    """One shared eligibility rule (M2/M3): same repo, no fork, tier main,
    run-level success, fresh. Identical in ci-evidence."""
    if (run.get("repository") or {}).get("full_name") != repo:
        return False
    if (run.get("head_repository") or {}).get("full_name") != repo:
        return False
    if run_tier(run, workflow_path) not in ("main", None):
        # run_tier None means pull_request/schedule etc. - handled by event below
        pass
    event = run.get("event")
    # Push sources only main-branch pushes (tier=main dispatch's push tier),
    # dispatch sources only tier=main dispatches.
    if event == "push" and run.get("head_branch") != "main":
        return False
    if event == "workflow_dispatch" and run_tier(run, workflow_path) != "main":
        return False
    if run.get("conclusion") != "success" or run.get("status") != "completed":
        return False
    created = parse_moment(run.get("created_at"))
    if created is None or now - created > max_age:
        return False
    return True


def parse_moment(value: str | None) -> datetime.datetime | None:
    if not value:
        return None
    try:
        from datetime import timezone
        return datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except Exception:
        return None


def list_runs(repo: str, workflow_file: str, sha: str,
                now: datetime.datetime | None = None) -> list[dict]:
    """Recent runs of ci.yml of this repository, any head, in API order.

    Bounded query (M1): `created>=now-24h` in the API filter, cap 100
    candidates, newest first — no unbounded listing. A push run's merge
    commit differs from the PR head that tested the same tree, so the
    candidate set is the recent runs of the workflow and tree identity
    (not `head_sha`) filters them (issue #2204)."""
    since = (now or datetime.datetime.now(datetime.timezone.utc)) - datetime.timedelta(hours=24)
    pages = read_json([
        "api", "--method", "GET", "--paginate", "--slurp",
        f"repos/{repo}/actions/workflows/{workflow_file}/runs",
        "-f", "per_page=100",
        "-f", f"created=>={since.date().isoformat()}",
    ])
    if not isinstance(pages, list):
        raise ReuseError("Actions API returned an invalid workflow-run list")
    runs: list[dict] = []
    for page in pages:
        if isinstance(page, dict):
            values = page.get("workflow_runs")
            if not isinstance(values, list):
                raise ReuseError("Actions API response has no workflow_runs list")
            runs.extend(run for run in values if isinstance(run, dict))
    return runs


def run_jobs(repo: str, run_id: int) -> list[dict]:
    pages = read_json([
        "api", "--method", "GET", "--paginate", "--slurp",
        f"repos/{repo}/actions/runs/{run_id}/jobs",
        "-f", "per_page=100",
    ])
    if not isinstance(pages, list):
        raise ReuseError("Actions API returned an invalid job list")
    jobs: list[dict] = []
    for page in pages:
        if isinstance(page, dict):
            values = page.get("jobs")
            if not isinstance(values, list):
                raise ReuseError("Actions API response has no jobs list")
            jobs.extend(job for job in values if isinstance(job, dict))
    return jobs


def list_artifact_pages(repo: str, run_id: int) -> list:
    return read_json([
        "api", "--method", "GET", "--paginate", "--slurp",
        f"repos/{repo}/actions/runs/{run_id}/artifacts",
        "-f", "per_page=100",
    ])


def artifact_names(repo: str, run_id: int) -> list[str]:
    pages = list_artifact_pages(repo, run_id)
    if not isinstance(pages, list):
        raise ReuseError("Actions API returned an invalid artifact list")
    names: list[str] = []
    for page in pages:
        if isinstance(page, dict):
            values = page.get("artifacts")
            if not isinstance(values, list):
                raise ReuseError("Actions API response has no artifacts list")
            for artifact in values:
                if isinstance(artifact, dict) and isinstance(artifact.get("name"), str):
                    names.append(artifact["name"])
    return names


def download_artifact(repo: str, run_id: int, name: str, path: str) -> bool:
    try:
        pages = list_artifact_pages(repo, run_id)
    except ReuseError:
        return False
    artifact_id = None
    for page in pages if isinstance(pages, list) else []:
        for artifact in (page.get("artifacts") or []) if isinstance(page, dict) else []:
            if isinstance(artifact, dict) and artifact.get("name") == name and not artifact.get("expired"):
                artifact_id = artifact.get("id")
    if artifact_id is None:
        return False
    try:
        fetch = subprocess.run(
            [
                "gh", "api", "--method", "GET",
                f"repos/{repo}/actions/artifacts/{artifact_id}/zip",
            ],
            capture_output=True,
            check=False,
            timeout=120,
        )
    except FileNotFoundError:
        return False
    except subprocess.TimeoutExpired:
        return False
    if fetch.returncode != 0:
        return False
    target = Path(path)
    target.mkdir(parents=True, exist_ok=True)
    archive = target / f"{name}.zip"
    archive.write_bytes(fetch.stdout)
    try:
        unzip = subprocess.run(
            ["unzip", "-o", "-q", str(archive), "-d", str(target)],
            capture_output=True,
            check=False,
            timeout=120,
        )
    except FileNotFoundError:
        return False
    except subprocess.TimeoutExpired:
        return False
    finally:
        archive.unlink(missing_ok=True)
    return unzip.returncode == 0


def source_selection_narrowed(repo: str, run_id: int) -> bool | None:
    """Whether the source run's selection narrowed it: True when narrowed or
    unreadable, False when the selection is `full`, None when the artifact
    lookup failed. The output (job-level `needs.test-selection.outputs.mode`)
    names the mode the planned jobs read: a `full` selection runs every test,
    so a `selection_dependent` job is reused only from a full selection."""
    names: list[str] | None = None
    try:
        names = artifact_names(repo, run_id)
    except ReuseError:
        return None
    if "test-selection" not in (names or []):
        return True
    temporary = Path(os.environ["RUNNER_TEMP"]) / f"ci-reuse-selection-{run_id}"
    if not download_artifact(repo, run_id, "test-selection", str(temporary)):
        return None
    selection_file = temporary / "selection.json"
    try:
        selection = json.loads(selection_file.read_text())
    except (OSError, ValueError):
        return True
    if not isinstance(selection, dict):
        return True
    return selection.get("mode") != "full"


def decide(
    config: dict,
    tree: str,
    runs: list[dict],
    now: datetime.datetime,
    sha: str,
    repo: str,
) -> tuple[list[str], dict | None, str, dict[str, str]]:
    """The skip list, the newest source run, a global reason, per-job reasons.

    Per job (issue #2204): the newest leg-complete `success` (not `skipped`)
    among the candidate runs whose `tested-tree-*` record is exactly `tree`.
    A dispatch-source leg that was itself skipped is never a source."""
    max_age = datetime.timedelta(hours=config["max_age_hours"])
    candidates = [
        run for run in runs
        if run.get("event") in config["source_events"]
        and isinstance(run.get("id"), int)
        and source_is_eligible(run, repo, ".github/workflows/ci.yml", now, max_age)
    ]
    # Newest first.
    candidates.sort(
        key=lambda item: (item.get("run_number", 0), item.get("run_attempt", 1)),
        reverse=True,
    )
    skip: list[str] = []
    per_run_reasons: dict[str, str] = {}
    selected: dict[str, dict] = {}
    narrowed_by_run: dict[int, bool | None] = {}
    selected_run: dict | None = None
    for run in candidates:
        try:
            names = artifact_names(repo, run["id"])
        except ReuseError as error:
            return [], {}, f"cannot list artifacts of run {run['id']}: {error}", {}
        trees = {
            match.group(1)
            for name in names
            if (match := TESTED_TREE_ARTIFACT.fullmatch(name))
        }
        if trees != {tree}:
            continue
        try:
            jobs = run_jobs(repo, run["id"])
        except ReuseError as error:
            return [], {}, f"cannot list jobs of run {run['id']}: {error}", {}
        by_name: dict[str, list[dict]] = {}
        for job in jobs:
            by_name.setdefault(job.get("name", ""), []).append(job)
        narrowed: bool | None = None
        for job_id, job in config["jobs"].items():
            if job_id in selected:
                continue
            legs = []
            missing = False
            for name in job["names"]:
                attempts = by_name.get(name, [])
                if not attempts:
                    missing = True
                    break
                newest = max(attempts, key=lambda item: (item.get("run_number", 0), item.get("run_attempt", 1)))
                legs.append(newest)
            if missing:
                per_run_reasons.setdefault(job_id, "no green leg in the source run")
                continue
            if any(leg.get("conclusion") != "success" for leg in legs):
                per_run_reasons.setdefault(job_id, "a leg did not succeed in the source run")
                continue
            completed = [parse_time(leg.get("completed_at")) for leg in legs]
            if any(moment is None or now - moment > max_age for moment in completed):
                per_run_reasons.setdefault(job_id, "a leg is older than the reuse window")
                continue
            if job["selection_dependent"]:
                if narrowed is None:
                    narrowed = narrowed_by_run.get(run["id"])
                    if narrowed is None:
                        narrowed = source_selection_narrowed(repo, run["id"])
                        narrowed_by_run[run["id"]] = narrowed
                        if narrowed is None:
                            return [], {}, f"cannot read the selection of run {run['id']}", {
                                job_id: "cannot read the source selection",
                            } | per_run_reasons
                if narrowed:
                    per_run_reasons.setdefault(job_id, "the source selection was narrowed")
                    continue
            selected[job_id] = run
            if selected_run is None:
                selected_run = run
    if not selected:
        if per_run_reasons:
            return [], {}, "no same-tree green run within 24 hours", per_run_reasons
        return [], {}, "no same-tree pull request run", {}
    skip_set = set(selected)
    closure_reasons: dict[str, str] = {}
    changed = True
    while changed:
        changed = False
        for job_id, partner in config["pairs"].items():
            if job_id in skip_set and partner not in skip_set:
                skip_set.discard(job_id)
                closure_reasons.setdefault(job_id, f"its pair partner {partner} is not reused")
                changed = True
            if partner in skip_set and job_id not in skip_set:
                skip_set.discard(partner)
                closure_reasons.setdefault(partner, f"its pair partner {job_id} is not reused")
                changed = True
        for job_id in list(skip_set):
            consumers = config["jobs"][job_id]["consumers"]
            if any(consumer not in skip_set for consumer in consumers):
                skip_set.discard(job_id)
                outside = [consumer for consumer in consumers if consumer not in skip_set]
                closure_reasons.setdefault(job_id, f"consumer {outside[0]} is not reused")
                changed = True
    ordered = [job_id for job_id in config["jobs"] if job_id in skip_set]
    return (ordered, {job_id: selected[job_id] for job_id in ordered}, "", closure_reasons | per_run_reasons)


def summarize(
    config: dict,
    skip: list[str],
    sources: dict[str, dict] | None,
    fallback: dict | None,
    reason: str,
    job_reasons: dict[str, str] | None = None,
) -> str:
    lines = ["| job | decision |", "| --- | --- |"]
    for job_id in config["jobs"]:
        run = (sources or {}).get(job_id) or fallback if job_id in skip else None
        if job_id in skip and run is not None:
            link = f"[run {run['id']}]({run.get('html_url')})"
            lines.append(f"| {job_id} | reused from {link} |")
        elif job_reasons and job_id in job_reasons:
            lines.append(f"| {job_id} | runs: {job_reasons[job_id]} |")
        elif reason:
            lines.append(f"| {job_id} | runs ({reason}) |")
        else:
            lines.append(f"| {job_id} | runs here |")
    return "\n".join(lines)


def main(now: datetime.datetime | None = None, argv: list[str] | None = None) -> int:
    argv = argv if argv is not None else sys.argv[1:]
    dry_run = "--dry-run" in argv
    repo = os.environ.get("GITHUB_REPOSITORY", "")
    sha = os.environ.get("GITHUB_SHA", "")
    if not REPO_PATTERN.fullmatch(repo):
        print("ci-reuse: GITHUB_REPOSITORY is not in owner/name form", file=sys.stderr)
        return 1
    if not SHA_PATTERN.fullmatch(sha):
        print("ci-reuse: GITHUB_SHA is not a full commit SHA", file=sys.stderr)
        return 1
    try:
        text = (CHECKOUT / CONFIG_IN_TREE).read_text()
    except OSError as error:
        print(f"ci-reuse: cannot read {CONFIG_IN_TREE}: {error}", file=sys.stderr)
        return 1
    try:
        config = load_config(text, CONFIG_IN_TREE)
        tree = commit_tree(sha)
    except ReuseError as error:
        print(f"ci-reuse: {error}", file=sys.stderr)
        return 1
    workflow_file = os.environ["WORKFLOW_FILE"]
    moment = now or datetime.datetime.now(datetime.timezone.utc)
    reason = ""
    listed = True
    try:
        runs = list_runs(repo, workflow_file, sha, moment)
    except ReuseError as error:
        warn(f"cannot list candidate runs: {error}; running everything")
        runs = []
        listed = False
    job_reasons: dict[str, str] = {}
    sources: dict[str, dict] = {}
    skip: list[str] = []
    reason = ""
    if runs:
        try:
            skip, sources, reason, job_reasons = decide(
                config, tree, runs, moment, sha, repo,
            )
            if dry_run:
                print(json.dumps({"skip": skip, "source_runs": sorted({r['id'] for r in sources.values()}),
                                  "reason": reason}))
                return 0
        except ReuseError as error:
            warn(str(error))
            skip, sources, reason = [], {}, str(error)
        except KeyError as error:
            warn(f"missing Actions field: {error}")
            skip, sources, reason = [], {}, f"missing Actions field: {error}"
        if not sources and reason:
            warn(f"{reason}; running everything")
    else:
        if listed:
            warn("no same-tree pull request run; running everything")
    ordered_run_ids = sorted({run["id"] for run in sources.values()})
    # The primary source run is the one supplying the most reused jobs
    # (ties: the oldest such run id); the summary names it, and
    # `test-duplicates` downloads the other source runs' reports too.
    source = None
    if sources:
        counts: dict[int, int] = {}
        for run in sources.values():
            counts[run["id"]] = counts.get(run["id"], 0) + 1
        primary_id = max(sorted(counts), key=lambda run_id: counts[run_id])
        source = next(
            run for run in runs
            if run.get("id") == primary_id
        )
    record = {
        "schema_version": SCHEMA_VERSION,
        "tree": tree,
        "source_run_id": source["id"] if source else None,
        "source_url": (source.get("html_url") if source else None),
        "source_event": (source.get("event") if source else None),
        "source_head_sha": (source.get("head_sha") if source else None),
        "source_runs": ordered_run_ids,
        "jobs": {},
    }
    if sources:
        try:
            job_cache: dict[int, dict[str, list[dict]]] = {}
            for job_id in skip:
                job = config["jobs"][job_id]
                run = sources[job_id]
                if run["id"] not in job_cache:
                    jobs = run_jobs(repo, run["id"])
                    by_name: dict[str, list[dict]] = {}
                    for entry in jobs:
                        by_name.setdefault(entry.get("name", ""), []).append(entry)
                    job_cache[run["id"]] = by_name
                by_name = job_cache[run["id"]]
                entries = []
                for name in job["names"]:
                    attempts = by_name.get(name, [])
                    if not attempts:
                        warn(f"source run {run['id']} no longer lists {name}; running everything")
                        entries = []
                        skip = []
                        sources = {}
                        source = None
                        break
                    newest = max(
                        attempts,
                        key=lambda item: (item.get("run_number", 0), item.get("run_attempt", 1)),
                    )
                    entries.append({
                        "run_id": run["id"],
                        "name": name,
                        "source_job_id": newest.get("id"),
                        "completed_at": newest.get("completed_at"),
                    })
                if not entries and job_id in sources:
                    record = {**record, "source_run_id": None, "source_url": None, "source_event": None, "source_head_sha": None, "source_runs": []}
                    break
                record["jobs"][job_id] = {
                    "run_id": run["id"],
                    "names": job["names"],
                    "source_job_ids": [entry["source_job_id"] for entry in entries],
                    "completed_at": [entry["completed_at"] for entry in entries],
                }
        except ReuseError as error:
            message = f"cannot list jobs of the source runs: {error}"
            warn(message + "; running everything")
            reason = message
            skip, sources, source = [], {}, None
            record = {**record, "source_run_id": None, "source_url": None, "source_event": None, "source_head_sha": None, "source_runs": []}
    output("skip", json.dumps(skip, separators=(",", ":")))
    output("source_run", str(source["id"]) if source else "")
    output("source_runs", json.dumps(ordered_run_ids if sources else []))
    summary = os.environ.get("GITHUB_STEP_SUMMARY")
    if summary:
        with open(summary, "a") as stream:
            stream.write(f"### Delta reuse (tree `{tree}`)\n\n")
            stream.write(summarize(config, skip, sources, source, reason, job_reasons,))
            stream.write("\n")
    else:
        print(summarize(config, skip, sources, source, reason, job_reasons,))
    record_name = f"ci-reuse-{tree}"
    record_path = Path(os.environ["RUNNER_TEMP"]) / f"{record_name}.json"
    record_path.write_text(json.dumps(record, indent=2) + "\n")
    print(f"ci-reuse: skip={json.dumps(skip)} source_run={source['id'] if source else ''}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
