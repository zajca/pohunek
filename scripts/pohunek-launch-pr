#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_dir/lib.sh"

[ "$#" -ge 2 ] && [ "$#" -le 3 ] || pohunek_fail "usage: pohunek-launch-pr <project> <github-pr-number> [action]"
project="$1"
pr_number="$2"
action="${3:-process-pr}"

pohunek_bin="$(pohunek_optional_config pohunek_bin pohunek)"
gh_bin="$(pohunek_optional_config gh_bin gh)"
host="$(pohunek_required_config host)"
yes="$(pohunek_optional_config yes false)"

pohunek_need_cmd "$gh_bin"

# Agent + prompt template come from the daemon-resolved action (the single source
# of truth, Part A); provider fetch + rendering stay here with the GitHub creds.
# A `prompt_not_found` from the daemon aborts before any session is started.
prompt_template="$(mktemp "${TMPDIR:-/tmp}/pohunek-prompt.XXXXXX")"
trap 'rm -f "$prompt_template"' EXIT INT TERM
recipe="$(pohunek_resolve_action "$pohunek_bin" "$host" "$project" "$action" "$prompt_template")"
provider="$(printf '%s\n' "$recipe" | sed -n 1p)"
agent="$(printf '%s\n' "$recipe" | sed -n 2p)"
base_branch="$(printf '%s\n' "$recipe" | sed -n 3p)"
recipe_branch="$(printf '%s\n' "$recipe" | sed -n 4p)"

[ "$provider" = "github_pr" ] || pohunek_fail "action '$action' resolved provider '$provider'; expected github_pr"
[ -z "$recipe_branch" ] || pohunek_fail "action '$action' returned branch for provider '$provider'"

context_json="$("$gh_bin" pr view "$pr_number" --json title,body,headRefName,url)"
prompt="$(pohunek_render_provider_prompt "$prompt_template" github_pr "$pr_number" "$context_json")"
url="$(pohunek_json_url "$context_json")"
[ -n "$url" ] || pohunek_fail "provider JSON missing url"
link_meta="$(pohunek_link_meta github_pr "$pr_number" "$url" "$context_json")"
branch="$(printf '%s\n' "$link_meta" | sed -n 's/^link\.branch=//p')"
[ -n "$branch" ] || pohunek_fail "provider link metadata missing link.branch"

pohunek_run_session_new "$pohunek_bin" "$host" "$agent" "$project" "$branch" "$prompt" "$yes" "$base_branch" "$link_meta"
