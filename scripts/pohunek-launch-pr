#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_dir/lib.sh"

[ "$#" -eq 1 ] || pohunek_fail "usage: pohunek-launch-pr <github-pr-number>"
pr_number="$1"

pohunek_bin="$(pohunek_optional_config pohunek_bin pohunek)"
gh_bin="$(pohunek_optional_config gh_bin gh)"
agent="$(pohunek_required_config agent)"
host="$(pohunek_required_config host)"
project="$(pohunek_required_config project)"
yes="$(pohunek_optional_config yes false)"
template="$(pohunek_template_path pr)"

pohunek_need_cmd "$gh_bin"

context_json="$("$gh_bin" pr view "$pr_number" --json title,body,headRefName,url)"
prompt="$(pohunek_render_provider_prompt "$template" github_pr "$pr_number" "$context_json")"
branch="$(python3 - "$context_json" <<'PY'
import json
import sys

data = json.loads(sys.argv[1])
branch = data.get("headRefName") or data.get("branch") or data.get("branchName")
if not isinstance(branch, str) or not branch:
    raise SystemExit("GitHub PR JSON missing headRefName")
sys.stdout.write(branch)
PY
)"

pohunek_run_session_new "$pohunek_bin" "$host" "$agent" "$project" "$branch" "$prompt" "$yes"
