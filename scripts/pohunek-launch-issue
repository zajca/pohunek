#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$script_dir/lib.sh"

[ "$#" -eq 1 ] || pohunek_fail "usage: pohunek-launch-issue <linear-issue-id>"
issue_id="$1"

pohunek_bin="$(pohunek_optional_config pohunek_bin pohunek)"
linear_cli="$(pohunek_required_config linear_cli)"
host="$(pohunek_required_config host)"
project="$(pohunek_required_config project)"
action="$(pohunek_optional_config issue_action process-issue)"
yes="$(pohunek_optional_config yes false)"

pohunek_need_cmd "$linear_cli"

# Agent + prompt template come from the daemon-resolved action (the single source
# of truth, Part A); provider fetch + rendering stay here with the Linear creds.
# A `prompt_not_found` from the daemon aborts before any session is started.
prompt_template="$(mktemp "${TMPDIR:-/tmp}/pohunek-prompt.XXXXXX")"
trap 'rm -f "$prompt_template"' EXIT INT TERM
recipe="$(pohunek_resolve_action "$pohunek_bin" "$host" "$project" "$action" "$prompt_template")"
agent="$(printf '%s\n' "$recipe" | sed -n 1p)"
base_branch="$(printf '%s\n' "$recipe" | sed -n 2p)"

context_json="$("$linear_cli" issue view "$issue_id" --json)"
prompt="$(pohunek_render_provider_prompt "$prompt_template" linear_issue "$issue_id" "$context_json")"
branch="$(python3 - "$context_json" <<'PY'
import json
import sys

data = json.loads(sys.argv[1])
branch = data.get("branchName") or data.get("branch")
if not isinstance(branch, str) or not branch:
    raise SystemExit("Linear issue JSON missing branchName")
sys.stdout.write(branch)
PY
)"

pohunek_run_session_new "$pohunek_bin" "$host" "$agent" "$project" "$branch" "$prompt" "$yes" "$base_branch"
