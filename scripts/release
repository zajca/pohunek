#!/bin/sh

# Cut a new release: bump the workspace version, refresh the lockfile, commit,
# tag `vX.Y.Z`, and push. Pushing the tag triggers .github/workflows/release.yml,
# which builds the binaries and publishes the GitHub Release.
#
# Usage:
#   scripts/release patch        # 0.1.0 -> 0.1.1
#   scripts/release minor        # 0.1.0 -> 0.2.0
#   scripts/release major        # 0.1.0 -> 1.0.0
#   scripts/release 1.4.2        # explicit version
#
# Options:
#   --dry-run    Show what would happen without changing anything.
#   --no-push    Commit and tag locally, but do not push.
#   --notes FILE Release-notes file with one line naming each schema or protocol
#                constant that changed since the previous tag (required when
#                any changed; see the compatibility check below).

set -eu

pohunek_fail() {
  printf 'pohunek: %s\n' "$*" >&2
  exit 1
}

pohunek_info() { printf 'release: %s\n' "$*"; }

pohunek_need_cmd() {
  command -v "$1" >/dev/null 2>&1 || pohunek_fail "required command not found: $1"
}

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
manifest="$repo_root/Cargo.toml"
release_branch="${POHUNEK_RELEASE_BRANCH:-main}"

dry_run=false
push=true
bump=""
notes_file=""
expect_notes=false

for arg in "$@"; do
  if [ "$expect_notes" = true ]; then
    notes_file="$arg"
    expect_notes=false
    continue
  fi
  case "$arg" in
    --notes) expect_notes=true ;;
    --dry-run) dry_run=true ;;
    --no-push) push=false ;;
    patch | minor | major) bump="$arg" ;;
    [0-9]*.[0-9]*.[0-9]*) bump="$arg" ;;
    -h | --help)
      sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) pohunek_fail "unknown argument: $arg (use patch|minor|major|X.Y.Z, --dry-run, --no-push, --notes FILE)" ;;
  esac
done

[ "$expect_notes" = false ] || pohunek_fail "--notes needs a file argument"
[ -n "$bump" ] || pohunek_fail "usage: scripts/release <patch|minor|major|X.Y.Z> [--dry-run] [--no-push] [--notes FILE]"

pohunek_need_cmd git
pohunek_need_cmd cargo

# Read the current version from the [workspace.package] table.
current="$(awk '
  /^\[workspace\.package\]/ { in_pkg = 1; next }
  /^\[/ { in_pkg = 0 }
  in_pkg && /^version[[:space:]]*=/ {
    gsub(/[^0-9.]/, "")
    print
    exit
  }
' "$manifest")"

[ -n "$current" ] || pohunek_fail "could not read version from [workspace.package] in $manifest"

case "$current" in
  [0-9]*.[0-9]*.[0-9]*) ;;
  *) pohunek_fail "current version is not semver: $current" ;;
esac

# Compute the target version.
case "$bump" in
  patch | minor | major)
    major=${current%%.*}
    rest=${current#*.}
    minor=${rest%%.*}
    patch=${rest#*.}
    case "$bump" in
      major) major=$((major + 1)); minor=0; patch=0 ;;
      minor) minor=$((minor + 1)); patch=0 ;;
      patch) patch=$((patch + 1)) ;;
    esac
    next="$major.$minor.$patch"
    ;;
  *)
    next="$bump"
    ;;
esac

tag="v$next"

# Persisted-state and wire-compatibility constants, as "NAME|git pathspec". A
# change to any of them alters the upgrade contract (AGENTS.md, "Upgrade
# window"), so the release notes must carry a line naming each changed one.
compat_constants="
STORE_SCHEMA_VERSION|crates/daemon/src/store
PROTOCOL_VERSION|crates/protocol/src/version.rs
MIN_PROTOCOL_VERSION|crates/protocol/src/version.rs
CURRENT_VERSION|crates/worker-protocol/src/version.rs
PREVIOUS_VERSION|crates/worker-protocol/src/version.rs
WORKER_JOURNAL_SCHEMA_VERSION|crates/daemon/src/runtime
EXPECTED_INTEGRATION_VERSION|crates/protocol/src/integration.rs
"

# Prints the right-hand side of `const NAME` under pathspec at git ref, or
# nothing when the constant does not exist there.
pohunek_const_value() {
  git -C "$repo_root" grep -h -E "^[[:space:]]*(pub(\([a-z]+\))? )?const $2:" "$1" -- "$3" 2>/dev/null |
    head -n 1 | sed -E 's/^[^=]*=[[:space:]]*//; s/;[[:space:]]*$//' || true
}

# Fails unless every constant that differs between the previous tag and HEAD is
# named on a line of the notes file.
pohunek_check_compat_notes() {
  prev_tag="$(git -C "$repo_root" describe --tags --abbrev=0 --match 'v[0-9]*' HEAD 2>/dev/null || true)"
  if [ -z "$prev_tag" ]; then
    pohunek_info "compat check: no previous tag, skipped"
    return 0
  fi
  changed=""
  for entry in $compat_constants; do
    name=${entry%%|*}
    path=${entry#*|}
    old="$(pohunek_const_value "$prev_tag" "$name" "$path")"
    new="$(pohunek_const_value HEAD "$name" "$path")"
    if [ "$old" != "$new" ]; then
      changed="$changed $name"
      pohunek_info "compat check: $name changed since $prev_tag (${old:-absent} -> ${new:-absent})"
    fi
  done
  [ -n "$changed" ] || { pohunek_info "compat check: no schema or protocol constant changed since $prev_tag"; return 0; }
  [ -n "$notes_file" ] || pohunek_fail "constants changed since $prev_tag:$changed; pass --notes FILE with one line per changed constant"
  [ -r "$notes_file" ] || pohunek_fail "cannot read notes file: $notes_file"
  missing=""
  for name in $changed; do
    grep -qwF "$name" "$notes_file" || missing="$missing $name"
  done
  [ -z "$missing" ] || pohunek_fail "release notes $notes_file lack a line for:$missing"
  pohunek_info "compat check: release notes name every changed constant"
}

pohunek_info "current version: $current"
pohunek_info "next version:    $next  (tag $tag)"

pohunek_check_compat_notes

if [ "$dry_run" = true ]; then
  pohunek_info "dry run: would bump $manifest to $next, refresh Cargo.lock, commit, tag $tag$( [ "$push" = true ] && printf ', and push' )"
  exit 0
fi

# Safety checks: clean tree, on the release branch, tag not already used.
branch="$(git -C "$repo_root" rev-parse --abbrev-ref HEAD)"
[ "$branch" = "$release_branch" ] || pohunek_fail "not on $release_branch (on $branch); set POHUNEK_RELEASE_BRANCH to override"

if [ -n "$(git -C "$repo_root" status --porcelain)" ]; then
  pohunek_fail "working tree is dirty; commit or stash before releasing"
fi

if git -C "$repo_root" rev-parse -q --verify "refs/tags/$tag" >/dev/null; then
  pohunek_fail "tag $tag already exists"
fi

# Bump the version in [workspace.package] (only that table's `version` line).
tmp="$manifest.tmp"
awk -v nextver="$next" '
  /^\[workspace\.package\]/ { in_pkg = 1; print; next }
  /^\[/ { in_pkg = 0 }
  in_pkg && /^version[[:space:]]*=/ {
    print "version = \"" nextver "\""
    in_pkg = 0
    next
  }
  { print }
' "$manifest" > "$tmp"
mv "$tmp" "$manifest"

# Refresh Cargo.lock so the workspace members record the new version.
( cd "$repo_root" && cargo update --workspace --offline >/dev/null 2>&1 || cargo update --workspace >/dev/null )

git -C "$repo_root" add Cargo.toml Cargo.lock
git -C "$repo_root" commit -m "Release $tag"
git -C "$repo_root" tag -a "$tag" -m "Release $tag"

pohunek_info "committed and tagged $tag"

if [ "$push" = true ]; then
  git -C "$repo_root" push origin "$release_branch"
  git -C "$repo_root" push origin "$tag"
  pohunek_info "pushed $release_branch and $tag; the Release workflow will build and publish the binaries"
else
  pohunek_info "skipped push (--no-push); run: git push origin $release_branch && git push origin $tag"
fi
