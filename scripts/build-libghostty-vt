#!/usr/bin/env python3
"""Build the pinned libghostty-vt static library for one Rust target.

usage: python3 -I scripts/build-libghostty-vt <rust-target> <out-dir>
           (--tarball-dir DIR | --fetch) [--zig ZIG] [--pin FILE]
       python3 -I scripts/build-libghostty-vt --download-tarballs DIR [--pin FILE]
       python3 -I scripts/build-libghostty-vt <rust-target> <out-dir> --verify [--pin FILE]
       python3 -I scripts/build-libghostty-vt <rust-target> <out-dir> --probe-native
       python3 -I scripts/build-libghostty-vt --print-pin SECTION.KEY [--pin FILE]
       python3 -I scripts/build-libghostty-vt --evidence FILE [--pin FILE]

The only code that fetches or compiles libghostty. It reads the pins from
`libghostty-vt.pin.toml` next to it, checks `zig version`, verifies the sha256 of
both tarballs (taken from --tarball-dir, or downloaded with --fetch), unpacks
them side by side into a fresh temporary directory and runs an offline
`zig build` with a new, empty ZIG_GLOBAL_CACHE_DIR. The output directory
receives `lib/libghostty-vt.a`, `include/ghostty/`, `abi-layout.txt` and
`BUILD_INFO`. `--download-tarballs` only fetches both tarballs into DIR and
verifies them, so a cache can hold them. `--verify` checks an existing output
directory (BUILD_INFO against the pin and the target, the archive against its
recorded size and sha256). `--probe-native` only rewrites `abi-layout.txt` with
the host C compiler, for a library cross-built on a host that cannot run the
target (the macOS jobs). `--print-pin` prints one scalar of the pin file.
`--evidence` writes the supply-chain record of the pin (library version and
commit, both tarballs with their sha256, Zig version and sha256, signing key,
build flags, target mapping) as JSON, for the release evidence.
"""

import argparse
import hashlib
import json
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import tomllib
import urllib.error
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
DEFAULT_PIN = HERE / "libghostty-vt.pin.toml"
ABI_PROBE = HERE / "libghostty-vt-abi-probe.c"


def fail(message: str) -> "None":
    print(f"build-libghostty-vt: {message}", file=sys.stderr)
    sys.exit(1)


def sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for block in iter(lambda: handle.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def download(url: str, build: dict) -> bytes:
    """Fetch `url` with the pinned agent; retry network errors, 5xx and 429."""
    request = urllib.request.Request(url, headers={"User-Agent": build["user_agent"]})
    attempts = build["download_attempts"]
    wait = build["download_backoff_seconds"]
    for attempt in range(1, attempts + 1):
        try:
            with urllib.request.urlopen(request, timeout=build["download_timeout_seconds"]) as response:
                # The sha256 is checked after the download; the read is bounded
                # so a hostile response cannot fill the disk first.
                return response.read(build["max_download_bytes"] + 1)
        except urllib.error.HTTPError as error:
            retryable = error.code == 429 or error.code >= 500
            problem = f"HTTP {error.code}"
        except (urllib.error.URLError, TimeoutError) as error:
            retryable, problem = True, str(error)
        if not retryable or attempt == attempts:
            fail(f"download of {url} failed: {problem} (attempt {attempt} of {attempts})")
        print(f"build-libghostty-vt: {problem}; retrying in {wait} s", file=sys.stderr)
        time.sleep(wait)
        wait *= 2
    fail("unreachable")


def obtain(
    entry: dict, name: str, tarball_dir: Path | None, fetch: bool, work: Path, build: dict,
) -> Path:
    """Return the verified tarball `name`; fail on a hash mismatch."""
    if tarball_dir is not None:
        path = tarball_dir / name
        if not path.is_file():
            fail(f"{path} does not exist")
    elif fetch:
        path = work / name
        data = download(entry["url"], build)
        if len(data) > build["max_download_bytes"]:
            fail(f"{name} is larger than the pinned limit of {build['max_download_bytes']} bytes")
        path.write_bytes(data)
    else:
        fail("pass --tarball-dir DIR or --fetch")
    actual = sha256_of(path)
    if actual != entry["sha256"]:
        fail(f"sha256 mismatch for {name}: pinned {entry['sha256']}, found {actual}")
    return path


def unpack(path: Path, destination: Path) -> None:
    with tarfile.open(path) as archive:
        archive.extractall(destination, filter="data")


def probe_native(out: Path) -> None:
    """Record the C layout of the mirrored types with the host `cc`."""
    with tempfile.TemporaryDirectory(prefix="abi-probe-") as scratch:
        binary = Path(scratch) / "abi-probe"
        subprocess.run(
            ["cc", "-DGHOSTTY_STATIC", "-I", str(out / "include"), str(ABI_PROBE), "-o", str(binary)],
            check=True,
        )
        probe = subprocess.run([str(binary)], check=True, capture_output=True, text=True)
    (out / "abi-layout.txt").write_text(probe.stdout)


def download_tarballs(pins: dict, destination: Path) -> None:
    """Fetch both pinned tarballs into `destination`, each verified by sha256."""
    destination.mkdir(parents=True, exist_ok=True)
    for section in ("source", "deps"):
        entry = pins[section]
        name = Path(entry["url"]).name
        data = download(entry["url"], pins["build"])
        if len(data) > pins["build"]["max_download_bytes"]:
            fail(f"{name} is larger than the pinned limit of {pins['build']['max_download_bytes']} bytes")
        partial = destination / f"{name}.partial"
        partial.write_bytes(data)
        actual = sha256_of(partial)
        if actual != entry["sha256"]:
            partial.unlink()
            fail(f"sha256 mismatch for {name}: pinned {entry['sha256']}, found {actual}")
        partial.replace(destination / name)
        print(f"fetched {destination / name}")


def write_evidence(pins: dict, destination: Path) -> None:
    """Write the supply-chain record of the pin as JSON."""
    record = {
        "schema_version": 1,
        "library": pins["library"],
        "source": pins["source"],
        "deps": pins["deps"],
        "zig": pins["zig"],
        "build": {
            key: pins["build"][key] for key in ("optimize", "cpu", "strip", "vt_features")
        },
        "targets": pins["targets"],
    }
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n")
    print(f"wrote {destination}")


def verify_output(pins: dict, target: str, out: Path) -> None:
    """Fail unless `out` is a complete build of the pinned library for `target`."""
    info_path = out / "BUILD_INFO"
    if not info_path.is_file():
        fail(f"{info_path} does not exist")
    info = dict(
        line.split("=", 1) for line in info_path.read_text().splitlines() if "=" in line
    )
    expected = {
        "library_version": pins["library"]["version"],
        "zig_version": pins["zig"]["version"],
        "rust_target": target,
        "zig_target": pins["targets"].get(target),
        "source_sha256": pins["source"]["sha256"],
        "deps_sha256": pins["deps"]["sha256"],
    }
    for key, value in expected.items():
        if info.get(key) != value:
            fail(f"{info_path}: {key} is {info.get(key)!r}, the pin requires {value!r}")
    archive = out / "lib" / "libghostty-vt.a"
    if not archive.is_file():
        fail(f"{archive} does not exist")
    if str(archive.stat().st_size) != info.get("archive_bytes"):
        fail(f"{archive} is {archive.stat().st_size} bytes, BUILD_INFO records {info.get('archive_bytes')}")
    if sha256_of(archive) != info.get("archive_sha256"):
        fail(f"{archive} does not match the archive_sha256 of BUILD_INFO")
    if not (out / "include" / "ghostty").is_dir():
        fail(f"{out / 'include' / 'ghostty'} does not exist")
    if not (out / "abi-layout.txt").is_file():
        fail(f"{out / 'abi-layout.txt'} does not exist")
    print(f"verified {out} ({target}, library {expected['library_version']})")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("target", nargs="?", help="Rust target triple")
    parser.add_argument("out_dir", nargs="?", type=Path)
    parser.add_argument("--tarball-dir", type=Path)
    parser.add_argument("--fetch", action="store_true")
    parser.add_argument("--zig", default="zig")
    parser.add_argument("--pin", type=Path, default=DEFAULT_PIN)
    parser.add_argument("--download-tarballs", type=Path, metavar="DIR")
    parser.add_argument("--verify", action="store_true")
    parser.add_argument("--print-pin", metavar="SECTION.KEY")
    parser.add_argument("--evidence", type=Path, metavar="FILE")
    parser.add_argument(
        "--probe-native",
        action="store_true",
        help="only (re)write abi-layout.txt in out_dir with the host C compiler, "
        "for a library cross-built on another host",
    )
    args = parser.parse_args()

    pins = tomllib.loads(args.pin.read_text())
    if args.print_pin:
        section, _, key = args.print_pin.partition(".")
        value = pins.get(section, {}).get(key)
        if not isinstance(value, (str, int)) or isinstance(value, bool):
            fail(f"the pin has no scalar {args.print_pin}")
        print(value)
        return
    if args.evidence:
        write_evidence(pins, args.evidence)
        return
    if args.download_tarballs:
        download_tarballs(pins, args.download_tarballs)
        return
    if args.target is None or args.out_dir is None:
        fail("pass <rust-target> and <out-dir>")
    if args.probe_native:
        probe_native(args.out_dir)
        return
    if args.verify:
        verify_output(pins, args.target, args.out_dir)
        return
    zig_target = pins["targets"].get(args.target)
    if zig_target is None:
        fail(f"no Zig target is pinned for {args.target}")

    version = subprocess.run(
        [args.zig, "version"], check=False, capture_output=True, text=True
    )
    if version.returncode != 0 or version.stdout.strip() != pins["zig"]["version"]:
        found = version.stdout.strip() or version.stderr.strip()
        fail(f"zig version is {found!r}, the pin is {pins['zig']['version']!r}")

    started = time.monotonic()
    with tempfile.TemporaryDirectory(prefix="libghostty-vt-") as scratch_name:
        scratch = Path(scratch_name)
        source_tar = obtain(
            pins["source"], Path(pins["source"]["url"]).name, args.tarball_dir, args.fetch, scratch,
            pins["build"],
        )
        deps_tar = obtain(
            pins["deps"], Path(pins["deps"]["url"]).name, args.tarball_dir, args.fetch, scratch,
            pins["build"],
        )
        unpack(source_tar, scratch)
        unpack(deps_tar, scratch)
        library_version = pins["library"]["version"]
        source_dir = scratch / f"libghostty-vt-{library_version}"
        deps_dir = scratch / f"libghostty-vt-{library_version}-deps"
        if not source_dir.is_dir() or not deps_dir.is_dir():
            fail("the tarballs did not unpack to the expected directories")

        prefix = scratch / "prefix"
        cache = scratch / "zig-global-cache"
        cache.mkdir()
        environment = {**os.environ, "ZIG_GLOBAL_CACHE_DIR": str(cache)}
        build_started = time.monotonic()
        subprocess.run(
            [
                args.zig, "build",
                "--system", str(deps_dir),
                f"-Doptimize={pins['build']['optimize']}",
                f"-Dcpu={pins['build']['cpu']}",
                f"-Dstrip={pins['build']['strip']}",
                f"-Dvt-features={pins['build']['vt_features']}",
                f"-Dtarget={zig_target}",
                "--prefix", str(prefix),
            ],
            cwd=source_dir,
            env=environment,
            check=True,
        )
        build_seconds = time.monotonic() - build_started

        archive = prefix / "lib" / "libghostty-vt.a"
        if not archive.is_file():
            fail(f"the build produced no {archive.name}")
        out = args.out_dir
        if out.exists():
            shutil.rmtree(out)
        (out / "lib").mkdir(parents=True)
        shutil.copy2(archive, out / "lib" / archive.name)
        shutil.copytree(prefix / "include" / "ghostty", out / "include" / "ghostty")

        probe_binary = scratch / "abi-probe"
        subprocess.run(
            [
                args.zig, "cc", "-target", zig_target,
                "-DGHOSTTY_STATIC", "-I", str(out / "include"),
                str(ABI_PROBE),
                "-o", str(probe_binary),
            ],
            check=True,
            env=environment,
        )
        # The probe prints the layout table. A cross-built probe cannot run on
        # this host; abi-layout.txt then holds only a comment, `build.rs`
        # refuses it, and `--probe-native` rewrites it on a host that runs the
        # target.
        try:
            probe = subprocess.run(
                [str(probe_binary)], check=True, capture_output=True, text=True
            )
            layout_text = probe.stdout
        except (OSError, subprocess.CalledProcessError):
            layout_text = "# probe not runnable on this host; run --probe-native on the target\n"
        (out / "abi-layout.txt").write_text(layout_text)

        zig_exe = shutil.which(args.zig) or args.zig
        total = time.monotonic() - started
        info = [
            f"library_version={library_version}",
            f"zig_version={pins['zig']['version']}",
            f"rust_target={args.target}",
            f"zig_target={zig_target}",
            f"source_sha256={pins['source']['sha256']}",
            f"deps_sha256={pins['deps']['sha256']}",
            f"archive_bytes={archive.stat().st_size}",
            f"archive_sha256={sha256_of(archive)}",
            f"zig_build_seconds={build_seconds:.1f}",
            f"script_seconds={total:.1f}",
            f"zig_path={Path(zig_exe).name}",
        ]
        (out / "BUILD_INFO").write_text("\n".join(info) + "\n")
    print(f"built {out / 'lib' / 'libghostty-vt.a'}")


if __name__ == "__main__":
    main()
