#!/bin/sh
# Build the Hermes runtime package archive from its repository sources.
#
# usage: build-hermes-package <output-archive>
#
# The package is the official package directory runtime-packages/hermes: the
# descriptor, the detection manifest, the closed operator sidecar operator.toml
# and its payload in operator/. This script builds that directory with
# `cargo xtask package build`, so the compatibility gate and the release plugin
# smoke install the same bytes the release catalog ships. Run from the
# repository root.

set -eu

fail() {
    printf 'build-hermes-package: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 1 ] || fail "usage: build-hermes-package <output-archive>"
output=$1
package_dir=runtime-packages/hermes
for path in runtime.toml detect.toml operator.toml operator; do
    [ -e "$package_dir/$path" ] || fail "missing $package_dir/$path (run from the repository root)"
done

cargo xtask package build "$package_dir" --output "$output" >&2
printf '%s\n' "$output"
