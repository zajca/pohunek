#!/usr/bin/env python3
"""Prove that regression scenarios fail on the old code and pass on the new code.

    scripts/red-on-old --base REV --scratch-root DIR --rows R1,R2 \\
        --scenario R1='<nextest filterset>' [--scenario R2=...] \\
        [--manual R2='<how the old behaviour was reproduced>'] \\
        [--package pohunek-daemon ...]

`verification.md` asks a fix for a regression scenario that fails without the
fix. This script runs each scenario on two trees and prints the evidence as a
Markdown table for the pull request body:

    | row | scenario | old code | new code |

The new code is the checked-out `HEAD`, run in this tree (the tree must be
clean). The old code is a scratch worktree of `HEAD` under `--scratch-root` in
which every changed file that is not test code is restored to the merge base of
`--base` and `HEAD` (a file the diff added is removed). Test code is kept: files
under a `tests` or `fixtures` directory, `tests.rs`, `*_tests.rs`,
`crates/test-support/`, and every `.rs` file under `crates/*/src` that a
`#[cfg(test)] mod name;` declaration names (a `#[path]` attribute is honoured)
or that lies below such a directory module. A file whose `mod` declaration
cannot be found or read counts as mixed (see the refusal below). The scratch worktree is the only path the script removes,
on every exit path.

A diff that changes no file under `crates/` is exempt: no table is required and
the script exits 0.

A cell is one of:

    FAIL (<crate>::<binary> <test>)   a test failed: a red result on the old code
    PASS                              every selected test passed
    PASS (not red)                    old code only: the scenario does not prove the fix
    FAIL (no test selected; not a red result)
    BUILD FAIL (not a red result)     the tree did not build, so nothing ran
    manual: <how>                     old code only: reproduced by hand (`--manual`)
    NOT RUN (...)                     new code only: a `--manual` row without a `--scenario`
    MISSING                           the row has neither `--scenario` nor `--manual`

The exit code is 0 when every row is accepted (red on the old code, passing on
the new code, or reproduced by hand with a passing new code), 1 when a row is
not, and 2 for a usage error or a refusal. A refusal happens when a changed
non-test file also changes lines inside test code (a test function or a function
of a `cfg(test)` module): restoring the file would remove the test, so the old
behaviour cannot be reproduced automatically, and every row then needs
`--manual`. A changed file whose `mod` declaration cannot be read (a module
generated by a macro, an unusual layout) is refused the same way, never taken for
production code. `--package` adds a package to the ones the scenarios run in; at least
one package is required for a row that has a `--scenario`.

Each tree first builds the binaries the scenarios start
(`pohunek-sessiond`, and `pohunekd` and `pohunek` for the daemon and CLI
packages). The old tree builds into its own target directory inside the scratch
worktree; when the new tree's target directory (`$CARGO_TARGET_DIR`, else
`<root>/target`) holds a `debug` build, its dependency caches are reflink-copied
into it first, otherwise the old tree builds cold.
`$HEAVY_RUN` (required; `scripts/heavy-run` in real use) wraps every cargo
command and `$CARGO` replaces `cargo`.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import os
import re
import shutil
import signal
import subprocess
import sys
import xml.etree.ElementTree as ElementTree
from pathlib import Path

EXIT_REJECTED = 1
EXIT_USAGE = 2

SOURCE_ROOT = "crates/"
STRESS_SCRIPT = "scripts/stress-changed-tests"
NEXTEST_PROFILE = "ci"
JUNIT_PATH = ("nextest", NEXTEST_PROFILE, "junit.xml")
NO_TESTS_MESSAGE = "no tests to run"
SCRATCH_PREFIX = "red-on-old"
OLD_TARGET_NAME = "target"
SEEDED_DIRECTORIES = (".fingerprint", "build", "deps", "incremental")
SEED_FILES = ("CACHEDIR.TAG", ".rustc_info.json")
TEST_DIRECTORIES = ("tests", "fixtures")
TEST_FILE_NAMES = ("tests.rs",)
TEST_FILE_SUFFIX = "_tests.rs"
TEST_SUPPORT_PREFIX = "crates/test-support/"
# Packages whose scenarios start these binaries: (package, build arguments).
WORKER_BUILD = ("pohunek-session-worker", "pohunek-sessiond")
DAEMON_BUILD = ("pohunek-daemon", "pohunekd")
CLI_BUILD = ("pohunek-cli", "pohunek")
BINARY_BUILDS = {
    "pohunek-daemon": (WORKER_BUILD, DAEMON_BUILD),
    "pohunek-cli": (WORKER_BUILD, DAEMON_BUILD, CLI_BUILD),
}

RED = "red"
GREEN = "green"
NOT_RED = "not-red"
BUILD = "build"
EMPTY = "empty"
MANUAL = "manual"
MISSING = "missing"
CELL_ACCEPTED_OLD = (RED, MANUAL)


class Refusal(Exception):
    """A usage error or a refusal; the exit code is EXIT_USAGE."""


class Cell:
    def __init__(self, kind: str, text: str) -> None:
        self.kind = kind
        self.text = text


def run(command: list[str], cwd: Path, env: dict[str, str] | None = None) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(command, cwd=cwd, capture_output=True, text=True, env=env, check=False)
    except FileNotFoundError as error:
        return subprocess.CompletedProcess(command, 127, "", str(error))


def git(root: Path, *arguments: str) -> subprocess.CompletedProcess:
    return run(["git", *arguments], root)


def require_git(root: Path, *arguments: str) -> str:
    result = git(root, *arguments)
    if result.returncode != 0:
        raise Refusal(f"git {' '.join(arguments)} failed: {result.stderr.strip() or result.stdout.strip()}")
    return result.stdout


def is_test_path(path: str) -> bool:
    """Whether a changed file is test code, so the old tree keeps its new version."""
    parts = path.split("/")
    name = parts[-1]
    return (
        any(part in TEST_DIRECTORIES for part in parts[:-1])
        or name in TEST_FILE_NAMES
        or name.endswith(TEST_FILE_SUFFIX)
        or path.startswith(TEST_SUPPORT_PREFIX)
    )


MODULE_DECLARATION = re.compile(
    r"^[ \t]*((?:#\[[^\]]*\][ \t\r\n]*)*)(?:pub(?:\([^)]*\))?[ \t]+)?mod[ \t]+(\w+)[ \t]*;", re.MULTILINE
)
ATTRIBUTE = re.compile(r"#\[([^\]]*)\]")
PATH_ATTRIBUTE = re.compile(r'\s*path\s*=\s*"([^"]*)"\s*$')
CRATE_SOURCE = re.compile(r"^(crates/[^/]+/src)/(.+\.rs)$")
CRATE_ROOT_NAMES = ("lib.rs", "main.rs")

TEST = "test"
PRODUCTION = "production"
UNKNOWN = "unknown"


class ModuleTree:
    """Which `.rs` files under `crates/*/src` are modules that only a test build compiles.

    A file is test code when the `mod` declaration that names it carries `#[cfg(test)]`
    (a `#[path]` attribute is honoured) or when it lies below such a directory module.
    A file whose declaration cannot be found or read is `UNKNOWN`, never production.
    """

    def __init__(self, root: Path, helpers) -> None:
        self.root = root
        self.helpers = helpers
        self.declarations: dict[str, list[tuple[str, list[str]]]] = {}
        self.path_targets: dict[str, list[tuple[str, list[str]]]] = {}
        self.kinds: dict[str, str] = {}

    def declared_in(self, declaring: str) -> list[tuple[str, list[str]]]:
        """`(module name, attribute bodies)` of every `mod name;` in a file."""
        if declaring not in self.declarations:
            file = self.root / declaring
            found = []
            if file.is_file():
                text = re.sub(r"//[^\n]*", "", file.read_text(errors="replace"))
                text = re.sub(r"/\*.*?\*/", "", text, flags=re.DOTALL)
                for match in MODULE_DECLARATION.finditer(text):
                    found.append((match.group(2), ATTRIBUTE.findall(match.group(1))))
            self.declarations[declaring] = found
            directory = declaring.rpartition("/")[0]
            for name, attributes in found:
                for attribute in attributes:
                    path_match = PATH_ATTRIBUTE.match(attribute)
                    if path_match:
                        target = os.path.normpath(f"{directory}/{path_match.group(1)}")
                        self.path_targets.setdefault(target, []).append((declaring, attributes))
        return self.declarations[declaring]

    def scan_crate(self, source_directory: str) -> None:
        """Reads every file of a crate once, so `#[path]` targets are known."""
        if source_directory in self.kinds:
            return
        self.kinds[source_directory] = PRODUCTION
        for file in sorted((self.root / source_directory).rglob("*.rs")):
            self.declared_in(file.relative_to(self.root).as_posix())

    def cfg_kind(self, attributes: list[str]) -> str:
        """`TEST`, `PRODUCTION` or `UNKNOWN` for the `cfg` attributes of one declaration."""
        for attribute in attributes:
            body = attribute.strip()
            if not body.startswith("cfg"):
                continue
            if not self.helpers.host_dependent_cfg(body):
                return TEST
            if re.fullmatch(r"cfg\s*\(\s*not\s*\(\s*test\s*\)\s*\)", body):
                continue
            if re.search(r"\btest\b", body):
                return UNKNOWN
        return PRODUCTION

    def declarer_kind(self, declaring: str) -> str:
        """The kind a module inherits from the file that declares it."""
        if is_test_path(declaring):
            return TEST
        return self.kind(declaring) if CRATE_SOURCE.match(declaring) else PRODUCTION

    def candidates(self, path: str) -> tuple[str, list[str]]:
        """The module name of a file and the files that may declare it."""
        directory, _, name = path.rpartition("/")
        stem = name[: -len(".rs")]
        scope = directory.rpartition("/")[0] if stem == "mod" else directory
        module = directory.rpartition("/")[2] if stem == "mod" else stem
        parent, _, scope_name = scope.rpartition("/")
        declaring = [f"{scope}/mod.rs", f"{parent}/{scope_name}.rs"]
        if scope_name == "src":
            declaring += [f"{scope}/{root_name}" for root_name in CRATE_ROOT_NAMES]
        return module, declaring

    def kind(self, path: str) -> str:
        if path in self.kinds:
            return self.kinds[path]
        self.kinds[path] = UNKNOWN
        self.kinds[path] = self.compute(path)
        return self.kinds[path]

    def compute(self, path: str) -> str:
        match = CRATE_SOURCE.match(path)
        if not match:
            return PRODUCTION
        self.scan_crate(match.group(1))
        relative = match.group(2)
        if relative in CRATE_ROOT_NAMES or relative.startswith("bin/"):
            return PRODUCTION
        for declaring, attributes in self.path_targets.get(path, ()):
            own = self.cfg_kind(attributes)
            return own if own != PRODUCTION else self.declarer_kind(declaring)
        module, declaring_files = self.candidates(path)
        for declaring in declaring_files:
            for name, attributes in self.declared_in(declaring):
                if name != module:
                    continue
                own = self.cfg_kind(attributes)
                if own != PRODUCTION:
                    return own
                return self.declarer_kind(declaring)
        return UNKNOWN


def classify_modules(root: Path, paths: list[str]) -> tuple[list[str], list[str]]:
    """Splits the `crates/*/src` files into those a test build alone compiles and the unreadable ones."""
    helpers = load_stress_helpers(root)
    tree = ModuleTree(root, helpers)
    tests, unknown = [], []
    for path in paths:
        if not (CRATE_SOURCE.match(path) and (root / path).exists()):
            continue
        kind = tree.kind(path)
        if kind == TEST:
            tests.append(path)
        elif kind == UNKNOWN:
            unknown.append(path)
    return tests, unknown


def changed_files(root: Path, merge_base: str) -> dict[str, str]:
    """`{path: status}` of the files `merge_base..HEAD` changes, renames as a delete and an add."""
    output = require_git(root, "diff", "--name-status", "--no-renames", "-z", merge_base, "HEAD")
    fields = output.split("\0")
    changes = {}
    for status, path in zip(fields[0::2], fields[1::2]):
        if status:
            changes[path] = status[0]
    return changes


def load_stress_helpers(root: Path):
    """The test-range parser of `stress-changed-tests`, which this script reuses."""
    path = str(root / STRESS_SCRIPT)
    loader = importlib.machinery.SourceFileLoader("stress_changed_tests_helpers", path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def test_code_changes(root: Path, base: str, restored: list[str]) -> list[str]:
    """The restored `.rs` files whose changed lines fall inside test code."""
    candidates = [path for path in restored if path.startswith(SOURCE_ROOT) and path.endswith(".rs")]
    if not candidates:
        return []
    helpers = load_stress_helpers(root)
    spans = helpers.changed_lines(root, base)
    mixed = []
    for path in candidates:
        file_spans = spans.get(path)
        file = root / path
        if not file_spans or not file.exists():
            continue
        module = helpers.Module(file.read_text(errors="replace"))
        for item in module.items:
            inside_test_module = any(not helpers.host_dependent_cfg(body) for body in item.mod_cfgs)
            test_only_cfg = any(
                attribute["last"] == "cfg" and not helpers.host_dependent_cfg(attribute["body"])
                for attribute in item.attrs
            )
            if (item.is_test or inside_test_module or test_only_cfg) and any(
                helpers.intersects(span, item) for span in file_spans
            ):
                mixed.append(path)
                break
    return mixed


class Tree:
    """A tree the scenarios run in, with its cargo environment."""

    def __init__(self, root: Path, target: Path | None, label: str) -> None:
        self.root = root
        self.label = label
        self.environment = dict(os.environ)
        if target is not None:
            self.environment["CARGO_TARGET_DIR"] = str(target)
        self.target = target if target is not None else Path(os.environ.get("CARGO_TARGET_DIR", root / "target"))

    def reports(self) -> list[Path]:
        """Where nextest may write the JUnit report: under the cargo target directory, or under
        the workspace's own `target` (nextest keeps its store there when `$CARGO_TARGET_DIR` is set)."""
        places = [self.target, self.root / OLD_TARGET_NAME]
        return [place.joinpath(*JUNIT_PATH) for index, place in enumerate(places) if place not in places[:index]]


class Runner:
    def __init__(self, cargo: str, heavy_run: str, packages: list[str]) -> None:
        self.cargo = cargo
        self.heavy_run = heavy_run
        self.packages = packages

    def build_binaries(self, tree: Tree) -> str | None:
        """Builds the binaries the scenarios start; returns a failure message or None."""
        builds = [WORKER_BUILD]
        for package in self.packages:
            for build in BINARY_BUILDS.get(package, ()):
                if build not in builds:
                    builds.append(build)
        for package, binary in builds:
            result = run(
                [self.heavy_run, self.cargo, "build", "-p", package, "--bin", binary],
                tree.root, tree.environment,
            )
            if result.returncode != 0:
                return f"cargo build -p {package} --bin {binary}: {last_line(result)}"
        return None

    def scenario(self, tree: Tree, filterset: str) -> Cell:
        reports = tree.reports()
        for report in reports:
            report.unlink(missing_ok=True)
        package_arguments = [argument for package in self.packages for argument in ("-p", package)]
        result = run(
            [self.heavy_run, self.cargo, "nextest", "run", "--profile", NEXTEST_PROFILE, "--no-fail-fast",
             *package_arguments, "-E", filterset],
            tree.root, tree.environment,
        )
        junit = next((report for report in reports if report.exists()), reports[0])
        cell = classify(result, junit)
        if cell.kind in (BUILD, EMPTY):
            print(f"red-on-old: {tree.label} tree, {filterset}: {last_line(result)}", file=sys.stderr)
        return cell


def last_line(result: subprocess.CompletedProcess) -> str:
    lines = [line.strip() for line in (result.stderr or result.stdout or "").splitlines() if line.strip()]
    return lines[-1] if lines else f"exit {result.returncode}"


def classify(result: subprocess.CompletedProcess, junit: Path) -> Cell:
    """The cell of one scenario run, from its JUnit report and exit code."""
    output = (result.stderr or "") + (result.stdout or "")
    if not junit.exists():
        if NO_TESTS_MESSAGE in output:
            return Cell(EMPTY, "FAIL (no test selected; not a red result)")
        return Cell(BUILD, "BUILD FAIL (not a red result)")
    try:
        cases = ElementTree.parse(junit).getroot().iter("testcase")
    except ElementTree.ParseError:
        return Cell(BUILD, "BUILD FAIL (not a red result)")
    ran = 0
    failed = []
    for case in cases:
        if case.find("skipped") is not None:
            continue
        ran += 1
        if case.find("failure") is not None or case.find("error") is not None:
            failed.append(f"{case.get('classname', '')} {case.get('name', '')}".strip())
    if failed:
        return Cell(RED, f"FAIL ({failed[0]})")
    if ran == 0:
        return Cell(EMPTY, "FAIL (no test selected; not a red result)")
    return Cell(GREEN, "PASS")


def seed_target(source: Path | None, destination: Path) -> str:
    """Reflink-copies the dependency caches of `source/debug`; says whether the old tree builds cold."""
    debug = source / "debug" if source is not None else None
    if debug is None or not debug.is_dir():
        return "old tree builds cold: no $CARGO_TARGET_DIR/debug to seed from"
    target_debug = destination / "debug"
    target_debug.mkdir(parents=True, exist_ok=True)
    for name in (*SEEDED_DIRECTORIES, *SEED_FILES):
        origin = debug / name
        if not origin.exists():
            continue
        result = run(["cp", "-a", "--reflink=always", str(origin), str(target_debug / name)], debug)
        if result.returncode != 0:
            shutil.rmtree(destination, ignore_errors=True)
            return f"old tree builds cold: the reflink seed failed ({last_line(result)})"
    return "old tree seeded with a reflink copy of $CARGO_TARGET_DIR/debug"


class ScratchWorktree:
    """The scratch worktree of the old code; removed on every exit path."""

    def __init__(self, root: Path, scratch_root: Path, head: str) -> None:
        self.root = root
        self.path = scratch_root / f"{SCRATCH_PREFIX}-{head[:8]}-{os.getpid()}"
        self.created = False

    def __enter__(self) -> Path:
        require_git(self.root, "worktree", "add", "--detach", str(self.path), "HEAD")
        self.created = True
        return self.path

    def __exit__(self, *exception) -> None:
        if self.created:
            removed = git(self.root, "worktree", "remove", "--force", str(self.path))
            if removed.returncode != 0:
                print(
                    f"red-on-old: the scratch worktree {self.path} was not removed: {removed.stderr.strip()}",
                    file=sys.stderr,
                )
            self.created = False


def terminate(_signal_number, _frame) -> None:
    """Turns SIGTERM and SIGHUP into an exit that runs the cleanup."""
    raise SystemExit(128 + signal.SIGTERM)


def restore_old_code(worktree: Path, merge_base: str, changes: dict[str, str], kept: set[str]) -> list[str]:
    """Puts every changed non-test file back to the merge base; returns the restored paths."""
    restored = []
    for path, status in sorted(changes.items()):
        if path in kept:
            continue
        if status == "A":
            require_git(worktree, "rm", "-q", "--force", "--", path)
        else:
            require_git(worktree, "checkout", merge_base, "--", path)
        restored.append(path)
    return restored


def parse_assignments(values: list[str], option: str, rows: list[str]) -> dict[str, str]:
    parsed: dict[str, str] = {}
    for value in values:
        row, separator, text = value.partition("=")
        if not separator or not text:
            raise Refusal(f"{option} {value!r}: expected ROW=<text>")
        if row not in rows:
            raise Refusal(f"{option} {value!r}: {row} is not in --rows")
        if row in parsed:
            raise Refusal(f"{option} names {row} twice")
        parsed[row] = text
    return parsed


def escape(text: str) -> str:
    return text.replace("|", "\\|").replace("\n", " ")


def table(rows: list[str], scenarios: dict[str, str], cells: dict[str, tuple[Cell, Cell]]) -> str:
    lines = ["| row | scenario | old code | new code |", "|---|---|---|---|"]
    for row in rows:
        old, new = cells[row]
        scenario = f"`{escape(scenarios[row])}`" if row in scenarios else "-"
        lines.append(f"| {row} | {scenario} | {escape(old.text)} | {escape(new.text)} |")
    return "\n".join(lines)


def accepted(old: Cell, new: Cell) -> bool:
    return old.kind in CELL_ACCEPTED_OLD and new.kind == GREEN


def evaluate(rows: list[str], scenarios: dict[str, str], manual: dict[str, str],
             runner: Runner, new_tree: Tree, old_tree: Tree | None) -> dict[str, tuple[Cell, Cell]]:
    cells: dict[str, tuple[Cell, Cell]] = {}
    new_build = None
    for row in rows:
        if row not in scenarios and row not in manual:
            cells[row] = (Cell(MISSING, "MISSING"), Cell(MISSING, "MISSING"))
    runnable = [row for row in rows if row in scenarios]
    new_cells: dict[str, Cell] = {}
    if runnable:
        new_build = runner.build_binaries(new_tree)
        for row in runnable:
            new_cells[row] = (
                Cell(BUILD, "BUILD FAIL (not a red result)") if new_build else runner.scenario(new_tree, scenarios[row])
            )
    old_cells: dict[str, Cell] = {}
    to_run_old = [row for row in runnable if row not in manual]
    if to_run_old and old_tree is not None:
        old_build = runner.build_binaries(old_tree)
        for row in to_run_old:
            old_cells[row] = (
                Cell(BUILD, "BUILD FAIL (not a red result)") if old_build else runner.scenario(old_tree, scenarios[row])
            )
    for row in rows:
        if row in cells:
            continue
        if row in manual:
            old = Cell(MANUAL, f"manual: {manual[row]}")
        else:
            old = old_cells[row]
            if old.kind == GREEN:
                old = Cell(NOT_RED, "PASS (not red)")
        new = new_cells[row] if row in new_cells else Cell(MISSING, "NOT RUN (a manual row needs a --scenario for the new code)")
        cells[row] = (old, new)
    return cells


def main() -> int:
    parser = argparse.ArgumentParser(description="Prove regression scenarios red on the old code.")
    parser.add_argument("--base", required=True, help="the pull request's base revision")
    parser.add_argument("--scratch-root", type=Path, required=True,
                        help="directory that holds the scratch worktree of the old code")
    parser.add_argument("--rows", required=True, help="comma-separated row ids of the case table")
    parser.add_argument("--scenario", action="append", default=[], metavar="ROW=FILTERSET",
                        help="the nextest filterset of a row")
    parser.add_argument("--manual", action="append", default=[], metavar="ROW=HOW",
                        help="how a row's old behaviour was reproduced by hand")
    parser.add_argument("--package", action="append", default=[], help="a package the scenarios run in")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    arguments = parser.parse_args()
    try:
        return execute(arguments)
    except Refusal as refusal:
        print(f"red-on-old: {refusal}", file=sys.stderr)
        return EXIT_USAGE


def execute(arguments: argparse.Namespace) -> int:
    root = arguments.root.resolve()
    rows = [row for row in arguments.rows.split(",") if row]
    if not rows or len(set(rows)) != len(rows):
        raise Refusal("--rows needs a non-empty list of distinct row ids")
    scenarios = parse_assignments(arguments.scenario, "--scenario", rows)
    manual = parse_assignments(arguments.manual, "--manual", rows)
    heavy_run = os.environ.get("HEAVY_RUN")
    if not heavy_run:
        raise Refusal("$HEAVY_RUN is required (scripts/heavy-run in real use)")
    if scenarios and not arguments.package:
        raise Refusal("a row with --scenario needs at least one --package")
    if not arguments.scratch_root.is_dir():
        raise Refusal(f"--scratch-root {arguments.scratch_root} is not a directory")
    require_git(root, "rev-parse", "--verify", f"{arguments.base}^{{commit}}")
    if require_git(root, "status", "--porcelain").strip():
        raise Refusal("the tree is not clean: the new code is HEAD, so commit or discard the changes first")
    head = require_git(root, "rev-parse", "HEAD").strip()
    merge_base = require_git(root, "merge-base", arguments.base, "HEAD").strip()
    changes = changed_files(root, merge_base)
    if not any(path.startswith(SOURCE_ROOT) for path in changes):
        print(f"red-on-old: exempt: the diff against {arguments.base} changes no file under {SOURCE_ROOT}")
        return 0
    module_tests, undetermined = classify_modules(root, [path for path in changes if not is_test_path(path)])
    kept = {path for path in changes if is_test_path(path)} | set(module_tests)
    restored = [path for path in changes if path not in kept]
    mixed = sorted(set(test_code_changes(root, arguments.base, restored)) | set(undetermined))
    unmanaged = [row for row in rows if row not in manual]
    if mixed and unmanaged:
        raise Refusal(
            "these changed files also change lines inside test code, or the `mod` declaration that "
            "names them cannot be read, so restoring them could remove or keep the wrong code: "
            + ", ".join(sorted(mixed))
            + "; give every row --manual ROW=<how the old behaviour was reproduced> next to its --scenario; rows without --manual: "
            + ", ".join(unmanaged)
        )
    runner = Runner(os.environ.get("CARGO", "cargo"), heavy_run, arguments.package)
    new_tree = Tree(root, None, "new")
    signal.signal(signal.SIGTERM, terminate)
    signal.signal(signal.SIGHUP, terminate)
    needs_old = any(row in scenarios and row not in manual for row in rows)
    if needs_old:
        with ScratchWorktree(root, arguments.scratch_root.resolve(), head) as worktree:
            restore_old_code(worktree, merge_base, changes, kept)
            old_target = worktree / OLD_TARGET_NAME
            print(f"red-on-old: {seed_target(new_tree.target, old_target)}", file=sys.stderr)
            cells = evaluate(rows, scenarios, manual, runner, new_tree, Tree(worktree, old_target, "old"))
    else:
        cells = evaluate(rows, scenarios, manual, runner, new_tree, None)
    print(table(rows, scenarios, cells))
    return 0 if all(accepted(*cells[row]) for row in rows) else EXIT_REJECTED


if __name__ == "__main__":
    sys.exit(main())
