#!/usr/bin/env python3
"""Run disjoint nextest cost shards and verify coverage using nextest itself.

By default nextest builds the workspace test binaries. With `--archive-file`
every nextest call instead extracts a prebuilt `cargo nextest archive` into
this checkout's `target/` and lists or runs from it without compiling, which
is how CI shares one build across the shard jobs.
"""

import argparse
import collections
import json
import os
from pathlib import Path
import secrets
import shutil
import signal
import string
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parents[1]
# Package ownership partitions the fast set. The complement catches new crates
# and targets automatically; fixture ownership is in profile.fast's filter.
DAEMON = "package(=pohunek-daemon) or package(=pohunek-session-worker) or package(=pohunek-client)"
RELAY = "package(=pohunek-relay) or package(=pohunek-relay-client) or package(=pohunek-relay-protocol)"
CLI = "package(=pohunek-cli)"
# Relay heavy tests are the only consumers of the PostgreSQL fixture, so they
# form their own shard: CI runs them in a job whose Postgres service is gated
# by a paths filter on the relay crates.
SHARDS = ("unit", "daemon", "relay", "cli", "relay-db", "heavy")
# Executable name of the session worker a real daemon starts.
WORKER_EXECUTABLE = "pohunek-sessiond"
# Argument that carries the worker's control socket path.
SOCKET_PATH_ARGUMENT = "--daemon-socket-path"
# Parent of the per-run fixture base.
RUN_BASE_PARENT = Path("/tmp")
# Capacity of a Unix socket path in bytes, including the terminating NUL, on
# the strictest supported platform (Darwin).
SOCKET_PATH_CAPACITY = 104
# Longest socket path below a test root, relative to it
# (`pohunek-test-support` env.rs NESTED_SOCKET_SUFFIX).
NESTED_SOCKET_SUFFIX = len("/run/pohunek/workers/" + "0" * 36 + "/control.sock")
# One test root directory name, `ph-` plus six characters, with its separator.
TEST_ROOT_NAME = len("/ph-XXXXXX")
# The deepest nesting any test uses: a test root whose private `TMPDIR`
# (`<root>/tmp`) is the base of a second test root. The git environment tests
# in the daemon and xtask crates do this.
TMPDIR_NESTING = TEST_ROOT_NAME + len("/tmp")
# Longest base path for which that nested layout still binds its sockets.
RUN_BASE_MAX_LENGTH = SOCKET_PATH_CAPACITY - 1 - NESTED_SOCKET_SUFFIX - TEST_ROOT_NAME - TMPDIR_NESTING
# Random characters of the base name: what is left of the budget after the parent.
RUN_BASE_NAME_LENGTH = RUN_BASE_MAX_LENGTH - len(str(RUN_BASE_PARENT)) - len("/")
RUN_BASE_ALPHABET = string.ascii_lowercase + string.digits
# How long a cancelled runner gets to stop after SIGTERM before it is killed.
RUNNER_STOP_GRACE_SECONDS = 30


def filters():
    with (ROOT / ".config/nextest.toml").open("rb") as config:
        fast = tomllib.load(config)["profile"]["fast"]["default-filter"]
    owners = {"daemon": DAEMON, "relay": RELAY, "cli": CLI}
    owners["unit"] = f"not (({DAEMON}) or ({RELAY}) or ({CLI}))"
    return {
        **{name: f"({fast}) and ({owner})" for name, owner in owners.items()},
        "relay-db": f"(not ({fast})) and ({RELAY})",
        "heavy": f"(not ({fast})) and not ({RELAY})",
    }


def selected_tests(document):
    return {
        (binary_id, name)
        for binary_id, suite in document["rust-suites"].items()
        for name, test in suite["testcases"].items()
        if test["filter-match"]["status"] == "matches"
    }


def validate_coverage(universe, selections):
    if not universe:
        raise ValueError("empty workspace test inventory")
    if set(selections) != set(SHARDS):
        raise ValueError("unexpected shard names")
    empty = [name for name, tests in selections.items() if not tests]
    counts = collections.Counter(test for tests in selections.values() for test in tests)
    missing = universe - counts.keys()
    extra = counts.keys() - universe
    overlap = {test for test, count in counts.items() if count != 1}
    if empty or missing or extra or overlap:
        raise ValueError(
            f"partition coverage failed: empty={empty}, missing={sorted(missing)}, "
            f"extra={sorted(extra)}, overlap={sorted(overlap)}"
        )


# nextest's default `[store] dir`, relative to the workspace root. It does not
# follow CARGO_TARGET_DIR.
DEFAULT_STORE_DIR = "target/nextest"


def junit_report(config, profile, root):
    """The JUnit file nextest writes for `profile`, or None when it writes none.

    Reports live under `[store] dir` (relative to the workspace `root`), then
    the profile name. `junit.path` is inherited along `inherits`, ending at
    `default`, like every other nextest profile setting.
    """
    store = Path(root) / config.get("store", {}).get("dir", DEFAULT_STORE_DIR)
    profiles = config.get("profile", {})
    name = profile
    seen = set()
    while name is not None and name not in seen:
        seen.add(name)
        settings = profiles.get(name, {})
        path = settings.get("junit", {}).get("path")
        if path is not None:
            return store / profile / path
        name = settings.get("inherits", "default" if name != "default" else None)
    return None


class Archive:
    """A nextest archive, extracted into this checkout by its first use.

    The first nextest call extracts the archive (about 1.4 GB, seconds of
    work); every later call of the same invocation reuses the extracted
    binaries through the metadata files the archive carries, so `check`
    extracts once instead of once per shard.
    """

    def __init__(self, file):
        self.file = Path(file)
        self.extracted = False

    def arguments(self):
        """The nextest options selecting the build; extracts on the first call."""
        if not self.extracted:
            self.extracted = True
            return [
                "--archive-file", str(self.file),
                "--extract-to", str(ROOT), "--extract-overwrite",
                "--workspace-remap", str(ROOT),
            ]
        store = ROOT / "target" / "nextest"
        return [
            "--binaries-metadata", str(store / "binaries-metadata.json"),
            "--cargo-metadata", str(store / "cargo-metadata.json"),
            "--workspace-remap", str(ROOT),
            "--target-dir-remap", str(ROOT / "target"),
        ]


def nextest_command(subcommand, profile, archive):
    """The nextest invocation prefix for `subcommand` (`list` or `run`).

    A build run passes the workspace selection to cargo. An archive run takes
    its package and feature selection from the archive and maps the workspace
    root to this checkout. It calls the `cargo-nextest` binary directly when
    that is on PATH, so CI test jobs need no Rust toolchain; otherwise
    `cargo nextest` finds it.
    """
    if archive is None:
        return [
            "cargo", "nextest", subcommand, "--profile", profile, "--workspace",
            "--all-features",
        ]
    direct = shutil.which("cargo-nextest")
    return [
        *([direct, "nextest"] if direct else ["cargo", "nextest"]),
        subcommand, "--profile", profile, *archive.arguments(),
    ]


def inventory(expression=None, archive=None):
    command = nextest_command("list", "ci", archive)
    command.extend(["--run-ignored", "all", "--message-format", "json"])
    if expression is not None:
        command.extend(["-E", expression])
    result = subprocess.run(command, cwd=ROOT, check=True, stdout=subprocess.PIPE)
    return selected_tests(json.loads(result.stdout))


class Process:
    """One entry of the process table: identity, command line and executable."""

    def __init__(self, pid, start, argv, executable=None):
        self.pid = pid
        self.start = start
        self.argv = argv
        self.executable = executable


def start_time_of(stat):
    """The start time (field 22) in the contents of `/proc/<pid>/stat`.

    The command name is parenthesised and may contain spaces and parentheses,
    so fields are counted from the last closing parenthesis.
    """
    fields = stat[stat.rfind(")") + 1:].split()
    return fields[19] if len(fields) > 19 else None


def read_processes(proc="/proc"):
    """Every readable process of `proc` with its NUL-separated argument vector.

    Reading `/proc` runs no program, so the result never depends on `PATH`, and
    arguments with spaces stay whole.
    """
    processes = []
    for entry in Path(proc).iterdir():
        if not entry.name.isdigit():
            continue
        try:
            stat = (entry / "stat").read_text(errors="replace")
            cmdline = (entry / "cmdline").read_bytes()
        except OSError:
            continue  # the process ended between the listing and the read
        start = start_time_of(stat)
        if start is None:
            continue
        try:
            executable = os.readlink(entry / "exe")
        except OSError:
            executable = None
        argv = [os.fsdecode(part) for part in cmdline.split(b"\0")[:-1]]
        processes.append(Process(int(entry.name), start, argv, executable))
    return processes


def is_worker(process):
    """Whether `process` runs the session worker, by `argv[0]` or its exe link."""
    names = [Path(process.executable).name.removesuffix(" (deleted)")] if process.executable else []
    if process.argv:
        names.append(Path(process.argv[0]).name)
    return WORKER_EXECUTABLE in names


def leaked_workers(processes, base):
    """Workers among `processes` whose control socket is below `base`.

    The subprocess launcher starts workers with a cleared environment, so the
    only marker a test run leaves on one is the `--daemon-socket-path` value,
    which lies inside a fixture root. A run's `TMPDIR` is a base of its own, so
    workers of the host, of other runs and of other checkouts never match. The
    argument is taken whole from the argument vector, so spaces do not matter.
    Returns `(process, socket path)` pairs.
    """
    found = []
    for process in processes:
        if not is_worker(process) or SOCKET_PATH_ARGUMENT not in process.argv:
            continue
        index = process.argv.index(SOCKET_PATH_ARGUMENT) + 1
        if index < len(process.argv) and Path(process.argv[index]).is_relative_to(base):
            found.append((process, process.argv[index]))
    return found


def kill_if_unchanged(process):
    """SIGKILL `process` only while its PID still has the recorded start time.

    A pidfd pins the process first and the start time is read afterwards, so a
    PID recycled for an unrelated process is never signalled.
    """
    try:
        pidfd = os.pidfd_open(process.pid)
    except ProcessLookupError:
        return False
    try:
        stat = Path(f"/proc/{process.pid}/stat").read_text(errors="replace")
        if start_time_of(stat) != process.start:
            return False
        signal.pidfd_send_signal(pidfd, signal.SIGKILL)
        return True
    except (OSError, ProcessLookupError):
        return False
    finally:
        os.close(pidfd)


def check_no_leaked_workers(base):
    """Terminate and report workers a run left below `base`; True when none did."""
    leaked = leaked_workers(read_processes(), base)
    for process, socket in leaked:
        print(f"leaked pohunek-sessiond worker: pid {process.pid}, socket {socket}", file=sys.stderr)
        kill_if_unchanged(process)
    return not leaked


def make_run_base():
    """Create the private, unique, short fixture base of one run.

    `mkdir` is exclusive, so concurrent runs never share a base.
    """
    while True:
        name = "".join(secrets.choice(RUN_BASE_ALPHABET) for _ in range(RUN_BASE_NAME_LENGTH))
        base = RUN_BASE_PARENT / name
        try:
            base.mkdir(mode=0o700)
        except FileExistsError:
            continue
        return base.resolve()


def require_archive_file(archive):
    """Fail with a clear message unless `archive` is an existing file.

    An archive is relocatable: nextest maps the build's workspace root to this
    checkout (`--workspace-remap`) and tests resolve binaries and sources from
    their runtime environment, so the path it was built at does not matter.
    """
    if not Path(archive).is_file():
        raise ValueError(f"nextest archive not found: {archive}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("run", "check", "filter"))
    parser.add_argument("shard", nargs="?", choices=SHARDS)
    parser.add_argument(
        "--archive-file", type=Path,
        help="run and check from this `cargo nextest archive` file instead of building; "
             "extracts into this checkout, whatever path the archive was built at",
    )
    args = parser.parse_args()
    archive = None
    if args.archive_file is not None:
        try:
            require_archive_file(args.archive_file.resolve())
        except ValueError as error:
            parser.error(str(error))
        archive = Archive(args.archive_file.resolve())
    expressions = filters()
    if args.action == "check":
        if args.shard is not None:
            parser.error("check verifies all shards; do not specify one")
        universe = inventory(archive=archive)
        selections = {name: inventory(expressions[name], archive) for name in SHARDS}
        validate_coverage(universe, selections)
        for name, tests in selections.items():
            print(f"{name}: {len(tests)} tests")
        print(f"Coverage OK: {len(universe)} tests selected exactly once (including ignored tests)")
        return
    if args.shard is None:
        parser.error("run and filter require a shard")
    if args.action == "filter":
        print(expressions[args.shard])
        return
    # Heavy shards run bounded: heavy spawns real worker/PTY fixtures, and
    # relay-db opens per-test database pools that exhaust the fixture limit.
    profile = {"heavy": "heavy", "relay-db": "relay-db"}.get(args.shard, "ci")
    # CI uploads each job's report under its shard name. Local fast shard runs
    # share the ci report path; copy it before starting the next run if needed.
    with (ROOT / ".config/nextest.toml").open("rb") as config:
        report = junit_report(tomllib.load(config), profile, ROOT)
    # nextest writes the report only when a run completes, so a report left by
    # an earlier run (or restored with target/) would pass for this one when
    # the build fails first; the job summary and upload must see none instead.
    if report is not None:
        report.unlink(missing_ok=True)
    command = nextest_command("run", profile, archive)
    command.extend(["-E", expressions[args.shard]])
    sys.exit(run_checked(command))


def stop_runner(runner):
    """Stop a still running `runner` (SIGTERM, then SIGKILL) and wait for it."""
    if runner.poll() is not None:
        return
    runner.terminate()
    try:
        runner.wait(timeout=RUNNER_STOP_GRACE_SECONDS)
    except subprocess.TimeoutExpired:
        runner.kill()
        runner.wait()


def raise_cancelled(signum, frame):
    """Turn SIGTERM into the interruption a terminal Ctrl-C raises."""
    raise KeyboardInterrupt


def run_checked(command):
    """Run `command` with a per-run fixture base and fail if it leaks a worker.

    Test fixtures are created below `TMPDIR`, so a unique base makes every
    worker the run starts identifiable by its socket path. The check only runs
    where fixtures follow `TMPDIR` (Linux); macOS fixtures use a fixed
    `/private/tmp`, and there the in-process `WorkerGuard` is the check.

    When the run is cancelled the runner is stopped and waited for, workers
    below the base are terminated, and only then is the base removed; the
    cancellation itself is re-raised.
    """
    if sys.platform != "linux":
        return subprocess.run(command, cwd=ROOT, check=False).returncode
    base = make_run_base()
    checked = False
    previous_handler = signal.signal(signal.SIGTERM, raise_cancelled)
    try:
        runner = subprocess.Popen(
            command, cwd=ROOT, env={**os.environ, "TMPDIR": str(base)},
        )
        try:
            status = runner.wait()
        finally:
            stop_runner(runner)
        checked = True
        if not check_no_leaked_workers(base):
            print(
                "error: the test run left pohunek-sessiond workers running (terminated above)",
                file=sys.stderr,
            )
            return status or 1
        return status
    finally:
        if not checked:
            check_no_leaked_workers(base)
        shutil.rmtree(base, ignore_errors=True)
        signal.signal(signal.SIGTERM, previous_handler)
