#!/usr/bin/env python3
"""Run disjoint nextest cost shards and verify coverage using nextest itself.

By default nextest builds the workspace test binaries. With `--archive-file`
every nextest call instead extracts a prebuilt `cargo nextest archive` into
this checkout's `target/` and lists or runs from it without compiling, which
is how CI shares one build across the shard jobs.

The macOS lane (`check-macos`, `run-macos`, `run-macos-tier`) takes the same
archive and checks or runs the macOS package set as nextest selections. Its
coverage check splits that set into disjoint groups (the PR lane, the tier
job, and buckets), so a macOS test cannot be dropped without the check failing.
"""

import argparse
import collections
import json
import os
from pathlib import Path
import secrets
import shutil
import signal
import string
import subprocess
import sys
import tomllib

ROOT = Path(__file__).resolve().parents[1]
# Package ownership partitions the fast set. The complement catches new crates
# and targets automatically; fixture ownership is in profile.fast's filter.
DAEMON = "package(=pohunek-daemon) or package(=pohunek-session-worker) or package(=pohunek-client)"
RELAY = "package(=pohunek-relay) or package(=pohunek-relay-client) or package(=pohunek-relay-protocol)"
CLI = "package(=pohunek-cli)"
# Relay heavy tests are the only consumers of the PostgreSQL fixture, so they
# form their own shard: CI runs them in a job whose Postgres service is gated
# by a paths filter on the relay crates.
SHARDS = ("core", "daemon", "relay", "cli", "relay-db", "heavy")
# The macOS lane runs on every pull request whose platform inputs change and
# holds the packages that gate it natively. The tier packages have macOS-only
# test code too, but a PR does not run them: a separate main and nightly job
# runs `run-macos-tier`. One archive builds all of them, so a package missing
# from the archive is a coverage failure.
LANE_PACKAGES = (
    "pohunek-platform", "pohunek-paths", "pohunek-worker-protocol",
    "pohunek-session-worker", "pohunek-service-config", "pohunek-test-support",
    "pohunek-daemon", "pohunek-cli", "pohunek-hostcheck",
)
TIER_PACKAGES = ("pohunek-client", "pohunek-netbird", "pohunek-package", "xtask")
MACOS_PACKAGES = LANE_PACKAGES + TIER_PACKAGES


def package_set(names):
    """The nextest filter selecting the packages `names`."""
    return " or ".join(f"package(={name})" for name in names)


MACOS_SET = package_set(MACOS_PACKAGES)
LANE_SET = package_set(LANE_PACKAGES)
TIER_SET = package_set(TIER_PACKAGES)
# The run action of each macOS selection, by action name.
MACOS_RUN_SETS = {"run-macos": LANE_SET, "run-macos-tier": TIER_SET}
# Ignored tests of the macOS set that neither the lane nor the tier job runs,
# each with the reason it is run elsewhere. `check-macos` requires every ignored
# test of the scope to match exactly one bucket. A bucket is required to match
# at least one test only when one of its `packages` is in the checked scope.
Bucket = collections.namedtuple("Bucket", "packages expression")
MACOS_BUCKETS = {
    # Runs as root in the sudo step of the lane (APFS foreign-owner refusal).
    "root": Bucket(
        ("pohunek-platform",),
        "package(=pohunek-platform) and "
        "test(=filesystem::tests::apfs_foreign_owned_private_directory_is_rejected)",
    ),
    # Child images that only a parent test starts with `--ignored --exact`.
    "fixture": Bucket(
        ("pohunek-platform", "pohunek-daemon", "pohunek-test-support",
         "pohunek-session-worker", "xtask"),
        " or ".join((
            "(binary_id(=pohunek-platform) and test(/(^|::)hold$/))",
            "(package(=pohunek-daemon) and test(/(^|::)hold$/))",
            "(binary(=launchd) and test(/(^|::)fixture_entry$/))",
            "(binary(=process_lineage) and test(/(^|::)(hold|orphan)$/))",
            "(package(=pohunek-test-support) and test(/(^|::)(umask_probe_test_env|umask_probe_tempdir|hold)$/))",
            "(package(=pohunek-session-worker) and test(/(^|::)environment_listing_child$/))",
            "(binary_id(=pohunek-daemon) and test(/(^|::)daemon_(git_under_|git_subprocesses_under_|fetch_under_)/))",
            "(package(=xtask) and test(/(^|::)changed_files_scenario_under_ambient_git_variables$/))",
        )),
    ),
    # Maintenance tools that print or rewrite a checked-in file. A developer runs
    # them by hand with `--run-ignored only` (the Claude screen captures also
    # need POHUNEK_CLAUDE_CAPTURE_DIR and egress); no CI job does.
    "manual": Bucket(
        ("xtask", "pohunek-cli"),
        " or ".join((
            "(package(=xtask) and test(/(^|::)(survey_hermetic_violations|regenerate_allow_list|regenerate_timing_baseline)$/))",
            "(package(=pohunek-cli) and binary(=claude_package) and test(/^capture_the_real_claude_/))",
        )),
    ),
    # Real-upstream tests of the runtime packages. The Linux package jobs run
    # them under `--profile package`; the Hermes macOS job also runs
    # `hermes_package` with `--include-ignored`.
    "owned-elsewhere": Bucket(
        ("pohunek-cli",),
        "package(=pohunek-cli) and (binary(=claude_package) or binary(=codex_package) "
        "or binary(=pi_package) or binary(=hermes_package)) "
        "and not test(/^capture_the_real_claude_/)",
    ),
}
# The scope of a check: its packages and the nextest selection of them.
# `all` is the 13-package macOS set (the tier job); `lane` is the PR lane.
MACOS_SCOPES = {"all": (MACOS_PACKAGES, MACOS_SET), "lane": (LANE_PACKAGES, LANE_SET)}


def bucket_expression(scope_set, name):
    """The selection of the ignored tests of bucket `name` within `scope_set`."""
    return f"({scope_set}) and ({MACOS_BUCKETS[name].expression})"
# Executable name of the session worker a real daemon starts.
WORKER_EXECUTABLE = "pohunek-sessiond"
# Argument that carries the worker's control socket path.
SOCKET_PATH_ARGUMENT = "--daemon-socket-path"
# Parent of the per-run fixture base.
RUN_BASE_PARENT = Path("/tmp")
# Capacity of a Unix socket path in bytes, including the terminating NUL, on
# the strictest supported platform (Darwin).
SOCKET_PATH_CAPACITY = 104
# Longest socket path below a test root, relative to it
# (`pohunek-test-support` env.rs NESTED_SOCKET_SUFFIX).
NESTED_SOCKET_SUFFIX = len("/run/pohunek/workers/" + "0" * 36 + "/control.sock")
# One test root directory name, `ph-` plus six characters, with its separator.
TEST_ROOT_NAME = len("/ph-XXXXXX")
# The deepest nesting any test uses: a test root whose private `TMPDIR`
# (`<root>/tmp`) is the base of a second test root. The git environment tests
# in the daemon and xtask crates do this.
TMPDIR_NESTING = TEST_ROOT_NAME + len("/tmp")
# Longest base path for which that nested layout still binds its sockets.
RUN_BASE_MAX_LENGTH = SOCKET_PATH_CAPACITY - 1 - NESTED_SOCKET_SUFFIX - TEST_ROOT_NAME - TMPDIR_NESTING
# Random characters of the base name: what is left of the budget after the parent.
RUN_BASE_NAME_LENGTH = RUN_BASE_MAX_LENGTH - len(str(RUN_BASE_PARENT)) - len("/")
RUN_BASE_ALPHABET = string.ascii_lowercase + string.digits
# How long a cancelled runner gets to stop after SIGTERM before it is killed.
RUNNER_STOP_GRACE_SECONDS = 30
# How often the running tests are scanned for worker workloads, so their
# sessions are known even if the process linking them to the worker exits.
RETAIN_POLL_SECONDS = 2


def filters():
    with (ROOT / ".config/nextest.toml").open("rb") as config:
        fast = tomllib.load(config)["profile"]["fast"]["default-filter"]
    owners = {"daemon": DAEMON, "relay": RELAY, "cli": CLI}
    owners["core"] = f"not (({DAEMON}) or ({RELAY}) or ({CLI}))"
    return {
        **{name: f"({fast}) and ({owner})" for name, owner in owners.items()},
        "relay-db": f"(not ({fast})) and ({RELAY})",
        "heavy": f"(not ({fast})) and not ({RELAY})",
    }


def selected_tests(document):
    return {
        (binary_id, name)
        for binary_id, suite in document["rust-suites"].items()
        for name, test in suite["testcases"].items()
        if test["filter-match"]["status"] == "matches"
    }


def validate_coverage(universe, selections):
    if not universe:
        raise ValueError("empty workspace test inventory")
    if set(selections) != set(SHARDS):
        raise ValueError("unexpected shard names")
    empty = [name for name, tests in selections.items() if not tests]
    counts = collections.Counter(test for tests in selections.values() for test in tests)
    missing = universe - counts.keys()
    extra = counts.keys() - universe
    overlap = {test for test, count in counts.items() if count != 1}
    if empty or missing or extra or overlap:
        raise ValueError(
            f"partition coverage failed: empty={empty}, missing={sorted(missing)}, "
            f"extra={sorted(extra)}, overlap={sorted(overlap)}"
        )


# nextest's default `[store] dir`, relative to the workspace root. It does not
# follow CARGO_TARGET_DIR.
DEFAULT_STORE_DIR = "target/nextest"


def junit_report(config, profile, root):
    """The JUnit file nextest writes for `profile`, or None when it writes none.

    Reports live under `[store] dir` (relative to the workspace `root`), then
    the profile name. `junit.path` is inherited along `inherits`, ending at
    `default`, like every other nextest profile setting.
    """
    store = Path(root) / config.get("store", {}).get("dir", DEFAULT_STORE_DIR)
    profiles = config.get("profile", {})
    name = profile
    seen = set()
    while name is not None and name not in seen:
        seen.add(name)
        settings = profiles.get(name, {})
        path = settings.get("junit", {}).get("path")
        if path is not None:
            return store / profile / path
        name = settings.get("inherits", "default" if name != "default" else None)
    return None


def validate_macos_coverage(universe, groups, scope_packages):
    """Require every test of the scope to be run by exactly one group.

    `universe` holds every test of the scope, ignored ones included. `groups`
    maps each group name ("lane", "tier" and each in-scope name of
    MACOS_BUCKETS) to its tests: the non-ignored tests of the lane and tier
    packages, and the ignored tests of each bucket. Also requires each package
    of `scope_packages` to contribute a test, so an archive that dropped a
    package cannot pass. Every group given must be non-empty.
    """
    if not universe:
        raise ValueError("empty macOS test inventory")
    packages = {binary.split("::")[0] for binary, _name in universe}
    absent_packages = [name for name in scope_packages if name not in packages]
    empty = [name for name, tests in groups.items() if not tests]
    owners = collections.defaultdict(list)
    for name, tests in groups.items():
        for test in tests:
            owners[test].append(name)
    missing = sorted(universe - owners.keys())
    extra = sorted(owners.keys() - universe)
    overlap = {test: names for test, names in sorted(owners.items()) if len(names) > 1}
    if absent_packages or empty or missing or extra or overlap:
        raise ValueError(
            f"macOS partition coverage failed: absent packages={absent_packages}, "
            f"empty buckets={empty}, missing={missing}, extra={extra}, "
            f"overlap={overlap}"
        )


class Archive:
    """A nextest archive, extracted into this checkout by its first use.

    The first nextest call extracts the archive (about 1.4 GB, seconds of
    work); every later call of the same invocation reuses the extracted
    binaries through the metadata files the archive carries, so `check`
    extracts once instead of once per shard.
    """

    def __init__(self, file):
        self.file = Path(file)
        self.extracted = False

    def arguments(self):
        """The nextest options selecting the build; extracts on the first call."""
        if not self.extracted:
            self.extracted = True
            return [
                "--archive-file", str(self.file),
                "--extract-to", str(ROOT), "--extract-overwrite",
                "--workspace-remap", str(ROOT),
            ]
        store = ROOT / "target" / "nextest"
        return [
            "--binaries-metadata", str(store / "binaries-metadata.json"),
            "--cargo-metadata", str(store / "cargo-metadata.json"),
            "--workspace-remap", str(ROOT),
            "--target-dir-remap", str(ROOT / "target"),
        ]


def nextest_command(subcommand, profile, archive):
    """The nextest invocation prefix for `subcommand` (`list` or `run`).

    A build run passes the workspace selection to cargo. An archive run takes
    its package and feature selection from the archive and maps the workspace
    root to this checkout. It calls the `cargo-nextest` binary directly when
    that is on PATH, so CI test jobs need no Rust toolchain; otherwise
    `cargo nextest` finds it.
    """
    if archive is None:
        return [
            "cargo", "nextest", subcommand, "--profile", profile, "--workspace",
            "--all-features",
        ]
    direct = shutil.which("cargo-nextest")
    return [
        *([direct, "nextest"] if direct else ["cargo", "nextest"]),
        subcommand, "--profile", profile, *archive.arguments(),
    ]


def inventory(expression=None, archive=None, run_ignored="all", profile="ci"):
    command = nextest_command("list", profile, archive)
    command.extend(["--run-ignored", run_ignored, "--message-format", "json"])
    if expression is not None:
        command.extend(["-E", expression])
    result = subprocess.run(command, cwd=ROOT, check=True, stdout=subprocess.PIPE)
    return selected_tests(json.loads(result.stdout))


class Process:
    """One entry of the process table: identity, command line and executable."""

    def __init__(self, pid, start, argv, executable=None, parent=0, session=0):
        self.pid = pid
        self.start = start
        self.argv = argv
        self.executable = executable
        self.parent = parent
        self.session = session


def stat_fields(stat):
    """`(parent pid, session id, start time)` from `/proc/<pid>/stat`, or None.

    The command name is parenthesised and may contain spaces and parentheses,
    so fields are counted from the last closing parenthesis.
    """
    fields = stat[stat.rfind(")") + 1:].split()
    if len(fields) <= 19:
        return None
    return int(fields[1]), int(fields[3]), fields[19]


def start_time_of(stat):
    """The start time (field 22) in the contents of `/proc/<pid>/stat`."""
    parsed = stat_fields(stat)
    return parsed[2] if parsed else None


def read_processes(proc="/proc"):
    """Every readable process of `proc` with its NUL-separated argument vector.

    Reading `/proc` runs no program, so the result never depends on `PATH`, and
    arguments with spaces stay whole.
    """
    processes = []
    for entry in Path(proc).iterdir():
        if not entry.name.isdigit():
            continue
        try:
            stat = (entry / "stat").read_text(errors="replace")
            cmdline = (entry / "cmdline").read_bytes()
        except OSError:
            continue  # the process ended between the listing and the read
        parsed = stat_fields(stat)
        if parsed is None:
            continue
        parent, session, start = parsed
        try:
            executable = os.readlink(entry / "exe")
        except OSError:
            executable = None
        argv = [os.fsdecode(part) for part in cmdline.split(b"\0")[:-1]]
        processes.append(Process(int(entry.name), start, argv, executable, parent, session))
    return processes


def is_worker(process):
    """Whether `process` runs the session worker, by `argv[0]` or its exe link."""
    names = [Path(process.executable).name.removesuffix(" (deleted)")] if process.executable else []
    if process.argv:
        names.append(Path(process.argv[0]).name)
    return WORKER_EXECUTABLE in names


def leaked_workers(processes, base):
    """Workers among `processes` whose control socket is below `base`.

    The subprocess launcher starts workers with a cleared environment, so the
    only marker a test run leaves on one is the `--daemon-socket-path` value,
    which lies inside a fixture root. A run's `TMPDIR` is a base of its own, so
    workers of the host, of other runs and of other checkouts never match. The
    argument is taken whole from the argument vector, so spaces do not matter.
    Returns `(process, socket path)` pairs.
    """
    found = []
    for process in processes:
        if not is_worker(process) or SOCKET_PATH_ARGUMENT not in process.argv:
            continue
        index = process.argv.index(SOCKET_PATH_ARGUMENT) + 1
        if index < len(process.argv) and Path(process.argv[index]).is_relative_to(base):
            found.append((process, process.argv[index]))
    return found


def led_sessions(processes, worker):
    """`(session id, leader start)` pairs of the sessions `worker`'s descendants lead."""
    by_pid = {p.pid: p for p in processes}
    sessions = set()
    for member in workload_of(processes, worker):
        leader = by_pid.get(member.session)
        if member.session not in (0, worker.session) and leader is not None:
            sessions.add((leader.pid, leader.start))
    return sessions


def retain_sessions(processes, base, retained):
    """Add the sessions led by the workloads of workers below `base` to `retained`."""
    for worker, _socket in leaked_workers(processes, base):
        retained |= led_sessions(processes, worker)


def workload_of(processes, worker, retained=()):
    """Descendants of `worker` and the members of the sessions they lead.

    `retained` holds `(session id, leader start)` pairs seen as this worker's
    workload in earlier scans; those sessions are followed even after the
    intermediate parent exited and the leader was reparented to init. A pair
    whose leader PID now has another start time is a recycled PID and is ignored.

    A descendant that called `setsid` (the PTY child of a worker) leads a
    session of its own, which outlives the worker. The worker's own session is
    never followed: it is shared with the daemon and the test run. Neither the
    worker nor this process is part of the result.
    """
    members = {}
    frontier = [worker.pid]
    while frontier:
        parent = frontier.pop()
        for process in processes:
            if process.parent == parent and process.pid not in (worker.pid, os.getpid()) \
                    and process.pid not in members:
                members[process.pid] = process
                frontier.append(process.pid)
    sessions = {p.session for p in members.values() if p.session not in (0, worker.session)}
    by_pid = {p.pid: p for p in processes}
    for session, start in retained:
        leader = by_pid.get(session)
        if session not in (0, worker.session) and (leader is None or leader.start == start):
            sessions.add(session)
    for process in processes:
        if process.session in sessions and process.pid not in (worker.pid, os.getpid()):
            members.setdefault(process.pid, process)
    return list(members.values())


def kill_if_unchanged(process):
    """SIGKILL `process` only while its PID still has the recorded start time.

    A pidfd pins the process first and the start time is read afterwards, so a
    PID recycled for an unrelated process is never signalled.
    """
    try:
        pidfd = os.pidfd_open(process.pid)
    except ProcessLookupError:
        return False
    try:
        stat = Path(f"/proc/{process.pid}/stat").read_text(errors="replace")
        if start_time_of(stat) != process.start:
            return False
        signal.pidfd_send_signal(pidfd, signal.SIGKILL)
        return True
    except (OSError, ProcessLookupError):
        return False
    finally:
        os.close(pidfd)


def check_no_leaked_workers(base, retained=()):
    """Terminate and report workers a run left below `base`; True when none did.

    `retained` carries the sessions seen as workload during the run.
    """
    processes = read_processes()
    leaked = leaked_workers(processes, base)
    for process, socket in leaked:
        print(f"leaked pohunek-sessiond worker: pid {process.pid}, socket {socket}", file=sys.stderr)
        # The workload goes first: a worker killed first leaves its PTY session
        # running with the fixture root deleted beneath it.
        for member in workload_of(processes, process, retained):
            kill_if_unchanged(member)
        kill_if_unchanged(process)
    return not leaked


def make_run_base():
    """Create the private, unique, short fixture base of one run.

    `mkdir` is exclusive, so concurrent runs never share a base.
    """
    while True:
        name = "".join(secrets.choice(RUN_BASE_ALPHABET) for _ in range(RUN_BASE_NAME_LENGTH))
        base = RUN_BASE_PARENT / name
        try:
            base.mkdir(mode=0o700)
        except FileExistsError:
            continue
        return base.resolve()


def require_archive_file(archive):
    """Fail with a clear message unless `archive` is an existing file.

    An archive is relocatable: nextest maps the build's workspace root to this
    checkout (`--workspace-remap`) and tests resolve binaries and sources from
    their runtime environment, so the path it was built at does not matter.
    """
    if not Path(archive).is_file():
        raise ValueError(f"nextest archive not found: {archive}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "action",
        choices=("run", "check", "filter", "check-macos", *MACOS_RUN_SETS),
    )
    parser.add_argument("shard", nargs="?", choices=SHARDS)
    parser.add_argument(
        "--scope", choices=tuple(MACOS_SCOPES),
        help="check-macos only: `all` (default) checks the 13-package set, `lane` the PR lane's 9 packages",
    )
    parser.add_argument(
        "--archive-file", type=Path,
        help="run and check from this `cargo nextest archive` file instead of building; "
             "extracts into this checkout, whatever path the archive was built at",
    )
    args = parser.parse_args()
    archive = None
    if args.archive_file is not None:
        try:
            require_archive_file(args.archive_file.resolve())
        except ValueError as error:
            parser.error(str(error))
        archive = Archive(args.archive_file.resolve())
    if args.action == "check-macos" or args.action in MACOS_RUN_SETS:
        if archive is None:
            parser.error(f"{args.action} needs --archive-file: the macOS lane never builds")
        if args.shard is not None:
            parser.error(f"{args.action} takes no shard")
        if args.action == "check-macos":
            check_macos(archive, args.scope or "all")
            return
        if args.scope is not None:
            parser.error("--scope applies to check-macos only")
        run_nextest("macos", MACOS_RUN_SETS[args.action], archive)
    expressions = filters()
    if args.action == "check":
        if args.shard is not None:
            parser.error("check verifies all shards; do not specify one")
        universe = inventory(archive=archive)
        selections = {name: inventory(expressions[name], archive) for name in SHARDS}
        validate_coverage(universe, selections)
        for name, tests in selections.items():
            print(f"{name}: {len(tests)} tests")
        print(f"Coverage OK: {len(universe)} tests selected exactly once (including ignored tests)")
        return
    if args.shard is None:
        parser.error("run and filter require a shard")
    if args.action == "filter":
        print(expressions[args.shard])
        return
    # Heavy shards run bounded: heavy spawns real worker/PTY fixtures, and
    # relay-db opens per-test database pools that exhaust the fixture limit.
    profile = {"heavy": "heavy", "relay-db": "relay-db"}.get(args.shard, "ci")
    # CI uploads each job's report under its shard name. Local fast shard runs
    # share the ci report path; copy it before starting the next run if needed.
    run_nextest(profile, expressions[args.shard], archive)


def check_macos(archive, scope):
    """List the scope's tests from the archive; exit 1 unless their partition is exact.

    Only the groups that intersect the scope are listed: the tier group needs a
    tier package in scope, and a bucket needs one of its packages in scope.
    """
    packages, scope_set = MACOS_SCOPES[scope]
    universe = inventory(scope_set, archive, "all", "macos")
    groups = {"lane": inventory(LANE_SET, archive, "default", "macos")}
    if set(TIER_PACKAGES) & set(packages):
        groups["tier"] = inventory(TIER_SET, archive, "default", "macos")
    for name, bucket in MACOS_BUCKETS.items():
        if set(bucket.packages) & set(packages):
            groups[name] = inventory(bucket_expression(scope_set, name), archive, "only", "macos")
    try:
        validate_macos_coverage(universe, groups, packages)
    except ValueError as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(1)
    for name, tests in groups.items():
        print(f"{name}: {len(tests)} tests")
    print(
        f"macOS coverage OK: {len(universe)} tests selected exactly once "
        "(including ignored tests)"
    )


def run_nextest(profile, expression, archive):
    """Run `expression` under `profile` and exit with nextest's status.

    The profile's previous JUnit report is removed first: nextest writes the
    report only when a run completes, so a report left by an earlier run would
    pass for this one when the build fails first.
    """
    with (ROOT / ".config/nextest.toml").open("rb") as config:
        report = junit_report(tomllib.load(config), profile, ROOT)
    if report is not None:
        report.unlink(missing_ok=True)
    command = nextest_command("run", profile, archive)
    command.extend(["-E", expression])
    sys.exit(run_checked(command))


def remove_tree(path):
    """Remove `path`, including directories a test left without owner permissions.

    Every directory is made owner-accessible before it is entered; symlinks are
    never followed or changed.
    """
    path = Path(path)
    path.chmod(0o700)
    for directory, subdirectories, _files in os.walk(path):
        for name in subdirectories:
            entry = os.path.join(directory, name)
            if not os.path.islink(entry):
                os.chmod(entry, 0o700)
    shutil.rmtree(path, ignore_errors=True)


def stop_runner(runner):
    """Stop a still running `runner` (SIGTERM, then SIGKILL) and wait for it."""
    if runner.poll() is not None:
        return
    runner.terminate()
    try:
        runner.wait(timeout=RUNNER_STOP_GRACE_SECONDS)
    except subprocess.TimeoutExpired:
        runner.kill()
        runner.wait()


def raise_cancelled(signum, frame):
    """Turn SIGTERM into the interruption a terminal Ctrl-C raises."""
    raise KeyboardInterrupt


def run_checked(command):
    """Run `command` with a per-run fixture base and fail if it leaks a worker.

    Test fixtures are created below `TMPDIR`, so a unique base makes every
    worker the run starts identifiable by its socket path. The check only runs
    where fixtures follow `TMPDIR` (Linux); macOS fixtures use a fixed
    `/private/tmp`, and there the in-process `WorkerGuard` is the check.

    When the run is cancelled the runner is stopped and waited for, workers
    below the base are terminated, and only then is the base removed; the
    cancellation itself is re-raised.
    """
    if sys.platform != "linux":
        return subprocess.run(command, cwd=ROOT, check=False).returncode
    base = make_run_base()
    checked = False
    retained = set()
    previous_handler = signal.signal(signal.SIGTERM, raise_cancelled)
    try:
        runner = subprocess.Popen(
            command, cwd=ROOT, env={**os.environ, "TMPDIR": str(base)},
        )
        try:
            while True:
                try:
                    status = runner.wait(timeout=RETAIN_POLL_SECONDS)
                    break
                except subprocess.TimeoutExpired:
                    retain_sessions(read_processes(), base, retained)
        finally:
            stop_runner(runner)
        checked = True
        if not check_no_leaked_workers(base, retained):
            print(
                "error: the test run left pohunek-sessiond workers running (terminated above)",
                file=sys.stderr,
            )
            return status or 1
        return status
    finally:
        if not checked:
            check_no_leaked_workers(base, retained)
        remove_tree(base)
        signal.signal(signal.SIGTERM, previous_handler)


if __name__ == "__main__":
    main()
