#!/usr/bin/env bash
# Provision the repository-locked Hermes runtime for model-free CI checks.

set -euo pipefail

readonly SCRIPT_NAME="${0##*/}"
readonly REQUIRED_ARGUMENTS=1
readonly LOCK_RELATIVE_PATH="compat/hermes/compatibility-lock.json"
readonly EXPECTED_LOCK_SHA256="dc4b7cc3e7c450609200f629050ece509b53c56a57ee21cdbedb89fa1385602a"
readonly EXPECTED_ARCHIVE_FORMAT="git archive --format=tar"
readonly PYTHON_MINIMUM_MINOR=11
readonly PYTHON_MAXIMUM_MINOR=14

# Network bounds of the git fetch and the CPython download; uv keeps its own
# defaults (30 s read timeout, 3 retries). The download finishes, retries a
# bounded number of times or fails with a message naming it. The git fetch has
# no total cap and no connect timeout, only the stall bound: a transfer slower
# than NETWORK_STALL_BYTES per second for NETWORK_STALL_SECONDS counts as
# stalled, and a connect that never completes waits for libcurl's own default.
# The last progress line names the phase, and the CI step timeout is the outer
# backstop.
readonly NETWORK_ATTEMPTS=3
readonly NETWORK_RETRY_DELAY_SECONDS=5
readonly NETWORK_CONNECT_TIMEOUT_SECONDS=30
readonly NETWORK_STALL_SECONDS=60
readonly NETWORK_STALL_BYTES=1024
readonly DOWNLOAD_MAX_SECONDS=120

# Pinned CPython runtime of the Hermes venv: a python-build-standalone
# `install_only_stripped` build, downloaded and verified here rather than taken
# from the host. Its macOS build is not a framework build, so the venv's
# bin/python is the image that runs the Hermes script; a framework build's
# bin/python3.x is a stub that re-executes Python.app, which the worker's
# frozen launch rule refuses. The digests are those the release publishes in
# its SHA256SUMS; changing the release or version needs both digests renewed.
readonly PYTHON_STANDALONE_BASE_URL="https://github.com/astral-sh/python-build-standalone/releases/download"
readonly PYTHON_STANDALONE_RELEASE="20260807"
readonly PYTHON_STANDALONE_VERSION="3.12.13"
readonly PYTHON_STANDALONE_FLAVOR="install_only_stripped"
readonly PYTHON_STANDALONE_SHA256_X86_64_LINUX_GNU="506191be3ee7bd190a8834dcdc1b3bc70aab50608deccc711935aa007239cabd"
readonly PYTHON_STANDALONE_SHA256_AARCH64_DARWIN="25baa97c65b3f0aa90e21131b4f9e80aef8899e8144006db8a9d2c1ab9e807e3"

fail() {
  printf '%s: %s\n' "$SCRIPT_NAME" "$1" >&2
  exit 1
}

# Progress marker on stderr: the last line of a hung run names the phase.
phase() {
  printf '%s: %s\n' "$SCRIPT_NAME" "$1" >&2
}

if [[ "$#" -ne "$REQUIRED_ARGUMENTS" ]]; then
  printf 'usage: %s /absolute/path/to/install-root\n' "$SCRIPT_NAME" >&2
  exit 2
fi

install_root="$1"
if [[ "$install_root" != /* || "$install_root" == "/" || -e "$install_root" ]]; then
  fail "install root must be an unused absolute path other than /"
fi

for executable in curl git python3 tar uv; do
  command -v "$executable" >/dev/null 2>&1 || fail "required executable is unavailable: $executable"
done

# Prints the lowercase hex SHA-256 of the file in $1. GNU coreutils ships
# sha256sum; macOS ships shasum instead. Exactly one of them must exist.
sha256_of() {
  local digest
  if command -v sha256sum >/dev/null 2>&1; then
    digest="$(sha256sum "$1")" || return 1
  elif command -v shasum >/dev/null 2>&1; then
    digest="$(shasum -a 256 "$1")" || return 1
  else
    fail "required executable is unavailable: sha256sum or shasum"
  fi
  printf '%s\n' "${digest%% *}"
}
sha256_of "$0" >/dev/null || fail "SHA-256 tool is unusable"

script_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)"
lock_path="$script_root/$LOCK_RELATIVE_PATH"
[[ -f "$lock_path" && ! -L "$lock_path" ]] || fail "compatibility lock is missing or is a symlink"
observed_lock_sha256="$(sha256_of "$lock_path")"
[[ "$observed_lock_sha256" == "$EXPECTED_LOCK_SHA256" ]] \
  || fail "compatibility lock SHA-256 does not match the reviewed digest"

# The host python3 only runs the small helper programs below; the Hermes venv
# uses the pinned CPython runtime.
python_bin="$(command -v python3)"
python_bin="$("$python_bin" -c 'import os, sys; print(os.path.realpath(sys.argv[1]))' "$python_bin")"

case "$(uname -s)/$(uname -m)" in
  Linux/x86_64)
    python_target="x86_64-unknown-linux-gnu"
    python_archive_sha256="$PYTHON_STANDALONE_SHA256_X86_64_LINUX_GNU"
    ;;
  Darwin/arm64)
    python_target="aarch64-apple-darwin"
    python_archive_sha256="$PYTHON_STANDALONE_SHA256_AARCH64_DARWIN"
    ;;
  *)
    fail "no pinned CPython runtime for $(uname -s)/$(uname -m); supported: Linux/x86_64, Darwin/arm64"
    ;;
esac

# The Python programs below are single-quoted `-c` strings rather than heredocs
# inside `$(...)`, which bash 3.2 (macOS /bin/bash) mis-parses.
readonly LOCK_READER_PROGRAM='
import json
import pathlib
import sys

upstream = json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))["upstream"]
fields = (
    upstream["release"],
    upstream["tag"],
    upstream["repository"],
    upstream["commit"],
    upstream["tree"],
    upstream["source_archive"]["format"],
    upstream["source_archive"]["sha256"],
)
if not all(isinstance(field, str) for field in fields):
    raise SystemExit("Hermes compatibility lock fields must be strings")
for field in fields:
    sys.stdout.write(field)
    sys.stdout.write("\0")
'
readonly REALPATH_PROGRAM='
import os
import sys

resolved = os.path.realpath(sys.argv[1])
if not os.path.exists(resolved):
    raise SystemExit(1)
sys.stdout.write(resolved)
'
# Prints the path of the shared libpython of the interpreter running it, or
# nothing for a static or framework build. The dynamic loader resolves the
# library by its soname (INSTSONAME) on Linux; on macOS the shared library file
# is LDLIBRARY, and a framework build names a path inside the framework instead.
# A relocatable build records its build-time prefix in sysconfig, so LIBDIR is
# taken relative to that prefix and placed under the running one.
readonly PYTHON_LIBRARY_PROGRAM='
import os
import sys
import sysconfig

if sysconfig.get_config_var("Py_ENABLE_SHARED") != 1:
    raise SystemExit(0)
key = "LDLIBRARY" if sys.platform == "darwin" else "INSTSONAME"
name = sysconfig.get_config_var(key) or ""
library_dir = sysconfig.get_config_var("LIBDIR") or ""
build_prefix = sysconfig.get_config_var("prefix") or ""
if not name or os.sep in name or not os.path.isabs(library_dir):
    raise SystemExit(0)
if os.path.isabs(build_prefix):
    relative = os.path.relpath(library_dir, build_prefix)
    if not relative.startswith(os.pardir):
        library_dir = os.path.join(sys.base_prefix, relative)
sys.stdout.write(os.path.join(library_dir, name))
'
# Validates the interpreter running it as the Hermes venv runtime: exactly the
# pinned version argv[1], inside the supported minor range argv[2]..argv[3),
# and not a macOS framework build.
readonly RUNTIME_CHECK_PROGRAM='
import sys
import sysconfig

expected = tuple(int(part) for part in sys.argv[1].split("."))
minimum = int(sys.argv[2])
maximum = int(sys.argv[3])
if sysconfig.get_config_var("PYTHONFRAMEWORK"):
    raise SystemExit(
        "the Python runtime is a macOS framework build; its bin/python is a "
        "stub that re-executes Python.app, so the frozen launch rule would "
        "refuse every Hermes root"
    )
if sys.version_info[:3] != expected:
    raise SystemExit(
        "the Python runtime reports "
        + ".".join(str(part) for part in sys.version_info[:3])
        + ", not the pinned "
        + sys.argv[1]
    )
if sys.version_info.major != 3 or not minimum <= sys.version_info.minor < maximum:
    raise SystemExit(
        f"Hermes compatibility requires Python 3.{minimum}-3.{maximum - 1}"
    )
'
# Exits non-zero unless the first line of the script in argv[1] is a direct
# `#!<absolute path>` shebang, without arguments, naming a Python executable
# in the script's own directory. uv writes a `/bin/sh` exec trampoline instead
# when the interpreter path is too long for a shebang or contains a space.
readonly DIRECT_SHEBANG_PROGRAM='
import os
import sys

script_path = os.path.realpath(sys.argv[1])
with open(script_path, "rb") as script:
    first_line = script.readline().rstrip(b"\n")
if not first_line.startswith(b"#!/"):
    raise SystemExit(1)
interpreter = os.fsdecode(first_line[2:])
if any(character.isspace() for character in interpreter):
    raise SystemExit(1)
resolved = os.path.realpath(interpreter)
if (
    os.path.dirname(resolved) != os.path.dirname(script_path)
    or not os.path.basename(resolved).startswith("python")
    or not os.path.isfile(resolved)
    or not os.access(resolved, os.X_OK)
):
    raise SystemExit(1)
'

# `read -d ''` keeps this portable to bash 3.2, which has no readarray.
lock_fields=()
while IFS= read -r -d '' lock_field; do
  lock_fields+=("$lock_field")
done < <("$python_bin" -c "$LOCK_READER_PROGRAM" "$lock_path")
[[ "${#lock_fields[@]}" -eq 7 ]] || fail "compatibility lock is malformed"

release="${lock_fields[0]}"
tag="${lock_fields[1]}"
repository="${lock_fields[2]}"
commit="${lock_fields[3]}"
tree="${lock_fields[4]}"
archive_format="${lock_fields[5]}"
archive_sha256="${lock_fields[6]}"

[[ "$release" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || fail "locked release is invalid"
[[ "$tag" =~ ^[A-Za-z0-9._-]+$ ]] || fail "locked tag is invalid"
[[ "$repository" =~ ^https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] \
  || fail "locked repository must be an HTTPS GitHub repository"
[[ "$commit" =~ ^[0-9a-f]{40}$ ]] || fail "locked commit is invalid"
[[ "$tree" =~ ^[0-9a-f]{40}$ ]] || fail "locked tree is invalid"
[[ "$archive_format" == "$EXPECTED_ARCHIVE_FORMAT" ]] || fail "locked archive format is unsupported"
[[ "$archive_sha256" =~ ^[0-9a-f]{64}$ ]] || fail "locked archive SHA-256 is invalid"

# No provider or GitHub credential is needed. Clearing common credential and
# Git transport variables prevents a caller's ambient secrets from reaching
# the verified upstream build or its dependency installers.
unset ANTHROPIC_API_KEY AZURE_OPENAI_API_KEY GITHUB_TOKEN GH_TOKEN GOOGLE_API_KEY
unset HERMES_API_KEY OPENAI_API_KEY OPENROUTER_API_KEY SSH_AUTH_SOCK
unset GIT_ASKPASS GIT_SSH GIT_SSH_COMMAND
unset PIP_EXTRA_INDEX_URL PIP_INDEX_URL PIP_TRUSTED_HOST
unset UV_DEFAULT_INDEX UV_EXTRA_INDEX_URL UV_INDEX UV_INDEX_URL
unset UV_KEYRING_PROVIDER UV_NATIVE_TLS UV_NO_VERIFY_HOST
unset UV_PYTHON UV_PYTHON_DOWNLOADS_JSON_URL UV_PYTHON_INSTALL_MIRROR
unset ACTIONS_CACHE_URL ACTIONS_ID_TOKEN_REQUEST_TOKEN ACTIONS_ID_TOKEN_REQUEST_URL
unset ACTIONS_RESULTS_URL ACTIONS_RUNTIME_TOKEN
unset GITHUB_ENV GITHUB_OUTPUT GITHUB_PATH GITHUB_STEP_SUMMARY
export GIT_CONFIG_GLOBAL=/dev/null
export GIT_CONFIG_NOSYSTEM=1
export GIT_TERMINAL_PROMPT=0

mkdir -m 0700 -- "$install_root"
source_root="$install_root/source"
archive_path="$install_root/source.tar"
venv_root="$install_root/venv"
uv_cache_root="$install_root/uv-cache"
python_archive_path="$install_root/python.tar.gz"
python_root="$install_root/python"

git init --quiet "$source_root" >&2
git -C "$source_root" remote add origin "${repository}.git"
fetch_attempt=1
phase "fetching the locked tag $tag (attempt $fetch_attempt of $NETWORK_ATTEMPTS)"
until git -C "$source_root" -c credential.helper= -c core.askPass= \
  -c http.lowSpeedLimit="$NETWORK_STALL_BYTES" -c http.lowSpeedTime="$NETWORK_STALL_SECONDS" \
  fetch --quiet --no-tags --depth=1 origin "refs/tags/$tag:refs/tags/$tag" >&2; do
  [[ "$fetch_attempt" -lt "$NETWORK_ATTEMPTS" ]] \
    || fail "cannot fetch the locked tag $tag from $repository after $NETWORK_ATTEMPTS attempts (a transfer below $NETWORK_STALL_BYTES bytes/s for $NETWORK_STALL_SECONDS s counts as stalled)"
  fetch_attempt=$((fetch_attempt + 1))
  sleep "$NETWORK_RETRY_DELAY_SECONDS"
  phase "fetching the locked tag $tag (attempt $fetch_attempt of $NETWORK_ATTEMPTS)"
done

observed_commit="$(git -C "$source_root" rev-parse --verify "refs/tags/$tag^{commit}")"
[[ "$observed_commit" == "$commit" ]] || fail "locked tag does not resolve to the locked commit"
observed_tree="$(git -C "$source_root" rev-parse --verify "$commit^{tree}")"
[[ "$observed_tree" == "$tree" ]] || fail "locked commit does not contain the locked tree"

git -C "$source_root" archive --format=tar "$commit" >"$archive_path"
observed_archive_sha256="$(sha256_of "$archive_path")"
[[ "$observed_archive_sha256" == "$archive_sha256" ]] \
  || fail "canonical source archive SHA-256 does not match the compatibility lock"

git -C "$source_root" checkout --quiet --detach "$commit" >&2

# `-q` keeps a caller's curlrc out of the download; the digest check below is
# what makes the archive trusted. The timeouts and the bounded retry keep a
# silent network from holding the step.
python_archive_name="cpython-${PYTHON_STANDALONE_VERSION}+${PYTHON_STANDALONE_RELEASE}-${python_target}-${PYTHON_STANDALONE_FLAVOR}.tar.gz"
phase "downloading the pinned CPython runtime $python_archive_name"
curl -q --proto '=https' --tlsv1.2 --fail --silent --show-error --location \
  --connect-timeout "$NETWORK_CONNECT_TIMEOUT_SECONDS" \
  --max-time "$DOWNLOAD_MAX_SECONDS" \
  --speed-limit "$NETWORK_STALL_BYTES" --speed-time "$NETWORK_STALL_SECONDS" \
  --retry "$((NETWORK_ATTEMPTS - 1))" --retry-delay "$NETWORK_RETRY_DELAY_SECONDS" \
  --output "$python_archive_path" \
  "$PYTHON_STANDALONE_BASE_URL/$PYTHON_STANDALONE_RELEASE/${python_archive_name//+/%2B}" \
  || fail "cannot download the pinned CPython runtime $python_archive_name (connect timeout ${NETWORK_CONNECT_TIMEOUT_SECONDS}s, ${DOWNLOAD_MAX_SECONDS}s per attempt, $NETWORK_ATTEMPTS attempts)"
observed_python_archive_sha256="$(sha256_of "$python_archive_path")"
[[ "$observed_python_archive_sha256" == "$python_archive_sha256" ]] \
  || fail "pinned CPython runtime archive SHA-256 does not match the reviewed digest"
tar -xzf "$python_archive_path" -C "$install_root"
python_runtime="$python_root/bin/python${PYTHON_STANDALONE_VERSION%.*}"
[[ -f "$python_runtime" && -x "$python_runtime" && ! -L "$python_runtime" ]] \
  || fail "pinned CPython archive did not provide $python_runtime"
"$python_runtime" -I -c "$RUNTIME_CHECK_PROGRAM" \
  "$PYTHON_STANDALONE_VERSION" "$PYTHON_MINIMUM_MINOR" "$PYTHON_MAXIMUM_MINOR" \
  || fail "pinned CPython runtime is unusable for the Hermes venv"

# Copy the pinned interpreter into the venv so Pohunek's production runner
# can prove that the sibling Python runtime is contained by this install root.
# `--without-pip` avoids an unnecessary installer; uv populates the environment
# from the reviewed upstream lock in the next step.
"$python_runtime" -I -m venv --copies --without-pip "$venv_root" >&2

# Some relocatable Python distributions link their copied executable to a
# libpython beside the venv, rather than carrying it in the executable. Keep
# exactly that runtime dependency inside the isolated installation root; other
# libpython builds in the same LIBDIR (another Python, the stable-ABI shim)
# are not loaded by this interpreter.
python_library="$("$python_runtime" -I -c "$PYTHON_LIBRARY_PROGRAM")" \
  || fail "cannot read the interpreter's shared library from sysconfig"
if [[ -n "$python_library" ]]; then
  [[ -f "$python_library" ]] \
    || fail "the interpreter's shared libpython is missing: $python_library"
  # A plain cp follows a symlinked library, so the copy is the library itself.
  cp -p "$python_library" "$venv_root/lib/${python_library##*/}"
fi

# Use only the reviewed upstream lock. UV_PYTHON_DOWNLOADS=never prevents uv
# from substituting a downloaded interpreter. --frozen is intentional: newer
# uv releases re-resolve and reject this historical lock under --locked, while
# frozen consumes its exact hash-pinned resolution without modifying it.
phase "installing the locked Hermes dependencies with uv"
UV_CACHE_DIR="$uv_cache_root" \
  UV_NO_CONFIG=1 \
  UV_PYTHON_DOWNLOADS=never \
  UV_PROJECT_ENVIRONMENT="$venv_root" \
  uv sync --extra all --frozen --project "$source_root" >&2 \
  || fail "cannot install the locked Hermes dependencies"
# The cache is only an install-time input: the environment holds its own
# copies or hard links, and the cache's absolute links would leave a
# verified stage.
rm -rf -- "$uv_cache_root"

# Symlink-free install root, so the containment check below also holds when the
# caller's path crosses a symlink (macOS /var -> /private/var).
canonical_install_root="$(cd -- "$install_root" && pwd -P)"
runtime_bin="$("$python_bin" -c "$REALPATH_PROGRAM" "$venv_root/bin/python3")" \
  || fail "locked installation did not produce a Python runtime"
[[ "$runtime_bin" == "$canonical_install_root"/* ]] \
  || fail "locked Python runtime escaped the isolated installation root"
hermes_bin="$venv_root/bin/hermes"
[[ -f "$hermes_bin" && -x "$hermes_bin" && ! -L "$hermes_bin" ]] \
  || fail "locked installation did not produce a regular Hermes executable"
# Pohunek freezes the launched script and its shebang interpreter, so Hermes
# must start the venv Python directly rather than through a shell trampoline.
"$python_bin" -c "$DIRECT_SHEBANG_PROGRAM" "$hermes_bin" \
  || fail "uv wrote $hermes_bin as a /bin/sh trampoline instead of a direct #!<python> script; the venv interpreter path is too long for a shebang or contains whitespace, so choose a shorter install root without spaces"
mkdir -m 0700 -- "$install_root/home" "$install_root/hermes-home"
version_output="$(
  env -i \
    ALL_PROXY="http://127.0.0.1:9" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$install_root/unreachable-dbus" \
    HOME="$install_root/home" \
    HERMES_HOME="$install_root/hermes-home" \
    HTTPS_PROXY="http://127.0.0.1:9" \
    HTTP_PROXY="http://127.0.0.1:9" \
    PATH="/usr/bin:/bin" \
    LANG=C \
    LC_ALL=C \
    NO_COLOR=1 \
    NO_PROXY="localhost,127.0.0.1" \
    PYTHONDONTWRITEBYTECODE=1 \
    all_proxy="http://127.0.0.1:9" \
    https_proxy="http://127.0.0.1:9" \
    http_proxy="http://127.0.0.1:9" \
    no_proxy="localhost,127.0.0.1" \
    "$hermes_bin" --version
)"
[[ "$version_output" == *"Hermes Agent v$release "* ]] \
  || fail "installed Hermes executable does not report the locked release"

printf '%s\n' "$hermes_bin"
