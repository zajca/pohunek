# except on a root-owned sticky directory such as `/tmp`.
UNSAFE_WRITE_BITS = 0o022
STICKY_BIT = 0o1000
# Name of the check row.
HERMES_TOOL_NAME = "hermes-test-python"
# Default private directory of the printed fix. It must be owned by the
