def word_list(items):
    """`a`, `a and b`, `a, b and c`."""
    items = list(items)
    if len(items) < 2:
        return "".join(items)
    return f"{', '.join(items[:-1])} and {items[-1]}"


# The real-systemd suites, `(package, test file)` in the order the CI job
# `real systemd supervision` runs them, each selected by `suite_selector`.
SYSTEMD_SUITE_FILES = (
    ("pohunek-platform", "crates/platform/tests/systemd.rs"),
    ("pohunek-daemon", "crates/daemon/tests/systemd_durable_worker.rs"),
    ("pohunek-cli", "crates/cli/tests/service_systemd.rs"),
    ("pohunek-cli", "crates/cli/tests/setup_host_native.rs"),
    ("pohunek-cli", "crates/cli/tests/setup_host.rs"),
    ("pohunek-daemon", "crates/daemon/tests/supervised_lifecycle.rs"),
    ("pohunek-cli", "crates/cli/tests/service_upgrade.rs"),
    ("pohunek-cli", "crates/cli/tests/workflow_systemd.rs"),
    ("pohunek-cli", "crates/cli/tests/workflow_reactions.rs"),
)
SYSTEMD_SUITES = word_list(file for _, file in SYSTEMD_SUITE_FILES)
# Packages whose integration test files are modules of one `all` test binary.
ONE_TEST_BINARY_PACKAGES = ("pohunek-cli",)


def suite_selector(package, file):
    """The `<suite>` of `cargo test` that selects the tests of one test file, up
    to and including the `--` before libtest's arguments: the file's own test
    binary, or the `all` binary filtered to the file's module."""
    stem = Path(file).stem
    if package in ONE_TEST_BINARY_PACKAGES:
        return f"-p {package} --test all -- {stem}::"
    return f"-p {package} --test {stem} --"


# The `<suite>` of each real-systemd suite, as the CI job selects it.
SYSTEMD_SUITE_SELECTORS = word_list(
    f"`{suite_selector(package, file)}`" for package, file in SYSTEMD_SUITE_FILES
)
# The packages whose tests drive the real launchd `gui/<uid>` domain, with
