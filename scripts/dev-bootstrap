HERMES_PRIVATE_ROOT = '"${XDG_DATA_HOME:-$HOME/.local/share}/pohunek/hermes-test-python"'
# Line prefix of a fix in the report; continuation lines of a multi-line fix
# align under its first line.
FIX_PREFIX = "           fix: "
# Marks a cargo-subcommand row's location: Cargo, not a PATH lookup, chose
# the binary that ran.
CARGO_RESOLUTION = " (Cargo's resolution)"
