# write_seed VM: builds the NoCloud seed (cloud-init) for one VM.
write_seed() {
  ws_vm=$1
  ws_dir="$run/seed-$ws_vm"
  mkdir -p "$ws_dir" || return 1
  ssh-keygen -q -t ed25519 -N '' -C "ph1112-host-$ws_vm" -f "$run/hostkey-$ws_vm" || return 1
  if [ ! -f "$run/id_ed25519" ]; then
    ssh-keygen -q -t ed25519 -N '' -C ph1112-client -f "$run/id_ed25519" || return 1
  fi
  {
    printf '#cloud-config\n'
    printf 'users:\n'
    printf '  - name: ph\n'
    printf '    sudo: ALL=(ALL) NOPASSWD:ALL\n'
    printf '    shell: /bin/bash\n'
    printf '    lock_passwd: true\n'
    printf '    ssh_authorized_keys:\n'
    printf '      - %s\n' "$(cat "$run/id_ed25519.pub")"
    printf 'ssh_pwauth: false\n'
    printf 'ssh_deletekeys: true\n'
    printf 'ssh_genkeytypes: [ed25519]\n'
    printf 'ssh_keys:\n'
    printf '  ed25519_private: |\n'
    sed 's/^/    /' "$run/hostkey-$ws_vm"
    printf '  ed25519_public: %s\n' "$(cat "$run/hostkey-$ws_vm.pub")"
    printf 'runcmd:\n'
    printf '  - [loginctl, enable-linger, ph]\n'
  } >"$ws_dir/user-data"
  {
    printf 'instance-id: ph1112-%s-%s\n' "$run_ts" "$ws_vm"
    printf 'local-hostname: lab-%s\n' "$ws_vm"
  } >"$ws_dir/meta-data"
  {
    printf 'version: 2\n'
    printf 'ethernets:\n'
    printf '  wan:\n'
    printf '    match: {macaddress: "52:54:00:11:00:0%s"}\n' "$(vm_index "$ws_vm")"
    printf '    set-name: eth0\n'
    printf '    dhcp4: true\n'
    printf '  lan:\n'
    printf '    match: {macaddress: "52:54:00:77:00:0%s"}\n' "$(vm_index "$ws_vm")"
    printf '    set-name: eth1\n'
    printf '    addresses: ["%s/24"]\n' "$(vm_lab_ip "$ws_vm")"
  } >"$ws_dir/network-config"
  (cd "$ws_dir" && genisoimage -quiet -output "$run/seed-$ws_vm.iso" -volid cidata -joliet -rock user-data meta-data network-config) || return 1
  qemu-img create -q -f qcow2 -F qcow2 -b "$cache_dir/debian-$debian_image_version.qcow2" "$run/vm-$ws_vm.qcow2" "$vm_disk" || return 1
  printf '[127.0.0.1]:%s %s\n' "$(vm_port "$ws_vm")" "$(cut -d' ' -f1,2 "$run/hostkey-$ws_vm.pub")" >>"$run/known_hosts"
}

vm_index() {
  case $1 in
    a) printf 1 ;;
    b) printf 2 ;;
  esac
}

# write_vm_runner VM LOCAL-UDP-PORT REMOTE-UDP-PORT: the script a slot wrapper
# runs. It signals that the slot is held, waits for `go`, then execs qemu in the
# foreground so the slot lasts as long as the VM.
write_vm_runner() {
  wr_vm=$1
  cat >"$run/vm-$wr_vm.sh" <<EOF
#!/bin/sh
set -eu
: >"$run/slot-$wr_vm.held"
while [ ! -e "$run/go" ]; do
  [ ! -e "$run/abort" ] || exit 1
  sleep 1
done
exec qemu-system-x86_64 \\
  -name ph1112-$run_ts-$wr_vm \\
  -machine q35,accel=kvm -cpu host -smp $vm_cpus -m $vm_memory_mib \\
  -display none -serial file:$run/vm-$wr_vm.console -no-reboot \\
  -pidfile $run/vm-$wr_vm.pid \\
  -monitor unix:$run/vm-$wr_vm.mon,server,nowait \\
  -drive file=$run/vm-$wr_vm.qcow2,if=virtio,format=qcow2 \\
  -drive file=$run/seed-$wr_vm.iso,if=virtio,format=raw,readonly=on \\
  -netdev user,id=wan,net=10.0.$(( $(vm_index "$wr_vm") + 1 )).0/24,restrict=on,hostfwd=tcp:127.0.0.1:$(vm_port "$wr_vm")-:22 \\
  -device virtio-net-pci,netdev=wan,mac=52:54:00:11:00:0$(vm_index "$wr_vm") \\
  -netdev dgram,id=lan,local.type=inet,local.host=127.0.0.1,local.port=$2,remote.type=inet,remote.host=127.0.0.1,remote.port=$3 \\
  -device virtio-net-pci,netdev=lan,mac=52:54:00:77:00:0$(vm_index "$wr_vm")
EOF
  chmod 0700 "$run/vm-$wr_vm.sh"
}

# Starts both VM runners behind the slot handshake: each takes its slot and
# writes slot-X.held; `go` is written only once both are held, so one VM never
# idles while the other waits for a slot.
start_vms() {
  lan_port_a=$(free_port udp)
  lan_port_b=$(free_port udp)
  while [ "$lan_port_b" = "$lan_port_a" ]; do
    lan_port_b=$(free_port udp)
  done
  vm_ssh_port_a=$(free_port tcp)
  vm_ssh_port_b=$(free_port tcp)
  while [ "$vm_ssh_port_b" = "$vm_ssh_port_a" ]; do
    vm_ssh_port_b=$(free_port tcp)
  done
  : >"$run/known_hosts"
  write_seed a || return 1
  write_seed b || return 1
  write_vm_runner a "$lan_port_a" "$lan_port_b" || return 1
  write_vm_runner b "$lan_port_b" "$lan_port_a" || return 1
  for vm in a b; do
    if [ "$no_slot_wrapper" = 1 ]; then
      /bin/sh "$run/vm-$vm.sh" >"$run/vm-$vm.runner.log" 2>&1 &
    else
      "$slot_wrapper" /bin/sh "$run/vm-$vm.sh" >"$run/vm-$vm.runner.log" 2>&1 &
    fi
    printf '%s\n' "$!" >"$run/wrapper-$vm.pid"
  done
  waited=0
  while [ ! -e "$run/slot-a.held" ] || [ ! -e "$run/slot-b.held" ]; do
    if [ "$waited" -ge "$slot_wait_s" ]; then
      touch "$run/abort"
      inconclude slots_unavailable "both heavy-run slots were not held within ${slot_wait_s}s"
      return 1
    fi
    sleep 1
    waited=$((waited + 1))
  done
  : >"$run/go"
  for vm in a b; do
    waited=0
    until vm_ssh "$vm" true >/dev/null 2>&1; do
      if [ "$waited" -ge "$boot_timeout_s" ]; then
        inconclude provisioning_failed "VM-$vm did not answer SSH within ${boot_timeout_s}s"
        return 1
      fi
      sleep "$poll_s"
      waited=$((waited + poll_s))
    done
  done
}

# prov VM DESCRIPTION COMMAND...: a provisioning command; a failure makes the
# run inconclusive.
prov() {
  prov_vm=$1
  prov_what=$2
  shift 2
  mkdir -p "$state/provision"
  if ! "$@" >>"$state/provision/$prov_vm.log" 2>&1; then
    inconclude provisioning_failed "VM-$prov_vm: $prov_what failed"
    return 1
  fi
}

