wait_cloud_init() {
  vm_ssh "$1" 'sudo cloud-init status --wait' >/dev/null 2>&1 || true
  vm_ssh "$1" 'loginctl show-user ph -p Linger' 2>/dev/null | grep -q 'Linger=yes'
}

provision_headscale() {
  say "Headscale on VM-A"
  prov a "install headscale" vm_install a 0755 /usr/local/bin/headscale <"$cache_dir/headscale-$headscale_version" || return 1
  prov a "create headscale user" vm_ssh a 'sudo id headscale >/dev/null 2>&1 || sudo useradd --system --home-dir /var/lib/headscale --shell /usr/sbin/nologin headscale' || return 1
  render_headscale_config | prov a "write headscale config" vm_install a 0644 /etc/headscale/config.yaml || return 1
  render_headscale_unit | prov a "write headscale unit" vm_install a 0644 /etc/systemd/system/headscale.service || return 1
  prov a "headscale configtest" vm_ssh a 'sudo /usr/local/bin/headscale configtest -c /etc/headscale/config.yaml' || return 1
  prov a "start headscale" vm_ssh a 'sudo systemctl daemon-reload && sudo systemctl enable --now headscale' || return 1
  waited=0
  until vm_ssh a "curl -fsS -m 3 http://127.0.0.1:$headscale_port/health" >/dev/null 2>&1; do
    if [ "$waited" -ge "$service_timeout_s" ]; then
      inconclude provisioning_failed "Headscale did not become healthy"
      return 1
    fi
    sleep "$poll_s"
    waited=$((waited + poll_s))
  done
  prov a "create the lab user" vm_ssh a 'sudo headscale users create ph' || return 1
  prov a "create the issued-keys register" vm_ssh a 'sudo install -m 0600 /dev/null /var/lib/headscale/issued-keys' || return 1
}

# issue_key FROM-VM TO-VM DEST: creates a single-use pre-auth key on VM-A and
# pipes it into DEST on TO-VM. The key never reaches the host disk or output; VM-A
# keeps a copy in issued-keys so the evidence scan can look for it.
issue_key() {
  keys_issued=1
  : >"$state/keys-issued"
  if vm_ssh a "id=\$(sudo headscale users list -o json | python3 -c 'import json,sys; print([u[\"id\"] for u in json.load(sys.stdin) if u[\"name\"] == \"ph\"][0])') && sudo sh -c \"headscale preauthkeys create --user \$id --expiration $key_expiration | tee -a /var/lib/headscale/issued-keys\"" |
    vm_ssh_stdin "$2" "sudo install -d -m 0700 /run/ts && sudo install -m 0600 /dev/stdin $3"; then
    vm_ssh "$2" "sudo test -s $3" || return 1
    return 0
  fi
  return 1
}

# join_tailnet VM: starts tailscaled and brings the node up with a pipe-fed key.
join_tailnet() {
  jt_vm=$1
  jt_node=$(vm_node "$jt_vm")
  for binary in tailscale tailscaled; do
    prov "$jt_vm" "install $binary" vm_install "$jt_vm" 0755 "/usr/local/bin/$binary" <"$cache_dir/tailscale-$tailscale_version/$binary" || return 1
  done
  render_tailscaled_unit | prov "$jt_vm" "write the tailscaled unit" vm_install "$jt_vm" 0644 /etc/systemd/system/tailscaled.service || return 1
  prov "$jt_vm" "start tailscaled" vm_ssh "$jt_vm" 'sudo systemctl daemon-reload && sudo systemctl enable --now tailscaled' || return 1
  if ! issue_key a "$jt_vm" /run/ts/authkey; then
    inconclude provisioning_failed "VM-$jt_vm: the pre-auth key could not be issued"
    return 1
  fi
  prov "$jt_vm" "tailscale up" vm_ssh "$jt_vm" "sudo tailscale up --login-server=http://$lab_net_a:$headscale_port --auth-key=file:/run/ts/authkey --hostname=$jt_node --accept-dns=false --timeout=60s" || return 1
  prov "$jt_vm" "remove the key file" vm_ssh "$jt_vm" 'sudo rm -f /run/ts/authkey' || return 1
}

# install_offline_packages VM: installs the pinned packages in one `dpkg -i`
# (dpkg refuses to configure one with an unmet dependency), restarts the user
# manager, which then listens on dbus.socket, and waits for the bus socket. Any
# failure is a provisioning problem of the guest, not a product result.
install_offline_packages() {
  ds_vm=$1
  prov "$ds_vm" "create the package directory" vm_ssh "$ds_vm" 'rm -rf /tmp/ph1112-debs && mkdir /tmp/ph1112-debs' || return 1
  for fo_entry in $offline_debs; do
    fo_file=${fo_entry%%|*}
    fo_file=${fo_file##*/}
    prov "$ds_vm" "stage $fo_file" vm_ssh_stdin "$ds_vm" "cat >/tmp/ph1112-debs/$fo_file" <"$cache_dir/$fo_file" || return 1
  done
  prov "$ds_vm" "install the offline packages" vm_ssh "$ds_vm" 'sudo dpkg -i /tmp/ph1112-debs/*.deb && rm -rf /tmp/ph1112-debs' || return 1
  # shellcheck disable=SC2016 # the VM expands its own uid
  prov "$ds_vm" "restart the user manager" vm_ssh "$ds_vm" 'sudo systemctl restart "user@$(id -u).service"' || return 1
  ds_waited=0
  # shellcheck disable=SC2016 # the VM expands its own uid
  until vm_ssh "$ds_vm" 'test -S "/run/user/$(id -u)/bus" && systemctl --user is-active dbus.socket' >>"$state/provision/$ds_vm.log" 2>&1; do
    if [ "$ds_waited" -ge "$service_timeout_s" ]; then
      inconclude provisioning_failed "VM-$ds_vm: the user manager's dbus.socket did not become active"
      return 1
    fi
    sleep "$poll_s"
    ds_waited=$((ds_waited + poll_s))
  done
}

# create_d4_project VM: a tiny git repository with one commit under the ph
# user's home, registered as a project; its id is kept for `session new`.
create_d4_project() {
  cp_vm=$1
  prov "$cp_vm" "create the throwaway git repository" vm_ssh "$cp_vm" "rm -rf ~/$d4_repo_dir && git init -q ~/$d4_repo_dir && cd ~/$d4_repo_dir && echo ph1112 >README && git add README && git -c user.name=ph1112 -c user.email=ph1112@lab.invalid commit -q -m init" || return 1
  step pre "project-add-$cp_vm" vm_ssh "$cp_vm" "pohunek project add ~/$d4_repo_dir --name $d4_project_name --json"
  cp_id=
  if [ "$step_rc" -eq 0 ]; then
    cp_id=$(helper json-field "$step_dir/stdout" id 2>/dev/null || true)
  fi
  if [ -z "$cp_id" ]; then
    inconclude provisioning_failed "VM-$cp_vm: the throwaway project could not be registered"
    return 1
  fi
  printf '%s\n' "$cp_id" >"$state/project-id-$cp_vm"
}

# install_pohunek VM: stages the CI binaries, writes overlays.toml and installs
# the daemon as a systemd user service from an SSH login session.
install_pohunek() {
  ip_vm=$1
  prov "$ip_vm" "stage directory" vm_ssh "$ip_vm" 'mkdir -p ~/stage' || return 1
  for binary in pohunek pohunekd pohunek-sessiond; do
    prov "$ip_vm" "stage $binary" vm_ssh_stdin "$ip_vm" "cat >~/stage/$binary && chmod 0755 ~/stage/$binary" <"$run/bins/$binary" || return 1
  done
  prov "$ip_vm" "install the CLI" vm_install "$ip_vm" 0755 /usr/local/bin/pohunek <"$run/bins/pohunek" || return 1
  prov "$ip_vm" "install the probe" vm_install "$ip_vm" 0755 /usr/local/bin/overlay_probe <"$probe" || return 1
  prov "$ip_vm" "write overlays.toml" vm_ssh "$ip_vm" "umask 077 && mkdir -p ~/.config/pohunek && printf 'providers = [\"tailscale\"]\nport = $overlay_port\n' >~/.config/pohunek/overlays.toml && chmod 0600 ~/.config/pohunek/overlays.toml" || return 1
  prov "$ip_vm" "service install" vm_ssh "$ip_vm" 'PATH=/usr/local/bin:/usr/bin:/bin pohunek service install --from ~/stage' || return 1
  waited=0
  until vm_ssh "$ip_vm" 'PATH=/usr/local/bin:/usr/bin:/bin pohunek health --json' >/dev/null 2>&1; do
    [ "$waited" -lt "$service_timeout_s" ] || break
    sleep "$poll_s"
    waited=$((waited + poll_s))
  done
  step pre "service-health-$ip_vm" vm_ssh "$ip_vm" 'PATH=/usr/local/bin:/usr/bin:/bin pohunek health --json'
  [ "$step_rc" -eq 0 ] || return 1
}

