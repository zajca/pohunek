# ---------------------------------------------------------------------------
# Step recording

state=
step_seq=0
step_dir=
step_rc=0

# Sets step_dir to the directory of leg/name, reusing an existing one so a
# polled step keeps its slot.
step_dir_for() {
  leg_dir="$state/steps/$1"
  mkdir -p "$leg_dir"
  step_dir=
  for existing in "$leg_dir"/[0-9][0-9][0-9]-"$2"; do
    if [ -d "$existing" ]; then
      step_dir=$existing
    fi
  done
  if [ -z "$step_dir" ]; then
    step_seq=$((step_seq + 1))
    step_dir="$leg_dir/$(printf '%03d' "$step_seq")-$2"
    mkdir -p "$step_dir"
  fi
}

# step LEG NAME COMMAND...: runs the command, records argv, rc and both output
# streams, and sets step_rc and step_dir. It never fails the script.
step() {
  step_dir_for "$1" "$2"
  shift 2
  printf '%s\n' "$*" >"$step_dir/argv"
  now >"$step_dir/at"
  if "$@" >"$step_dir/stdout" 2>"$step_dir/stderr" </dev/null; then
    step_rc=0
  else
    step_rc=$?
  fi
  printf '%s\n' "$step_rc" >"$step_dir/rc"
}

# note_step LEG NAME RC ARGV-TEXT [STDOUT-TEXT]: records a step whose command
# ran elsewhere (a pipeline that carries a secret, a remote capture).
note_step() {
  step_dir_for "$1" "$2"
  printf '%s\n' "$4" >"$step_dir/argv"
  now >"$step_dir/at"
  printf '%s\n' "${5:-}" >"$step_dir/stdout"
  : >"$step_dir/stderr"
  printf '%s\n' "$3" >"$step_dir/rc"
  step_rc=$3
}

inconclude() {
  helper inconclude "$state" "$1" "$2" || true
}

# ---------------------------------------------------------------------------
# Process safety: only processes of this run are signalled, by exact PID.

# pid_matches PID NEEDLE: the live process's command line contains NEEDLE.
pid_matches() {
  [ -r "/proc/$1/cmdline" ] || return 1
  tr '\0' ' ' <"/proc/$1/cmdline" | grep -F -q -- "$2"
}

# kill_exact PID NEEDLE: stops PID only while its command line names NEEDLE.
kill_exact() {
  kill_pid=$1
  kill_needle=$2
  pid_matches "$kill_pid" "$kill_needle" || return 0
  kill "$kill_pid" 2>/dev/null || true
  kill_waited=0
  while [ "$kill_waited" -lt 10 ] && pid_matches "$kill_pid" "$kill_needle"; do
    sleep 1
    kill_waited=$((kill_waited + 1))
  done
  if pid_matches "$kill_pid" "$kill_needle"; then
    kill -KILL "$kill_pid" 2>/dev/null || true
  fi
}

# Stops every process whose command line runs a binary of the throwaway NetBird
# root. Each PID is read from /proc and re-verified before it is signalled.
kill_throwaway_daemon() {
  for entry in /proc/[0-9]*; do
    ktd_pid=${entry#/proc/}
    ktd_exe=$(readlink "/proc/$ktd_pid/exe" 2>/dev/null || true)
    case $ktd_exe in
      "$netbird_root/bin/"*) kill_exact "$ktd_pid" "$netbird_root/bin/" ;;
    esac
  done
}

