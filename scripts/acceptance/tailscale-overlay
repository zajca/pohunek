}

# vm_ssh VM COMMAND: runs COMMAND in the VM as user ph, without stdin.
vm_ssh() {
  vm_name=$1
  shift
  # shellcheck disable=SC2046 # the option string is split into words on purpose
  ssh $(ssh_options) -n -p "$(vm_port "$vm_name")" ph@127.0.0.1 "$@"
}

# vm_ssh_stdin VM COMMAND: like vm_ssh but forwards stdin.
vm_ssh_stdin() {
  vm_name=$1
  shift
  # shellcheck disable=SC2046 # the option string is split into words on purpose
  ssh $(ssh_options) -p "$(vm_port "$vm_name")" ph@127.0.0.1 "$@"
}

# vm_install VM MODE DEST: installs stdin as DEST with MODE, as root.
vm_install() {
  vm_ssh_stdin "$1" "sudo install -D -m $2 /dev/stdin $3"
}

# monitor VM COMMAND: sends one HMP command to the VM's monitor socket.
monitor() {
  printf '%s\n' "$2" | socat -T3 - "UNIX-CONNECT:$run/vm-$1.mon"
}

teardown() {
  if [ "$teardown_done" = 1 ]; then
    return 0
  fi
  teardown_done=1
  say "teardown"
  if [ "$window_open" = 1 ] && [ -S "$run/vm-a.mon" ]; then
    monitor a "hostfwd_remove wan tcp:$netbird_address:$hostfwd_port" >/dev/null 2>&1 || true
    window_open=0
  fi
  if [ "$mac_started" = 1 ]; then
    mac_cleanup || true
  fi
  if [ "$netbird_root_created" = 1 ]; then
    kill_throwaway_daemon
    rm -rf "$netbird_root"
    netbird_root_created=0
  fi
  if [ -n "$run" ] && [ -d "$run" ]; then
    collect_diagnostics || true
    for vm in a b; do
      if [ -S "$run/vm-$vm.mon" ]; then
        monitor "$vm" quit >/dev/null 2>&1 || true
      fi
    done
    touch "$run/abort"
    for vm in a b; do
      teardown_wait "$vm"
    done
    for wrapper in "$run"/wrapper-*.pid; do
      if [ -f "$wrapper" ]; then
        kill_exact "$(cat "$wrapper")" "$run/vm-"
      fi
    done
    leftovers=0
    for entry in /proc/[0-9]*; do
      pid=${entry#/proc/}
      if pid_matches "$pid" "$run/"; then
        printf 'tailscale-overlay: process %s of this run is still alive\n' "$pid" >&2
        leftovers=$((leftovers + 1))
      fi
    done
    case $run in
      "$run_root"/ph1112-run-*) rm -rf "$run" ;;
      *) printf 'tailscale-overlay: refusing to delete %s\n' "$run" >&2 ;;
    esac
    printf 'teardown complete; %s run process(es) left\n' "$leftovers"
  fi
}

# teardown_wait VM: waits for the VM's qemu to exit, then stops it by exact PID.
teardown_wait() {
  pidfile="$run/vm-$1.pid"
  [ -f "$pidfile" ] || return 0
  qemu_pid=$(cat "$pidfile")
  tw_waited=0
  while [ "$tw_waited" -lt 15 ] && pid_matches "$qemu_pid" "$run/"; do
    sleep 1
    tw_waited=$((tw_waited + 1))
  done
  kill_exact "$qemu_pid" "$run/"
}

on_exit() {
  exit_rc=$?
  trap - EXIT INT TERM
  set +e
  teardown || true
  exit "$exit_rc"
}

on_signal() {
  if [ -n "$state" ]; then
    inconclude interrupted "run stopped by a signal"
  fi
  exit 130
}

# Journals and doctor reports of the VMs, kept in the state directory so a
# failed run can be diagnosed after the VMs are gone. They pass the same
# secret scan as the evidence.
collect_diagnostics() {
  [ -n "$state" ] || return 0
  [ "$diagnostics_done" = 0 ] || return 0
  diagnostics_done=1
  mkdir -p "$state/diagnostics"
  for vm in a b; do
    [ -S "$run/vm-$vm.mon" ] || continue
    vm_ssh "$vm" 'sudo journalctl -u tailscaled --no-pager -n 200' >"$state/diagnostics/tailscaled-$vm.log" 2>&1 || true
    vm_ssh "$vm" 'journalctl --user --no-pager -n 200' >"$state/diagnostics/pohunek-$vm.log" 2>&1 || true
    vm_ssh "$vm" 'PATH=/usr/local/bin:/usr/bin:/bin pohunek doctor --json' >"$state/diagnostics/doctor-$vm.json" 2>&1 || true
  done
  if [ -S "$run/vm-a.mon" ]; then
    vm_ssh a 'sudo journalctl -u headscale --no-pager -n 200' >"$state/diagnostics/headscale.log" 2>&1 || true
  fi
  helper scan "$state/diagnostics" --delete >/dev/null 2>&1 || true
}

# ---------------------------------------------------------------------------
# Pinned downloads

# fetch_pinned URL DEST ALGORITHM EXPECTED [FALLBACK]: reuses a cached file that
# matches, otherwise downloads and verifies it. FALLBACK is tried only when the
# download from URL fails, never after a wrong checksum: bytes that do not match
# the pin are inconclusive (checksum_mismatch) whichever source served them.
fetch_pinned() {
  fp_url=$1
  fp_dest=$2
  fp_algo=$3
  fp_expected=$4
  fp_fallback=${5:-}
  if [ -f "$fp_dest" ] && [ "$("${fp_algo}sum" <"$fp_dest" | awk '{print $1}')" = "$fp_expected" ]; then
    return 0
  fi
  fp_got=0
  for fp_try in "$fp_url" $fp_fallback; do
    rm -f "$fp_dest.part"
    if curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 --max-time 1800 --output "$fp_dest.part" "$fp_try"; then
      fp_got=1
      break
    fi
  done
  if [ "$fp_got" = 0 ]; then
    inconclude artifact_missing "download of $fp_url failed${fp_fallback:+, and of the fallback $fp_fallback}"
    return 1
  fi
  if [ "$("${fp_algo}sum" <"$fp_dest.part" | awk '{print $1}')" != "$fp_expected" ]; then
    rm -f "$fp_dest.part"
    inconclude checksum_mismatch "$fp_try does not match its pinned $fp_algo"
    return 1
  fi
  mv "$fp_dest.part" "$fp_dest"
}

# Downloads and verifies everything the VMs need, extracting the Tailscale
# tarball into the cache.
prepare_cache() {
  mkdir -p "$cache_dir"
  chmod 0700 "$cache_dir"
  fetch_pinned "$debian_image_url" "$cache_dir/debian-$debian_image_version.qcow2" sha512 "$debian_image_sha512" || return 1
  fetch_pinned "$headscale_url" "$cache_dir/headscale-$headscale_version" sha256 "$headscale_sha256" || return 1
  fetch_pinned "$tailscale_url" "$cache_dir/tailscale-$tailscale_version.tgz" sha256 "$tailscale_sha256" || return 1
  for fo_entry in $offline_debs; do
    fo_path=${fo_entry%%|*}
    fetch_pinned "$offline_deb_snapshot_base/$fo_path" "$cache_dir/${fo_path##*/}" sha256 "${fo_entry##*|}" "$offline_deb_fallback_base/$fo_path" || return 1
  done
  rm -rf "$cache_dir/tailscale-$tailscale_version"
  mkdir -p "$cache_dir/tailscale-$tailscale_version"
  tar -xzf "$cache_dir/tailscale-$tailscale_version.tgz" --strip-components=1 -C "$cache_dir/tailscale-$tailscale_version" || {
    inconclude artifact_unusable "the Tailscale tarball could not be extracted"
    return 1
  }
  for binary in tailscale tailscaled; do
    [ -x "$cache_dir/tailscale-$tailscale_version/$binary" ] || {
      inconclude artifact_missing "the Tailscale tarball holds no $binary"
      return 1
    }
  done
}

# Takes the pohunek binaries from the CI artifact (or --bins-dir), records their
# checksums and refuses binaries that need a newer glibc than the guests have.
prepare_binaries() {
  mkdir -p "$run/bins"
  if [ -n "$ci_run" ]; then
    if ! gh run download "$ci_run" --repo "$repo" --name pohunek-bins --dir "$run/download" >/dev/null 2>"$run/download.err"; then
      inconclude artifact_missing "gh run download $ci_run (pohunek-bins) failed"
      return 1
    fi
    source_dir="$run/download"
    helper set-meta "$state" "ci_run=$ci_run" "ci_head_sha=$(gh run view "$ci_run" --repo "$repo" --json headSha --jq .headSha 2>/dev/null || printf unknown)"
  else
    source_dir=$bins_dir
  fi
  for binary in pohunek pohunekd pohunek-sessiond; do
    found=$(find "$source_dir" -type f -name "$binary" | head -n 2)
    if [ -z "$found" ] || [ "$(printf '%s\n' "$found" | wc -l)" -ne 1 ]; then
      inconclude artifact_missing "expected exactly one $binary under $source_dir"
      return 1
    fi
    install -m 0755 "$found" "$run/bins/$binary" || {
      inconclude artifact_missing "$binary could not be staged"
      return 1
    }
    helper set-meta "$state" "bin_sha256_$binary=$(sha256sum <"$run/bins/$binary" | awk '{print $1}')"
    if ! objdump -T "$run/bins/$binary" >"$run/objdump-$binary.txt" 2>/dev/null; then
      inconclude artifact_unusable "$binary has no dynamic symbol table to check against glibc $guest_glibc_max"
      return 1
    fi
    if ! helper glibc-check "$guest_glibc_max" <"$run/objdump-$binary.txt" >/dev/null; then
      inconclude artifact_unusable "$binary needs glibc newer than $guest_glibc_max"
      return 1
    fi
  done
}

