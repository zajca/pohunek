#!/bin/sh
# Acceptance check for issue #102: pohunek-gui started the way Finder starts an
# app, next to a real daemon and session worker, on macOS.
#
# Verified here (no app bundle needed):
#   1. The real pohunek-gui binary starts from a Finder-like environment
#      (`env -i`, HOME/USER/LOGNAME only, PATH=/usr/bin:/bin:/usr/sbin:/sbin)
#      with an isolated config, runtime, and state directory, and stays running
#      for a bounded interval without exiting.
#   2. Ending the GUI (SIGTERM) leaves the daemon, the session worker, and the
#      session's child process untouched: same PIDs and process start times
#      before and after, and the session is still live.
#
# NOT verified here:
#   - the attach launchers (no session-row click can be driven headlessly, and
#     no real Terminal.app is started); they are covered by the pohunek-gui unit
#     tests that CI runs on macOS;
#   - double-clicking an app icon in Finder, a Dock launch, and the Terminal.app
#     window itself, which need the .app bundle from issue #104.
#
# The GUI needs a window server. Outside a GUI (Aqua) login session, for example
# over SSH or in a service session, the script exits 2, prints the manual Finder
# procedure, and never reports success without starting the GUI.
#
# Environment (all optional unless stated):
#   GUI_ACCEPT_BIN_DIR   Directory holding pohunek, pohunekd, pohunek-sessiond,
#                        and pohunek-gui (required).
#   GUI_ACCEPT_UP_S      Seconds the GUI must stay up (default 8).
#   GUI_ACCEPT_KEEP      Set to `yes` to keep the work directory as evidence.
#   GUI_ACCEPT_PYTHON    Python 3 for JSON parsing (default /usr/bin/python3).
#
# Exit status: 0 all checks passed, 1 a check failed, 2 the environment cannot
# run the check (no macOS, no window server).

set -eu
# Every file and directory the run creates is owner-only; the daemon and its
# workers refuse application directories with any other mode.
umask 077

script_dir=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)
helper="$script_dir/launchd_lifetime_evidence.py"

# Seconds the GUI must survive; long enough for window creation and the first
# connection attempts, short enough for CI.
up_s=${GUI_ACCEPT_UP_S:-8}
# Upper bound on the wait for the daemon and for the session to become live.
daemon_timeout_s=60
live_timeout_s=60
# Upper bound on the wait for a process to exit after a signal.
exit_timeout_s=15
poll_s=1
# Most lines of each evidence log printed when the run fails.
log_tail_lines=200
# Longest accepted daemon socket path; the Darwin sockaddr_un limit is 103.
socket_path_max=100
# The minimal PATH launchd gives a Finder-launched app.
finder_path=/usr/bin:/bin:/usr/sbin:/sbin
python_bin=${GUI_ACCEPT_PYTHON:-/usr/bin/python3}
# Upper bounds, in poll steps, on the wait for a process to exit after SIGTERM
# and after the SIGKILL fallback. pohunekd finishes in-flight work on SIGTERM.
term_wait_s=${GUI_ACCEPT_TERM_WAIT_S:-15}
kill_wait_s=${GUI_ACCEPT_KILL_WAIT_S:-5}
# Upper bound on the wait for a background launch to become the named binary.
exec_timeout_s=10

work=
daemon_pid=
gui_pid=
escalated=no
sweep_failures=
session_id=
worker_pids=
child_pid=
child_name=

say() {
  printf '\n==> %s\n' "$*"
}

die() {
  printf 'macos-gui-launch: FAIL: %s\n' "$*" >&2
  exit 1
}

manual_steps() {
  cat >&2 <<EOF

Manual Finder procedure (steps 3 and 5 need the .app bundle from issue #104):
  1. Log in at the Mac's GUI and run: pohunek service install
     Confirm with: pohunek service status
  2. Create ~/.config/pohunek/gui.toml with, for example:
       pohunek_bin = "pohunek"
       attach_terminal = "terminal-app"
  3. Double-click the pohunek-gui app in Finder (bundle only). Without the
     bundle, run: open -a Terminal <path-to>/pohunek-gui   or start the binary
     from Finder's "Open With > Terminal".
  4. Confirm the window opens, the local host appears, and no configuration
     error is shown in the status line.
  5. Start a session, click Open, and confirm Terminal.app opens attached to it.
  6. Quit the GUI (Command-Q) and confirm the session keeps running:
       pohunek session list
EOF
}

# Prints the tail of one evidence log to stderr. The daemon and GUI logs hold
# tracing lines and error text only: the daemon reads its environment through
# an allowlist and never logs values.
dump_log() {
  [ -f "$1" ] || return 0
  printf '\n----- %s (last %s lines) -----\n' "$1" "$log_tail_lines" >&2
  tail -n "$log_tail_lines" "$1" >&2 || true
}

dump_evidence() {
  [ -n "$work" ] && [ -d "$work" ] || return 0
  printf '\nmacos-gui-launch: evidence logs follow\n' >&2
  dump_log "$work/ev/daemon.log"
  dump_log "$work/ev/gui.err"
  dump_log "$work/ev/gui.out"
  for file in "$work"/ev/*.json "$work"/ev/*.txt; do
    dump_log "$file"
  done
  find "$work/state" -type f \( -name '*.jsonl' -o -name '*.log' \) 2>/dev/null |
    while IFS= read -r file; do dump_log "$file"; done
}

# Whether process $1 is gone: absent from the process table or a zombie
# (an exited background job stays a zombie until it is waited for).
process_gone() {
  state=$(ps -o stat= -p "$1" 2>/dev/null || true)
  case "$state" in '' | Z*) return 0 ;; *) return 1 ;; esac
}

# Waits up to $2 poll steps for process $1 to be gone.
wait_gone() {
  waited=0
  while ! process_gone "$1"; do
    [ "$waited" -lt "$2" ] || return 1
    sleep "$poll_s"
    waited=$((waited + 1))
  done
  return 0
}

# Ends process $1, which must be running the binary named $2, and waits for it.
# The name is checked before every signal, so a pid that has been reused by
# another program is never signalled (it counts as gone: the original exited).
# SIGTERM first, polled for term_wait_s steps; SIGKILL as the last resort,
# reported on stderr. Returns 1 only when the process is still running.
terminate_and_wait() {
  tw_pid=$1
  tw_name=$2
  process_gone "$tw_pid" && return 0
  current=$(ps -o comm= -p "$tw_pid" 2>/dev/null || true)
  if [ "${current##*/}" != "$tw_name" ]; then
    printf 'warning: pid %s is now "%s", not %s; not signalling it\n' "$tw_pid" "${current##*/}" "$tw_name" >&2
    return 0
  fi
  kill -TERM "$tw_pid" 2>/dev/null || true
  wait_gone "$tw_pid" "$term_wait_s" && return 0
  current=$(ps -o comm= -p "$tw_pid" 2>/dev/null || true)
  [ "${current##*/}" = "$tw_name" ] || return 0
  escalated=yes
  printf 'warning: %s (pid %s) ignored SIGTERM for %ss; sending SIGKILL\n' "$tw_name" "$tw_pid" "$term_wait_s" >&2
  kill -KILL "$tw_pid" 2>/dev/null || true
  wait_gone "$tw_pid" "$kill_wait_s" && return 0
  printf 'warning: %s (pid %s) is still running after SIGKILL\n' "$tw_name" "$tw_pid" >&2
  return 1
}

# Names of the programs a run starts; discovery and the descendant sweep only
# ever signal a process whose command name is one of these (or a descendant of
# one, signalled under its own verified name).
run_process_names='pohunekd pohunek-sessiond pohunek-gui pohunek'

# Prints `pid name` for every process of this run: a process of ours whose
# environment or command line carries the isolated work directory (the
# runtime, state, and socket paths are all below it). `ps e` appends the
# environment, which is where the daemon and worker carry XDG_RUNTIME_DIR.
# The name is the basename of the command name and is checked again before any
# signal.
discover_run_processes() {
  ps -axeww -o pid=,comm=,command= 2>/dev/null |
    awk -v prefix="$work/" -v names="$run_process_names" -v self="$$" '
      BEGIN { count = split(names, list, " "); for (i = 1; i <= count; i++) allowed[list[i]] = 1 }
      index($0, prefix) > 0 && $1 != self {
        name = $2
        sub(".*/", "", name)
        if (name in allowed) print $1, name
      }'
}

# Prints `pid name` for every descendant of process $1.
descendant_lines() {
  ps -axo pid=,ppid=,comm= 2>/dev/null |
    awk -v root="$1" '
      { pid[NR] = $1; parent[NR] = $2; comm[NR] = $3; total = NR }
      END {
        keep[root] = 1
        changed = 1
        while (changed) {
          changed = 0
          for (i = 1; i <= total; i++) {
            if (!(pid[i] in keep) && (parent[i] in keep)) {
              keep[pid[i]] = 1
              changed = 1
              name = comm[i]
              sub(".*/", "", name)
              print pid[i], name
            }
          }
        }
      }'
}

# Ends every process of this run that is still alive, found from the work
# directory rather than from recorded pids, so a run that failed before it
# recorded anything leaves nothing behind. Sets `leftover=yes` when a process
# cannot be confirmed gone.
sweep_run_processes() {
  # An empty work directory would make the match prefix `/` select everything.
  [ -n "$work" ] && [ -d "$work" ] || return 0
  found=$(discover_run_processes || true)
  [ -n "$found" ] || return 0
  # Descendants come first in the list, so each is signalled before its parent.
  everything=
  while read -r sweep_pid sweep_name; do
    [ -n "$sweep_pid" ] || continue
    everything="$everything
$(descendant_lines "$sweep_pid" || true)"
  done <<SWEEP
$found
SWEEP
  everything="$everything
$found"
  sweep_failures=$(mktemp "${TMPDIR:-/tmp}/pgl-sweep.XXXXXX")
  printf '%s\n' "$everything" | awk 'NF == 2 && !seen[$1]++ { print }' |
    while read -r sweep_pid sweep_name; do
      terminate_and_wait "$sweep_pid" "$sweep_name" || echo "$sweep_pid" >>"$sweep_failures"
    done
  [ ! -s "$sweep_failures" ] || leftover=yes
  rm -f -- "$sweep_failures"
}

cleanup() {
  status=$?
  trap - EXIT
  [ "$status" -eq 0 ] || dump_evidence
  leftover=no
  [ -z "$gui_pid" ] || terminate_and_wait "$gui_pid" pohunek-gui || leftover=yes
  # Stop the session before the daemon so no worker or shell outlives the run
  # with a deleted runtime directory. Best effort: the daemon may be gone.
  if [ -n "$session_id" ] && [ -n "$daemon_pid" ] && [ -n "$work" ] && [ -d "$work" ]; then
    finder_env "$bin_dir/pohunek" session stop "$session_id" >/dev/null 2>&1 ||
      printf 'warning: could not stop session %s\n' "$session_id" >&2
  fi
  [ -z "$daemon_pid" ] || terminate_and_wait "$daemon_pid" pohunekd || leftover=yes
  # Whatever the session stop and the daemon left behind.
  for pid in $worker_pids; do
    terminate_and_wait "$pid" pohunek-sessiond || leftover=yes
  done
  [ -z "$child_pid" ] || [ -z "$child_name" ] ||
    terminate_and_wait "$child_pid" "$child_name" || leftover=yes
  sweep_run_processes
  if [ "$leftover" = yes ] && [ "$status" -eq 0 ]; then
    # A run that left a process behind is not a pass.
    status=1
  fi
  if [ -n "$work" ] && [ -d "$work" ]; then
    if [ "$leftover" = yes ]; then
      printf 'macos-gui-launch: a process could not be ended; keeping %s\n' "$work" >&2
    elif [ "${GUI_ACCEPT_KEEP:-no}" = yes ]; then
      printf 'Evidence kept in %s\n' "$work"
    else
      rm -rf -- "$work"
    fi
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

[ "$(uname -s)" = Darwin ] || {
  printf 'macos-gui-launch: this check runs on macOS only\n' >&2
  manual_steps
  exit 2
}

bin_dir=${GUI_ACCEPT_BIN_DIR:-}
[ -n "$bin_dir" ] || die "GUI_ACCEPT_BIN_DIR is required (directory with the pohunek binaries)"
for name in pohunek pohunekd pohunek-sessiond pohunek-gui; do
  [ -x "$bin_dir/$name" ] || die "$bin_dir/$name is not an executable file"
done
[ -x "$python_bin" ] || die "$python_bin is required for JSON parsing"
case "$up_s" in '' | *[!0-9]*) die "GUI_ACCEPT_UP_S must be a number" ;; esac
[ "$up_s" -ge 1 ] || die "GUI_ACCEPT_UP_S must be at least 1"

# A GUI (Aqua) launchd session is what gives an app a window server.
manager=$(/bin/launchctl managername 2>/dev/null || printf unknown)
if [ "$manager" != Aqua ]; then
  printf 'macos-gui-launch: no window server: launchd session is "%s", not "Aqua".\n' "$manager" >&2
  printf 'Run this from a Terminal window in a logged-in GUI session.\n' >&2
  manual_steps
  exit 2
fi

user=$(id -un)
# Unix socket paths are limited to 103 bytes on macOS: keep the root short.
work=$(mktemp -d /tmp/pgl.XXXXXX)
chmod 700 "$work"
# /tmp is a symlink to /private/tmp on macOS, and the daemon opens every path
# component without following symlinks, so the root must be the physical path.
work=$(CDPATH='' cd -- "$work" && pwd -P)
socket_path="$work/run/pohunek/daemon.sock"
[ "${#socket_path}" -le "$socket_path_max" ] ||
  die "socket path is ${#socket_path} bytes, over the $socket_path_max byte limit: $socket_path"
home="$work/h"
# Every directory pohunek will use exists up front with mode 0700: the
# application directory below each XDG base, the runtime directory, and the
# parents. The daemon and workers require exactly 0700 for application
# directories and no group or other write access on ancestors.
for dir in "$home" "$home/.config" "$home/.config/pohunek" \
  "$work/run" "$work/run/pohunek" "$work/state" "$work/state/pohunek" \
  "$work/data" "$work/data/pohunek" "$work/cache" "$work/cache/pohunek" \
  "$work/ev"; do
  mkdir -p "$dir"
  chmod 700 "$dir"
  dir_mode=$(stat -c '%a' "$dir" 2>/dev/null || stat -f '%Lp' "$dir")
  [ "$dir_mode" = 700 ] || die "directory $dir has mode $dir_mode, expected 700"
done

# Runs one command with the Finder-like environment. The XDG variables are the
# single deviation from a real Finder launch: they isolate the run from the
# operator's own pohunek installation.
finder_env() {
  env -i \
    HOME="$home" USER="$user" LOGNAME="$user" PATH="$finder_path" \
    XDG_CONFIG_HOME="$home/.config" XDG_RUNTIME_DIR="$work/run" \
    XDG_STATE_HOME="$work/state" XDG_DATA_HOME="$work/data" \
    XDG_CACHE_HOME="$work/cache" "$@"
}

# Starts a long-running process as a background job and records its pid in
# `started_pid`. The command runs in a subshell that `exec`s `env`, which
# `exec`s the binary, so `$!` is the pid of the real process and not of a
# wrapper subshell that a later `kill` would hit instead. Use it only for
# background launches; foreground calls use finder_env.
#   usage: start_background OUTPUT_FILE ERROR_FILE COMMAND [ARG...]
start_background() {
  bg_out=$1
  bg_err=$2
  shift 2
  (
    exec env -i \
      HOME="$home" USER="$user" LOGNAME="$user" PATH="$finder_path" \
      XDG_CONFIG_HOME="$home/.config" XDG_RUNTIME_DIR="$work/run" \
      XDG_STATE_HOME="$work/state" XDG_DATA_HOME="$work/data" \
      XDG_CACHE_HOME="$work/cache" "$@" >>"$bg_out" 2>>"$bg_err"
  ) &
  started_pid=$!
}

# Fails unless process $1 is running the binary named $2 (after the exec
# chain settles); a recorded pid that names anything else would make every
# later kill and identity check meaningless.
expect_process_name() {
  waited=0
  while :; do
    name=$(ps -o comm= -p "$1" 2>/dev/null || true)
    [ "${name##*/}" = "$2" ] && return 0
    [ "$waited" -lt "$exec_timeout_s" ] ||
      die "pid $1 is running '${name:-nothing}', not $2"
    sleep "$poll_s"
    waited=$((waited + poll_s))
  done
}

# Startup parses this file; a configuration error would only show in the UI.
cat >"$home/.config/pohunek/gui.toml" <<TOML
pohunek_bin = "$bin_dir/pohunek"
attach_terminal = "terminal-app"
TOML

say "Starting an isolated daemon (subprocess workers)"
printf 'command: %s daemon start --dev-subprocess (pohunekd is exec'"'"'d beside it)\n' "$bin_dir/pohunek"
printf 'environment names: HOME USER LOGNAME PATH XDG_CONFIG_HOME XDG_RUNTIME_DIR XDG_STATE_HOME XDG_DATA_HOME XDG_CACHE_HOME (POHUNEK_WORKER_LAUNCHER is set by the CLI)\n'
printf 'runtime dir: %s (mode %s)\n' "$work/run" "$(stat -c '%a' "$work/run" 2>/dev/null || stat -f '%Lp' "$work/run")"
start_background "$work/ev/daemon.log" "$work/ev/daemon.log" "$bin_dir/pohunek" daemon start --dev-subprocess
daemon_pid=$started_pid
expect_process_name "$daemon_pid" pohunekd
waited=0
until finder_env "$bin_dir/pohunek" health --json >/dev/null 2>&1; do
  kill -0 "$daemon_pid" 2>/dev/null || die "the daemon exited early; see $work/ev/daemon.log"
  [ "$waited" -lt "$daemon_timeout_s" ] || die "the daemon did not answer within ${daemon_timeout_s}s"
  sleep "$poll_s"
  waited=$((waited + poll_s))
done

say "Starting a real shell session"
finder_env "$bin_dir/pohunek" session new --agent shell --cwd "$home" --json >"$work/ev/new.json"
session_id=$("$python_bin" "$helper" session-id "$work/ev/new.json")
[ -n "$session_id" ] || die "no session id in the session new result"
waited=0
while :; do
  finder_env "$bin_dir/pohunek" session list --json >"$work/ev/list-live.json"
  state=$("$python_bin" "$helper" states "$work/ev/list-live.json" "$session_id" | awk '{ print $2 }')
  [ "$state" = live ] && break
  [ "$waited" -lt "$live_timeout_s" ] || die "session $session_id is '$state' after ${live_timeout_s}s"
  sleep "$poll_s"
  waited=$((waited + poll_s))
done

# Identity of the worker and the session child: pid plus process start time, so
# a recycled pid cannot pass as the same process.
identity() {
  finder_env "$bin_dir/pohunek" session list --json >"$1.list.json"
  child_pid=$("$python_bin" - "$1.list.json" "$session_id" <<'EOF'
import json, sys
payload = json.load(open(sys.argv[1]))["ok"]
for entry in payload:
    if entry.get("id") == sys.argv[2]:
        print(entry.get("pid") or "")
EOF
)
  [ -n "$child_pid" ] || die "the session list has no child pid for $session_id"
  worker_lines=$(ps -axww -o pid=,lstart=,command= | grep "pohunek-sessiond" | grep -F -- "$session_id" | grep -v grep || true)
  [ -n "$worker_lines" ] || die "no pohunek-sessiond process for $session_id"
  worker_pids=$(printf '%s\n' "$worker_lines" | awk '{ print $1 }')
  child_name=$(ps -o comm= -p "$child_pid" 2>/dev/null || true)
  child_name=${child_name##*/}
  child_line=$(ps -o pid=,lstart=,command= -p "$child_pid" || true)
  [ -n "$child_line" ] || die "session child $child_pid is not running"
  daemon_line=$(ps -o pid=,lstart= -p "$daemon_pid" || true)
  [ -n "$daemon_line" ] || die "the daemon is not running"
  {
    printf 'daemon: %s\n' "$daemon_line"
    printf 'worker: %s\n' "$worker_lines"
    printf 'child: %s\n' "$child_line"
  } >"$1"
}
identity "$work/ev/before.txt"
say "Identity before the GUI starts"
cat "$work/ev/before.txt"

say "Starting pohunek-gui with a Finder-like environment"
start_background "$work/ev/gui.out" "$work/ev/gui.err" "$bin_dir/pohunek-gui"
gui_pid=$started_pid
expect_process_name "$gui_pid" pohunek-gui
elapsed=0
while [ "$elapsed" -lt "$up_s" ]; do
  kill -0 "$gui_pid" 2>/dev/null || {
    cat "$work/ev/gui.err" >&2 || true
    manual_steps
    die "pohunek-gui exited within ${elapsed}s of starting (no window server, or a startup error)"
  }
  sleep "$poll_s"
  elapsed=$((elapsed + poll_s))
done
kill -0 "$gui_pid" 2>/dev/null || die "pohunek-gui is not running after ${up_s}s"
# A GUI toolkit may print harmless diagnostics; only a panic or a fatal error
# counts as a startup failure (an exit is caught above).
if [ -s "$work/ev/gui.err" ]; then
  printf 'note: pohunek-gui wrote to stderr while starting:\n' >&2
  tail -n 20 "$work/ev/gui.err" >&2
  if grep -qiE 'panicked at|fatal' "$work/ev/gui.err"; then
    die "pohunek-gui reported a panic or fatal error while starting"
  fi
fi
printf 'pohunek-gui pid %s stayed up for %ss\n' "$gui_pid" "$up_s"

say "Ending the GUI with SIGTERM"
terminate_and_wait "$gui_pid" pohunek-gui || die "pohunek-gui did not exit after SIGTERM and SIGKILL"
[ "$escalated" = no ] || die "pohunek-gui ignored SIGTERM and had to be killed"
gui_pid=

say "Identity after the GUI exited"
identity "$work/ev/after.txt"
cat "$work/ev/after.txt"
cmp -s "$work/ev/before.txt" "$work/ev/after.txt" ||
  die "daemon, worker, or session child changed while the GUI ran; diff $work/ev/before.txt $work/ev/after.txt"
finder_env "$bin_dir/pohunek" session list --json >"$work/ev/list-after.json"
state=$("$python_bin" "$helper" states "$work/ev/list-after.json" "$session_id" | awk '{ print $2 }')
[ "$state" = live ] || die "session $session_id is '$state' after the GUI exited"
printf 'worker and child unchanged; session %s still live\n' "$session_id"

printf '\nmacos-gui-launch: all checks passed\n'
printf 'Not verified here: the attach launchers, a session-row click, and Terminal.app (unit tests, or the .app bundle from issue #104).\n'
