class RowsError(Exception):
    """A refusal before any row ran, or a guard of one row that cannot run."""


@dataclass
class Result:
    runtime: str
    target: str
    status: str = "not-run"
    seconds: float = 0.0
    guard_seconds: float = 0.0
    messages: list[str] = field(default_factory=list)
    # The account-wide guards that could read their state before and after.
    guards: list[str] = field(default_factory=list)
    # Launchd jobs added during the row whose program is on /System.
    system_jobs: list[str] = field(default_factory=list)
    # Set when the rows after this one cannot run on verified ground.
    stops_job: bool = False

    def document(self) -> dict:
        return {
            "runtime": self.runtime,
            "target": self.target,
            "status": self.status,
            "seconds": round(self.seconds, 3),
            "guard_seconds": round(self.guard_seconds, 3),
            "guards": self.guards,
            "system_jobs": self.system_jobs,
            "message": "; ".join(self.messages),
        }


# ---- inputs ------------------------------------------------------------------


def required(name: str) -> str:
    value = os.environ.get(name, "")
    if not value:
        raise RowsError(f"{name} is required")
    return value


def parse_rows(text: str) -> list[tuple[str, str]]:
    rows = []
    for word in text.split():
        runtime, separator, target = word.partition(":")
        if not separator or not WORD.match(runtime) or not WORD.match(target):
            raise RowsError(f"invalid row: {word!r}")
        rows.append((runtime, target))
    if not rows:
        raise RowsError("ROWS names no row")
    if len(set(rows)) != len(rows):
        raise RowsError("ROWS names a row twice")
    return rows


# ---- bounded commands --------------------------------------------------------


COMMANDS: dict[str, str | None] = {}


def resolve_commands() -> None:
    for name in GUARD_COMMANDS + ROW_COMMANDS:
        found = shutil.which(name)
        COMMANDS[name] = str(Path(found).resolve()) if found else None


def output_of(arguments: list[str], cwd: Path | None = None, env: dict[str, str] | None = None) -> str | None:
    """Standard output of a guard command, run by its resolved path, or None
    when it fails or is absent."""
    command = COMMANDS.get(arguments[0])
    if command is None:
        return None
    try:
        result = subprocess.run(
            [command, *arguments[1:]],
            cwd=cwd,
            env=env,
            stdin=subprocess.DEVNULL,
            capture_output=True,
            timeout=GUARD_COMMAND_SECONDS,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    return result.stdout.decode("utf-8", errors="replace")


# ---- integrity manifest ------------------------------------------------------


def content_id(path: Path) -> str:
    """What a path holds: a regular file by its permission bits and SHA-256, a
    directory by its permission bits, anything else by its kind. Only a regular
    file is opened, so a FIFO cannot block the guard; a file that cannot be read
    is recorded as such and differs from any digest."""
    try:
        status = path.lstat()
    except OSError:
        return "absent"
    if stat.S_ISLNK(status.st_mode):
        return "link:" + os.readlink(path)
    mode = f"{stat.S_IMODE(status.st_mode):04o}"
    if stat.S_ISDIR(status.st_mode):
        return f"dir:{mode}"
    if not stat.S_ISREG(status.st_mode):
        return "special"
    digest = hashlib.sha256()
    try:
        with path.open("rb") as handle:
            for chunk in iter(lambda: handle.read(1 << 20), b""):
                digest.update(chunk)
    except OSError as error:
        return f"unreadable:{error.errno}"
    return f"file:{mode}:{digest.hexdigest()}"


def describe(path: Path) -> dict[str, str]:
    """Every entry below `path` (or `path` itself) as name -> content id.

    `__pycache__` entries are left out: the interpreter writes its own
    bytecode caches into its install when a row's helper programs import a
    module for the first time, and every row starts without them
    (remove_bytecode_caches).
    """
    entries: dict[str, str] = {}

    def record(entry: Path) -> None:
        entries[str(entry)] = content_id(entry)

    record(path)
    # os.path checks report an unreadable path as absent; Path.is_dir() raises
    # on EACCES before Python 3.14.
    if os.path.isdir(path) and not os.path.islink(path):
        for directory, subdirectories, files in os.walk(path):
            subdirectories[:] = [name for name in subdirectories if name != BYTECODE_CACHE]
            for name in sorted(subdirectories) + sorted(files):
                record(Path(directory) / name)
    return entries


def tool_root(name: str) -> Path | None:
    """The install a tool on PATH belongs to, or None when it is absent."""
    found = shutil.which(name)
    if found is None:
        return None
    binary = Path(found).resolve()
    directory = binary.parent
    root = directory.parent if directory.name == "bin" else directory
    return binary if root in SYSTEM_PREFIXES else root


def listing(directory: Path) -> str:
    """The entry names of a directory, bytecode caches left out."""
    try:
        names = sorted(name for name in os.listdir(directory) if name != BYTECODE_CACHE)
    except OSError as error:
        return f"unreadable:{error.errno}"
    return "\0".join(names)


def git(arguments: list[str]) -> str:
    output = output_of(
        ["git", "-c", "core.fsmonitor=false", *arguments], env=dict(os.environ, **GIT_ENVIRONMENT)
    )
    if output is None:
        raise RowsError(f"git {arguments[0]} cannot read the checkout")
    return output


class Checkout:
    """What git lists of the checkout before the first row: its tracked files,
    the directories that hold them, and git's own configuration and refs."""

    def __init__(self, root: Path):
        names = [name for name in git(["ls-files", "-z", "--cached"]).split("\0") if name]
        self.files = [root / name for name in names]
        self.directories = sorted(
            {parent for path in self.files for parent in path.parents if parent.is_relative_to(root)}
        )
        git_dir = Path(git(["rev-parse", "--path-format=absolute", "--git-dir"]).strip())
        common = Path(git(["rev-parse", "--path-format=absolute", "--git-common-dir"]).strip())
        self.metadata = [git_dir / "HEAD", *(common / name for name in ("config", "hooks", "info", "refs", "packed-refs"))]

    def state(self) -> dict[str, str]:
        entries = {str(path): content_id(path) for path in self.files}
        entries.update({f"listing:{directory}": listing(directory) for directory in self.directories})
        for path in self.metadata:
            entries.update(describe(path))
        return entries


def remove_bytecode_caches(roots: list[Path], directories: list[Path]) -> list[str]:
    """Removes every `__pycache__` entry below the roots and directly in the
    directories; returns the entries that are still there."""
    found = [directory / BYTECODE_CACHE for directory in directories]
    for root in roots:
        if os.path.isdir(root) and not os.path.islink(root):
            for directory, subdirectories, files in os.walk(root):
                found += [Path(directory) / name for name in subdirectories + files if name == BYTECODE_CACHE]
                subdirectories[:] = [name for name in subdirectories if name != BYTECODE_CACHE]
    left = []
    for entry in found:
        if os.path.isdir(entry) and not os.path.islink(entry):
            remove_tree(str(entry))
        else:
            try:
                entry.unlink()
            except OSError:
                pass
        if os.path.lexists(entry):
            left.append(str(entry))
    return left


class Manifest:
    """Content ids of everything a later row trusts."""

    def __init__(self, paths: list[Path]):
        self.paths = list(paths)
        self.tools = {name: tool_root(name) for name in TOOLS}
        self.path_directories = [
            Path(directory) for directory in os.environ.get("PATH", "").split(os.pathsep) if os.path.isabs(directory)
        ]
        self.checkout = Checkout(Path.cwd().resolve())
        self.recorded = self.take()

    def remove_bytecode_caches(self) -> list[str]:
        roots = [root for root in self.tools.values() if root is not None]
        return remove_bytecode_caches(roots, self.checkout.directories)

    def take(self) -> dict[str, str]:
        entries = self.checkout.state()
        for path in self.paths:
            entries.update(describe(path))
        for name, root in self.tools.items():
            # Where the tool resolves now, so a tool shadowed through an
            # earlier PATH directory counts as a change of its install.
            found = shutil.which(name)
            entries[f"tool:{name}"] = "absent" if found is None else str(Path(found).resolve())
            if root is not None:
                entries.update(describe(root))
        for directory in self.path_directories:
            entries[f"path:{directory}"] = listing(directory)
        for name in GUARD_COMMANDS + ROW_COMMANDS:
            found = shutil.which(name)
            if found is None:
                entries[f"command:{name}"] = "absent"
            else:
                resolved = Path(found).resolve()
                entries[f"command:{name}"] = f"{resolved}:{content_id(resolved)}"
        return entries

    def add(self, path: Path) -> None:
        self.paths.append(path)
        self.recorded.update(describe(path))

    def changes(self) -> list[str]:
        now = self.take()
        changed = sorted(
            name for name in set(self.recorded) | set(now) if self.recorded.get(name) != now.get(name)
        )
        return changed


# ---- processes left behind ---------------------------------------------------


def under(value: bytes | str, scopes: list[str]) -> bool:
    text = value.decode("utf-8", errors="replace") if isinstance(value, bytes) else value
    for part in text.split(os.pathsep):
        for scope in scopes:
            if part == scope or part.startswith(scope + "/"):
                return True
    return False


def variable_name(entry: bytes) -> str | None:
    name, separator, _value = entry.partition(b"=")
    if not separator or not re.fullmatch(rb"[A-Za-z_][A-Za-z0-9_]*", name):
        return None
    return name.decode("ascii")


def matched_variable(environment: list[bytes], scopes: list[str]) -> str | None:
    """Name of the first variable whose value points into a scope."""
    for entry in environment:
        name = variable_name(entry)
        if name is not None and under(entry.partition(b"=")[2], scopes):
            return name
    return None


@dataclass
class Survivor:
    pid: int
    executable: str
    key: str


def linux_survivors(scopes: list[str]) -> list[Survivor]:
    found = []
    own = os.getpid()
    for entry in os.scandir("/proc"):
        if not entry.name.isdigit() or int(entry.name) == own:
            continue
        pid = int(entry.name)
        try:
            executable = os.readlink(f"/proc/{pid}/exe")
        except OSError:
            executable = ""
        try:
            cwd = os.readlink(f"/proc/{pid}/cwd")
        except OSError:
            cwd = ""
        try:
            environment = Path(f"/proc/{pid}/environ").read_bytes().split(b"\0")
        except OSError:
            environment = []
        if executable and under(executable, scopes):
            key = "executable"
        elif cwd and under(cwd, scopes):
            key = "cwd"
        else:
            key = matched_variable(environment, scopes)
        if key is not None:
            found.append(Survivor(pid, executable or "?", key))
    return found


def macos_procargs(libc, pid: int) -> tuple[str, list[bytes]] | None:
    """Executable path and environment of a process (KERN_PROCARGS2)."""
    ctl_kern, kern_argmax, kern_procargs2 = 1, 8, 49
    argmax = ctypes.c_int(0)
    size = ctypes.c_size_t(ctypes.sizeof(argmax))
    mib = (ctypes.c_int * 2)(ctl_kern, kern_argmax)
    if libc.sysctl(mib, 2, ctypes.byref(argmax), ctypes.byref(size), None, 0) != 0:
        return None
    buffer = ctypes.create_string_buffer(argmax.value)
    size = ctypes.c_size_t(argmax.value)
    mib3 = (ctypes.c_int * 3)(ctl_kern, kern_procargs2, pid)
    if libc.sysctl(mib3, 3, buffer, ctypes.byref(size), None, 0) != 0:
        return None
    raw = buffer.raw[: size.value]
    if len(raw) < 4:
        return None
    argc = int.from_bytes(raw[:4], sys.byteorder)
    executable, _, rest = raw[4:].partition(b"\0")
    strings = [part for part in rest.lstrip(b"\0").split(b"\0")]
    environment = []
    for part in strings[argc:]:
        if not part:
            break
        environment.append(part)
    return executable.decode("utf-8", errors="replace"), environment


def macos_cwd(libc, pid: int) -> str | None:
    """Working directory of a process (proc_pidinfo PROC_PIDVNODEPATHINFO)."""
    proc_pidvnodepathinfo = 9
    # struct proc_vnodepathinfo holds two struct vnode_info_path (cwd, root),
    # each a 152-byte struct vnode_info followed by a MAXPATHLEN path.
    vnode_info, maxpathlen = 152, 1024
    buffer = ctypes.create_string_buffer(2 * (vnode_info + maxpathlen))
    written = libc.proc_pidinfo(pid, proc_pidvnodepathinfo, 0, buffer, len(buffer))
    if written != len(buffer):
        return None
    path = buffer.raw[vnode_info : vnode_info + maxpathlen].partition(b"\0")[0]
    return path.decode("utf-8", errors="replace") or None


def macos_survivors(scopes: list[str]) -> list[Survivor]:
    libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    libc.proc_pidinfo.argtypes = [ctypes.c_int, ctypes.c_int, ctypes.c_uint64, ctypes.c_void_p, ctypes.c_int]
    libc.proc_pidinfo.restype = ctypes.c_int
    listing = output_of(["ps", "-A", "-o", "pid="])
    if listing is None:
        raise RowsError("the process table cannot be listed")
    found = []
    own = os.getpid()
    for word in listing.split():
        pid = int(word)
        if pid == own:
            continue
        facts = macos_procargs(libc, pid)
        if facts is None:
            continue
        executable, environment = facts
        cwd = macos_cwd(libc, pid)
        if under(executable, scopes):
            key = "executable"
        elif cwd and under(cwd, scopes):
            key = "cwd"
        else:
            key = matched_variable(environment, scopes)
        if key is not None:
            found.append(Survivor(pid, executable or "?", key))
    return found


def test_roots() -> set[str]:
    """The consumer's TestEnv roots under the macOS temp base."""
    base = Path(MACOS_TEMP_ROOT)
    if sys.platform != "darwin" or not base.is_dir():
        return set()
    return {str(entry) for entry in base.iterdir() if entry.name.startswith(TEST_ROOT_PREFIX)}


# ---- account-wide state ------------------------------------------------------


# launchd jobs the system starts and retires on its own while a row runs: the
# Spotlight metadata workers of the shared and the application kind, one label
# per worker instance (observed on macos-15 runners). They are left out of the
# comparison on both sides of a row.
LAUNCHD_TRANSIENT = re.compile(
    r"^com\.apple\.mdworker\.(?:shared|application)\."
    r"[0-9A-F]{8}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{12}$"
)


def launchd_jobs(listing: str) -> set[str]:
    """Labels of a `launchctl list` table."""
    return {line.split("\t")[-1] for line in listing.splitlines()[1:] if line.strip()}


def systemd_units() -> set[str] | None:
    """Loaded units of the systemd user manager, or None without one."""
    listing = output_of(["systemctl", "--user", "list-units", "--plain", "--no-legend", "--no-pager"])
    if listing is None:
        return None
    return {line.split()[0] for line in listing.splitlines() if line.strip()}


# The program of a job as `launchctl print` shows it: its `program` line, or the
# first of its `arguments`.
LAUNCHD_PROGRAM = re.compile(r"^\s*program = (\S.*)$")
LAUNCHD_ARGUMENTS = re.compile(r"^\s*arguments = \{\s*$")


def launchd_domains() -> list[str]:
    """The domains a job listed by `launchctl list` can be in: this process's
    own, then the login session's and the user's, which it inherits."""
    return [f"pid/{os.getpid()}", f"gui/{os.getuid()}", f"user/{os.getuid()}"]


def launchd_program(label: str) -> tuple[str, str] | None:
    """The first domain that describes the job and the job's program there, or
    None when no domain describes a program for it."""
    for domain in launchd_domains():
        description = output_of(["launchctl", "print", f"{domain}/{label}"])
        if description is None:
            continue
        lines = description.splitlines()
        for line in lines:
            if (match := LAUNCHD_PROGRAM.match(line)) is not None:
                return domain, match.group(1).strip()
        for index, line in enumerate(lines[:-1]):
            if LAUNCHD_ARGUMENTS.match(line):
                return domain, lines[index + 1].strip()
    return None


def on_system_volume(program: str) -> bool:
    return program.startswith("/System/") and os.path.normpath(program) == program


def describe_launchd_job(label: str, found: tuple[str, str] | None) -> str:
    """The job log's line for an added job: its label and its program path,
    never any other field of `launchctl print`."""
    if found is None:
        return f"run-rows: added launchd job {label}: not described"
    domain, program = found
    if not program.startswith("/"):
        return f"run-rows: added launchd job {label}: a program that is not an absolute path, in {domain}"
    return f"run-rows: added launchd job {label}: {program}, in {domain}"


def left_out_launchd_jobs(before: set[str], after: set[str]) -> tuple[set[str], set[str]]:
    """The transient jobs on either side, and the added jobs whose program lives
    on the sealed system volume, which the runner's user cannot write. Every
    added job goes to the job log with its program. A job no domain describes
    is not a system job. A job a row submits with a /System program and
    arguments of its own would pass, but that is deliberate evasion, outside
    the threat model above."""
    transient = {label for label in before | after if LAUNCHD_TRANSIENT.match(label)}
    system = set()
    for label in sorted(after - before):
        found = launchd_program(label)
        print(describe_launchd_job(label, found), file=sys.stderr, flush=True)
        if found is not None and on_system_volume(found[1]):
            system.add(label)
    return transient, system


def launchd_labels() -> set[str] | None:
    """Jobs of the launchd user domain, or None without launchctl."""
    listing = output_of(["launchctl", "list"])
    if listing is None:
        return None
    return launchd_jobs(listing)


KEYCHAIN_CLASS = re.compile(r"^class: (.*)$")
# Identifying attributes of an item in `security dump-keychain` output: the
# label (0x00000007 or "labl"), the service, the account and the server.
KEYCHAIN_ATTRIBUTES = {
    "label": re.compile(r'^\s+(?:0x00000007 |"labl")<blob>=(.*)$'),
    "service": re.compile(r'^\s+"svce"<blob>=(.*)$'),
    "account": re.compile(r'^\s+"acct"<blob>=(.*)$'),
    "server": re.compile(r'^\s+"srvr"<blob>=(.*)$'),
}


@dataclass(frozen=True)
class KeychainItem:
    item_class: str
    label: str
    service: str
    account: str
    server: str

    def __str__(self) -> str:
        # Only class and label are ever printed.
        return f"{self.item_class} {self.label or '<no label>'}"


def keychain_entries(listing: str) -> Counter:
    """Every item of a `security dump-keychain` listing, with multiplicity."""
    items: Counter = Counter()
    current: dict[str, str] | None = None
    for line in listing.splitlines() + ["keychain: end"]:
        if line.startswith("keychain: "):
            if current is not None and "class" in current:
                items[
                    KeychainItem(
                        current["class"],
                        current.get("label", ""),
                        current.get("service", ""),
                        current.get("account", ""),
                        current.get("server", ""),
                    )
                ] += 1
            current = {}
        elif current is not None and (match := KEYCHAIN_CLASS.match(line)) is not None:
            current["class"] = match.group(1)
        elif current is not None:
            for name, pattern in KEYCHAIN_ATTRIBUTES.items():
                if (match := pattern.match(line)) is not None:
                    current[name] = match.group(1)
    return items


def keychain_items() -> Counter | None:
    """The login keychain's items, attributes only, or None without one."""
    login = output_of(["security", "login-keychain"])
    if login is None:
        return None
    listing = output_of(["security", "dump-keychain", login.strip().strip('"')])
    if listing is None:
        return None
    return keychain_entries(listing)


# Account-wide state a row could change for the rows after it. Each guard runs
# wherever its command answers; the results name the guards that did.
ACCOUNT_GUARDS = {
    "systemd unit": systemd_units,
    "launchd job": launchd_labels,
    "keychain": keychain_items,
}


def account_state() -> dict:
    return {kind: read() for kind, read in ACCOUNT_GUARDS.items()}


def compare(kind: str, before, after) -> list[str]:
    if before is None and after is None:
        return []
    if before is None or after is None:
        return [f"the {kind} became {'readable' if before is None else 'unreadable'} during the row"]
    if isinstance(before, Counter):
        added, removed = after - before, before - after
        findings = [f"added {kind} entry {item}" + (f" ({count}x)" if count > 1 else "") for item, count in added.items()]
        findings += [
            f"removed {kind} entry {item}" + (f" ({count}x)" if count > 1 else "") for item, count in removed.items()
        ]
        return sorted(findings)
    findings = [f"added {kind} entry {name}" for name in sorted(after - before)]
    findings += [f"removed {kind} entry {name}" for name in sorted(before - after)]
    return findings


# ---- one row -----------------------------------------------------------------


def annotate(result: Result) -> None:
    message = "; ".join(result.messages) or result.status
    message = message.replace("%", "%25").replace("\r", "%0D").replace("\n", "%0A")
    print(f"::error title=Row {result.runtime} on {result.target}::{message}", flush=True)


def forward(stream, last: list[str]) -> None:
    """Copy the row's stderr to ours and remember its last run-row line."""
    for raw in iter(stream.readline, b""):
        sys.stderr.buffer.write(raw)
        sys.stderr.buffer.flush()
        line = raw.decode("utf-8", errors="replace").rstrip("\n")
        if line.startswith("run-row: "):
            last[:] = [line.removeprefix("run-row: ")]


def kill_group(pgid: int, sig: int) -> None:
    try:
        os.killpg(pgid, sig)
    except (ProcessLookupError, PermissionError):
        pass


def remove_tree(root: str) -> None:
    """Removes a row root, including directories a row left without write access."""
    for directory, _subdirectories, _files in os.walk(root):
        if not os.path.islink(directory):
            try:
                os.chmod(directory, 0o700)
            except OSError:
                pass
    shutil.rmtree(root, ignore_errors=True)


def make_root() -> str:
    root = output_of(["mktemp", "-d", ROW_ROOT_TEMPLATE])
    if root is None or not root.strip():
        raise RowsError("the row root cannot be created")
    return root.strip()


def run_one(runtime: str, target: str, limit: float, out_dir: Path) -> Result:
    """Runs one row and its guards. A guard that cannot run fails the row; the
    row's process group is killed and its root removed whatever happened."""
    result = Result(runtime, target)
    root = None
    process = None
    status = None
    timed_out = False
    started = time.monotonic()
    try:
        root = make_root()
        scopes = sorted({root, os.path.realpath(root)})
        roots_before = test_roots()
        state_before = account_state()

        environment = dict(os.environ, RUNTIME=runtime, TARGET=target, ROW_ROOT=root, OUT_DIR=str(out_dir))
        started = time.monotonic()
        process = subprocess.Popen(
            [str(RUN_ROW)], env=environment, stdin=subprocess.DEVNULL, stderr=subprocess.PIPE, start_new_session=True
        )
        last: list[str] = []
        reader = threading.Thread(target=forward, args=(process.stderr, last), daemon=True)
        reader.start()
        try:
            status = process.wait(timeout=limit)
        except subprocess.TimeoutExpired:
            kill_group(process.pid, signal.SIGTERM)
            try:
                process.wait(timeout=TERM_GRACE_SECONDS)
            except subprocess.TimeoutExpired:
                kill_group(process.pid, signal.SIGKILL)
                process.wait()
            timed_out = True
        result.seconds = time.monotonic() - started

        guard_started = time.monotonic()
        new_roots = test_roots() - roots_before
        survivors = (macos_survivors if sys.platform == "darwin" else linux_survivors)(scopes + sorted(new_roots))
        for survivor in survivors:
            try:
                os.kill(survivor.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            result.messages.append(
                f"left process {survivor.pid} ({survivor.executable}) running, matched by {survivor.key}"
            )
        kill_group(process.pid, signal.SIGKILL)
        reader.join(DRAIN_SECONDS)

        if timed_out:
            result.messages.insert(0, f"the row exceeded its limit of {limit:g} s")
        elif status != 0:
            result.messages.insert(0, last[0] if last else f"run-row exited with status {status}")

        state_after = account_state()
        if state_before["launchd job"] is not None and state_after["launchd job"] is not None:
            transient, system_jobs = left_out_launchd_jobs(state_before["launchd job"], state_after["launchd job"])
            state_before["launchd job"] = state_before["launchd job"] - transient
            state_after["launchd job"] = state_after["launchd job"] - transient - system_jobs
            result.system_jobs = sorted(system_jobs)
        for kind in ACCOUNT_GUARDS:
            changes = compare(kind, state_before[kind], state_after[kind])
            result.messages += changes
            if state_before[kind] is not None and state_after[kind] is not None:
                result.guards.append(kind)
                if changes:
                    # The next row would take the changed state as its own.
                    result.stops_job = True
            elif state_before[kind] is not None or state_after[kind] is not None:
                # A guard that answered on one side only cannot tell what the
                # row left for the next one.
                result.stops_job = True
        remove_tree(root)
        if os.path.lexists(root):
            result.messages.append(f"its root {root} could not be removed")
        for leftover in sorted(test_roots() - roots_before):
            result.messages.append(f"left the test root {leftover} behind")
            remove_tree(leftover)
        result.guard_seconds = time.monotonic() - guard_started
    except RowsError as error:
        result.messages.append(str(error))
        # Once the row ran, a guard that could not check it leaves the next
        # row's isolation unknown.
        result.stops_job = process is not None
    finally:
        if process is not None:
            kill_group(process.pid, signal.SIGKILL)
            if process.poll() is None:
                process.wait()
        if root is not None:
            remove_tree(root)
        if not result.seconds:
            result.seconds = time.monotonic() - started

    if timed_out:
        result.status = "timeout"
    elif result.messages or status != 0:
        result.status = "fail"
    else:
        result.status = "pass"
    return result


# ---- the runner's rows -------------------------------------------------------


def write_results(out_dir: Path, results: list[Result]) -> None:
    lines = "".join(json.dumps(result.document(), sort_keys=True) + "\n" for result in results)
    partial = out_dir / (RESULTS_FILE + ".partial")
    partial.write_text(lines)
    partial.replace(out_dir / RESULTS_FILE)


def write_summary(results: list[Result]) -> None:
    path = os.environ.get("GITHUB_STEP_SUMMARY")
    if not path:
        return
    lines = ["| Row | Result | Row s | Guards s | Message |", "| --- | --- | --- | --- | --- |"]
    for result in results:
        message = "; ".join(result.messages).replace("|", "\\|")
        lines.append(
            f"| {result.runtime} on {result.target} | {result.status} | {result.seconds:.1f}"
            f" | {result.guard_seconds:.1f} | {message} |"
        )
    with open(path, "a", encoding="utf-8") as handle:
        handle.write("\n".join(lines) + "\n")


def row_outputs(out_dir: Path, runtime: str, target: str) -> list[Path]:
    return [out_dir / f"attestation-{runtime}-{target}.json", out_dir / f"junit-{runtime}-{target}.xml"]


def main() -> int:
    resolve_commands()
    rows = parse_rows(required("ROWS"))
    limit = float(required("ROW_LIMIT_SECONDS"))
    if limit <= 0:
        raise RowsError("ROW_LIMIT_SECONDS must be positive")
    for name in ROW_INPUTS:
        required(name)
    out_dir = Path(required("OUT_DIR"))
    out_dir.mkdir(parents=True, exist_ok=True)
    if any(out_dir.iterdir()):
        raise RowsError("OUT_DIR is not empty")

    trusted = [
        Path(os.environ["XTASK"]),
        Path(os.environ["CONSUMER"]),
        RUN_ROW,
        SELF,
        Path(os.environ["DAEMON_DIR"]),
        Path(os.environ["PACKAGES_DIR"]),
    ]
    manifest = Manifest(trusted)
    left = manifest.remove_bytecode_caches()
    if left:
        raise RowsError(f"the bytecode caches cannot be removed: {', '.join(left[:10])}")
    results = [Result(runtime, target) for runtime, target in rows]
    write_results(out_dir, results)
    for index, (runtime, target) in enumerate(rows):
        print(f"::group::Row {runtime} on {target}", flush=True)
        result = run_one(runtime, target, limit, out_dir)
        print("::endgroup::", flush=True)
        checked = time.monotonic()
        changed = manifest.changes()
        if changed:
            shown = ", ".join(changed[:10]) + (f" and {len(changed) - 10} more" if len(changed) > 10 else "")
            result.messages.append(f"changed what later rows trust: {shown}")
            result.stops_job = True
        left = manifest.remove_bytecode_caches()
        if left:
            result.messages.append(f"left bytecode caches that cannot be removed: {', '.join(left[:10])}")
            result.stops_job = True
        result.guard_seconds += time.monotonic() - checked
        if result.stops_job:
            result.status = "fail"
        if result.status != "pass":
            # Only a passing row's attestation may leave the job.
            (out_dir / f"attestation-{runtime}-{target}.json").unlink(missing_ok=True)
            annotate(result)
        results[index] = result
        write_results(out_dir, results)
        if result.stops_job:
            for skipped in results[index + 1 :]:
                skipped.messages = [f"not run: the job stopped after the row {runtime} on {target}"]
            write_results(out_dir, results)
            write_summary(results)
            return 1
        if result.status == "pass":
            for output in row_outputs(out_dir, runtime, target):
                if os.path.exists(output):
                    manifest.add(output)
    write_results(out_dir, results)
    write_summary(results)
    return 0 if all(result.status == "pass" for result in results) else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except RowsError as error:
        print(f"run-rows: {error}", file=sys.stderr)
        sys.exit(2)
