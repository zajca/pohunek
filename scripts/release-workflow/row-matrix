#!/bin/sh
# Print the GitHub Actions matrix of the compatibility rows.
#
# usage: row-matrix <compat/matrix.json> [target]...
#
# Output: one line `{"include":[{"runtime","target","runner"}...]}` with one
# entry per row of the matrix file, optionally restricted to the listed
# targets. Runtime ids and targets are validated as plain words, because the
# workflow puts them into artifact names. A target without a known runner
# fails; so does an empty selection.

set -eu

fail() {
    printf 'row-matrix: %s\n' "$*" >&2
    exit 1
}

[ "$#" -ge 1 ] || fail "usage: row-matrix <matrix.json> [target]..."
matrix=$1
shift
targets=$*

[ -f "$matrix" ] || fail "not a file: $matrix"

jq -ec --arg targets "$targets" '
    def word: type == "string" and test("^[a-z0-9][a-z0-9_-]*$");
    def runner:
        if test("^x86_64-unknown-linux-(gnu|musl)$") then "ubuntu-latest"
        else error("no runner for target " + .) end;
    ($targets | split(" ") | map(select(length > 0))) as $wanted
    | [.rows[]
        | select(($wanted | length) == 0 or ((.target) as $t | $wanted | index($t)))
        | if (.runtime | word) and (.target | word) then
            {runtime, target, runner: (.target | runner)}
          else error("invalid row") end]
    | if length == 0 then error("no rows selected") else {include: .} end
' "$matrix" || fail "cannot derive the row matrix from $matrix"
