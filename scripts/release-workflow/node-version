#!/bin/sh
# Print the Node.js version the upstream runtimes of the matrix need.
#
# usage: node-version <compat/matrix.json>         (run from the repository root)
#
# Each upstream lock may declare `upstream.node_min`; the answer is the highest
# one among the runtimes of the matrix, because rows and the archive smoke share
# one runner image. A matrix whose runtimes declare none fails: the upstreams
# are Node programs and the runner's default Node is not a pinned input.

set -eu

fail() {
    printf 'node-version: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 1 ] || fail "usage: node-version <matrix.json>"
matrix=$1
[ -f "$matrix" ] || fail "not a file: $matrix"

versions=$(jq -r '[.rows[].runtime] | unique | .[]' "$matrix" | while IFS= read -r runtime; do
    case $runtime in
        '' | *[!a-z0-9_-]*) fail "invalid runtime id: $runtime" ;;
    esac
    lock=compat/$runtime/compatibility-lock.json
    [ -f "$lock" ] || fail "no compatibility lock for runtime $runtime"
    jq -r '.upstream.node_min // empty' "$lock"
done)
best=$(printf '%s\n' "$versions" | sed '/^$/d' | LC_ALL=C sort -t. -k1,1n -k2,2n -k3,3n | tail -n 1)
case $best in
    '' | *[!0-9.]*) fail "no runtime of the matrix declares upstream.node_min" ;;
esac
printf '%s\n' "$best"
