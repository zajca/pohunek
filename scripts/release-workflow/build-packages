#!/bin/sh
# Build every official runtime package archive of the checkout.
#
# usage: build-packages <version> <output-dir> <evidence-dir>
#        (run from the repository root)
# env:   XTASK  path of the built xtask binary
#
# The official packages are the directories of `runtime-packages/`; no runtime
# is named here. Each one is built twice and compared (`package verify`), then
# written as `pohunek-runtime-<runtime>-<version>.tar.zst` with a `.sha256`
# file in `sha256sum -c` format. The name carries the core release version, as
# `cargo xtask release assemble` expects.
#
# The builder evidence (`<archive>.sha256`, `<runtime>.manifest.json`,
# `<runtime>.provenance-input.json`, `<runtime>.compat-vector.json`) goes to
# the evidence directory, which must lie outside the output directory:
# `collect-inputs` copies every file of the output directory into the
# assembler's inputs. The checksum the builder wrote must equal the one
# `sha256sum` writes here.

set -eu

fail() {
    printf 'build-packages: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 3 ] || fail "usage: build-packages <version> <output-dir> <evidence-dir>"
version=$1
output=$2
evidence=$3
[ -n "${XTASK:-}" ] && [ -x "$XTASK" ] || fail "XTASK must name the built xtask binary"
[ -n "$output" ] && [ -n "$evidence" ] || fail "empty output or evidence directory"
case $version in
    '' | *[!0-9.]*) fail "invalid version: $version" ;;
esac

# Prints the physical path of directory $1, which need not exist yet: the
# nearest existing ancestor is resolved with `pwd -P` and the missing names are
# appended. A missing `.` or `..` name, or an existing non-directory, fails.
resolve() {
    path=$1
    rest=
    while [ ! -d "$path" ]; do
        [ ! -e "$path" ] && [ ! -L "$path" ] || fail "not a directory: $path"
        name=$(basename -- "$path")
        case $name in
            . | .. | /) fail "cannot resolve directory: $1" ;;
        esac
        rest=/$name$rest
        path=$(dirname -- "$path")
    done
    printf '%s%s\n' "$(cd -- "$path" && pwd -P)" "$rest"
}

# Checked before anything is created, so a refused run leaves nothing behind.
output_real=$(resolve "$output")
evidence_real=$(resolve "$evidence")
case $evidence_real/ in
    "$output_real"/*) fail "the evidence directory must lie outside the output directory" ;;
esac
case $output_real/ in
    "$evidence_real"/*) fail "the output directory must lie outside the evidence directory" ;;
esac
mkdir -p "$output" "$evidence"

count=0
for dir in runtime-packages/*/; do
    [ -d "$dir" ] || continue
    runtime=$(basename -- "$dir")
    case $runtime in
        '' | *[!a-z0-9_-]*) fail "invalid runtime directory name: $runtime" ;;
    esac
    archive="pohunek-runtime-$runtime-$version.tar.zst"
    "$XTASK" package verify "runtime-packages/$runtime"
    "$XTASK" package build "runtime-packages/$runtime" --output "$output/$archive" \
        --evidence-dir "$evidence"
    (cd "$output" && sha256sum -- "$archive" > "$archive.sha256")
    cmp -s -- "$output/$archive.sha256" "$evidence/$archive.sha256" \
        || fail "builder checksum differs from sha256sum: $archive"
    count=$((count + 1))
done
[ "$count" -gt 0 ] || fail "runtime-packages/ holds no package directory"
