#!/bin/sh

# Starts the packaged macOS GUI the way Finder starts an app and requires it to
# stay up. usage: smoke-gui-release-macos <Pohunek.app>
#
# The bundle identity is checked first (identifier, executable, minimum macOS).
# The app is then opened through LaunchServices (`open -n`), the path Finder and
# the Dock take, with an isolated configuration. A process that exits during
# the window, or reports a panic, fails the check. Needs a window
# server: outside a GUI (Aqua) launchd session it exits 2, never reports
# success without starting the app.

set -eu
umask 077

readonly SMOKE_WINDOW_SECONDS=8
readonly SMOKE_LAUNCH_SECONDS=20
readonly SMOKE_TERM_WAIT_SECONDS=15
readonly EXPECTED_IDENTIFIER=io.github.zajca.pohunek.gui

if [ "$#" -ne 1 ]; then
    printf '%s\n' "usage: $0 <Pohunek.app>" >&2
    exit 64
fi
app=$1
[ "$(uname -s)" = Darwin ] || { printf '%s\n' "this check runs on macOS only" >&2; exit 2; }
[ -d "$app/Contents/MacOS" ] || { printf 'not an app bundle: %s\n' "$app" >&2; exit 66; }

plist=$app/Contents/Info.plist
identifier=$(/usr/bin/plutil -extract CFBundleIdentifier raw -o - "$plist")
executable_name=$(/usr/bin/plutil -extract CFBundleExecutable raw -o - "$plist")
minimum=$(/usr/bin/plutil -extract LSMinimumSystemVersion raw -o - "$plist")
[ "$identifier" = "$EXPECTED_IDENTIFIER" ] || { printf 'bundle identifier is %s, expected %s\n' "$identifier" "$EXPECTED_IDENTIFIER" >&2; exit 1; }
executable=$app/Contents/MacOS/$executable_name
[ -x "$executable" ] || { printf 'bundle executable is missing or not executable: %s\n' "$executable" >&2; exit 1; }
printf 'bundle %s, executable %s, minimum macOS %s\n' "$identifier" "$executable_name" "$minimum"

manager=$(/bin/launchctl managername 2>/dev/null || printf unknown)
if [ "$manager" != Aqua ]; then
    printf 'no window server: launchd session is "%s", not "Aqua"\n' "$manager" >&2
    exit 2
fi

work=$(mktemp -d /tmp/pohunek-gui-smoke.XXXXXX)
work=$(CDPATH='' cd -- "$work" && pwd -P)
gui_pid=
cleanup() {
    status=$?
    trap - EXIT
    if [ -n "$gui_pid" ] && kill -0 "$gui_pid" 2>/dev/null; then
        kill -TERM "$gui_pid" 2>/dev/null || true
        waited=0
        while kill -0 "$gui_pid" 2>/dev/null && [ "$waited" -lt "$SMOKE_TERM_WAIT_SECONDS" ]; do
            sleep 1
            waited=$((waited + 1))
        done
        kill -KILL "$gui_pid" 2>/dev/null || true
    fi
    if [ "$status" -ne 0 ] && [ -f "$work/gui.err" ]; then
        cat "$work/gui.err" >&2
    fi
    rm -rf -- "$work"
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

home=$work/h
mkdir -p "$home/.config/pohunek" "$work/run" "$work/state" "$work/data" "$work/cache"
user=$(id -un)
: > "$work/gui.out"
: > "$work/gui.err"
# LaunchServices starts the app as Finder does: through launchd, with launchd's
# minimal environment. `open --env` adds only the isolation variables, so the
# run neither reads nor changes the operator's own pohunek state.
/usr/bin/open -n \
    --env "HOME=$home" --env "USER=$user" --env "LOGNAME=$user" \
    --env "XDG_CONFIG_HOME=$home/.config" --env "XDG_RUNTIME_DIR=$work/run" \
    --env "XDG_STATE_HOME=$work/state" --env "XDG_DATA_HOME=$work/data" \
    --env "XDG_CACHE_HOME=$work/cache" \
    --stdout "$work/gui.out" --stderr "$work/gui.err" "$app" ||
    { printf '%s\n' "LaunchServices could not open the bundle" >&2; exit 1; }

# The process is launchd's child, so find it by its executable path.
waited=0
while :; do
    gui_pid=$(/usr/bin/pgrep -f "$executable" | head -n 1 || true)
    [ -n "$gui_pid" ] && break
    [ "$waited" -lt "$SMOKE_LAUNCH_SECONDS" ] || { printf '%s\n' "the app did not start within ${SMOKE_LAUNCH_SECONDS}s" >&2; exit 1; }
    sleep 1
    waited=$((waited + 1))
done

elapsed=0
while [ "$elapsed" -lt "$SMOKE_WINDOW_SECONDS" ]; do
    if ! kill -0 "$gui_pid" 2>/dev/null; then
        printf '%s\n' "the packaged GUI exited during startup" >&2
        exit 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
done
if grep -qiE 'panicked at|fatal' "$work/gui.err"; then
    printf '%s\n' "the packaged GUI reported a panic or fatal error" >&2
    exit 1
fi
printf 'the packaged GUI stayed up for %ss\n' "$SMOKE_WINDOW_SECONDS"
