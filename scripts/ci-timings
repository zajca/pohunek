#!/usr/bin/env python3
"""Reproduce the test-performance baseline from CI and local artifacts.

Implements the measurement half of issue #127 (epic #115): per-job workflow
wall clock, JUnit execution times, and sccache/rust-cache cache-hit evidence.

Every number printed by this tool comes from one of three sources:

* `runs` / `compare` -- GitHub Actions run and job metadata (`gh`), which is
  per-job wall clock, not test execution time. Wall clock includes checkout,
  toolchain setup, cache restore, compilation, and the tests themselves.
* `junit` -- nextest JUnit XML (`target/nextest/<profile>/junit.xml` or an
  uploaded CI artifact). JUnit has test execution time only; compilation and
  setup are deliberately *not* part of it.
* `cache` -- the raw run log, which contains the sccache JSON statistics
  printed by the post-run `sccache-action` step and the `Swatinem/rust-cache`
  restore outcome lines.

`steps` -- per-step medians from the same `gh run view --json jobs`
  documents (each job object also carries its `steps` with start and
  completion timestamps). Every counted job's wall clock is additionally
  rounded up to a whole minute and summed into runner minutes, added
  beside the wall-clock medians of `runs` and `compare`.

`--cache` keeps fetched run metadata on disk; passing that snapshot back as
`--input` regenerates the tables in `docs/design/test-performance-report.md`
without touching the network.
"""

import argparse
import collections
import datetime
import json
import math
from pathlib import Path
import re
import statistics
import subprocess
import sys
import xml.etree.ElementTree as ElementTree

ROOT = Path(__file__).resolve().parents[1]
WORKFLOW = "ci.yml"
DEFAULT_CACHE = ROOT / "target/ci-timings/ci-runs.json"
# Windows behind the report tables, so the numbers in
# docs/design/test-performance-report.md stay reproducible.
REPORT_BASELINE = "2026-09-14..2026-09-16"
REPORT_CURRENT = "2026-09-20..2026-09-21"
# `Swatinem/rust-cache` step-log markers. A restore that begins and then
# fails is an operational failure of the cache backend or the extraction, not
# evidence that the entry was absent, so it stays apart from `miss`: folding
# the two together would report a working cache as ineffective.
RUST_CACHE_HIT = "Cache restored successfully"
RUST_CACHE_MISS = ("Cache not found",)
RUST_CACHE_ERROR = ("Failed to restore",)
# Fields requested from `gh run list` and `gh run view --json`. The list
# fields carry workflowName so a shared on-disk cache can be filtered back
# to the CI workflow even when it accumulates documents from other fetches.
LIST_FIELDS = (
    "databaseId,conclusion,createdAt,updatedAt,event,headBranch,displayTitle,"
    "attempt,startedAt,workflowName"
)
VIEW_FIELDS = (
    "databaseId,name,displayTitle,event,conclusion,createdAt,updatedAt,"
    "startedAt,attempt,headBranch,workflowName,jobs"
)
# GitHub bills each job's runner time rounded UP to a whole minute, so
# every job's wall clock contributes one minute-quantized step.
RUNNER_MINUTE = 60


def parse_timestamp(value):
    """Parse a GitHub Actions ISO-8601 timestamp (UTC, trailing `Z`)."""
    if not value:
        return None
    return datetime.datetime.fromisoformat(value.replace("Z", "+00:00"))


def format_seconds(seconds):
    """Render a duration as `9s`, `1m23s`, or `1h02m`.

    Deltas are durations too, so the magnitude is scaled first and the sign
    restored after: a 196 s improvement reads `-3m16s`, the same shape as
    the `3m16s` regression it mirrors.
    """
    total = int(round(seconds))
    sign = "-" if total < 0 else ""
    total = abs(total)
    if total >= 3600:
        return f"{sign}{total // 3600}h{total % 3600 // 60:02d}m"
    if total >= 60:
        return f"{sign}{total // 60}m{total % 60:02d}s"
    return f"{sign}{total}s"


def format_percent(value):
    """Render a signed percentage, or `n/a` when there is no comparison."""
    return "n/a" if value is None else f"{value:+.0f} %"


def job_seconds(document):
    """Map job name to wall-clock seconds for every finished job.

    Conditionally skipped jobs carry no meaningful duration: their timestamps
    are absent (`null`) or the Go zero time (`0001-01-01T00:00:00Z`), which
    would otherwise count as a 0 s run and drag medians down while inflating
    run counts. Both are excluded alongside any non-positive duration.
    """
    durations = {}
    for job in document.get("jobs") or []:
        if (job.get("conclusion") or "") == "skipped":
            continue
        start = parse_timestamp(job.get("startedAt"))
        end = parse_timestamp(job.get("completedAt"))
        if start is None or end is None:
            continue
        if start.year <= 1 or end.year <= 1:
            continue
        seconds = (end - start).total_seconds()
        if seconds <= 0:
            continue
        durations[job["name"]] = seconds
    return durations


def runner_minutes(jobs):
    """Billable runner minutes for one run from its per-job wall clock.

    GitHub rounds each job up to a whole minute, so the per-run total sums
    the per-job ceilings, never flooring the sum itself. The repo is
    public, which keeps `/actions/runs/{id}/timing` billable at 0: that
    field must not be used, and the per-job rounding is the only
    approximation this tool can compute.
    """
    return sum(math.ceil(seconds / RUNNER_MINUTE) for seconds in jobs.values())


def summarize_run(document, with_steps=False):
    """Normalize one `gh run view --json` document into a run summary.

    `created_at` keeps the run's creation time and selects date windows, so it
    matches the server-side `--created` filter semantics. Wall clock measures
    the actual execution (`started_at` to `updated_at`), not queue time
    between rerun attempts: `createdAt` stays at the original attempt, so
    reruns would otherwise appear as hour-long runs. `with_steps` also
    carries the per-job step durations (`steps` key) for the `steps`
    subcommand; the default keeps the summary shape unchanged.
    """
    started = parse_timestamp(document.get("startedAt"))
    created = parse_timestamp(document.get("createdAt"))
    updated = parse_timestamp(document.get("updatedAt"))
    if updated is None or (started is None and created is None):
        raise ValueError(f"run {document.get('databaseId')} has no timestamps")
    if started is None:
        # Older snapshots predate the startedAt field.
        started = created
    jobs = job_seconds(document)
    summary = {
        "id": document["databaseId"],
        "created_at": created,
        "started_at": started,
        "updated_at": updated,
        "wall_seconds": (updated - started).total_seconds(),
        # Attempts above one are reruns; keep them out of the aggregates.
        "attempt": document.get("attempt") or 1,
        "conclusion": document.get("conclusion"),
        "event": document.get("event"),
        "branch": document.get("headBranch"),
        "title": document.get("displayTitle"),
        "jobs": jobs,
        "runner_minutes": runner_minutes(jobs),
    }
    if with_steps:
        summary["steps"] = step_durations(document)
    return summary



def parse_date(value):
    """Parse a `YYYY-MM-DD` date as a UTC midnight datetime."""
    return datetime.datetime.strptime(value, "%Y-%m-%d").replace(
        tzinfo=datetime.timezone.utc
    )


def parse_window(value):
    """Parse an inclusive `START..END` window of `YYYY-MM-DD` dates."""
    parts = value.split("..")
    if len(parts) != 2:
        raise ValueError(f"window must be START..END, got {value!r}")
    return parse_date(parts[0]), parse_date(parts[1])


def select_attempts(runs, attempts):
    """Reduce each run's attempts to the samples `attempts` asks for.

    `first` keeps the lowest attempt number so a failed first attempt is
    never displaced by its own successful rerun; `all` keeps every attempt as
    its own sample. Both `filter_runs` and the empty-window diagnosis go
    through here, so the diagnosis can never reason about a run that was
    never a candidate.
    """
    by_id = {}
    for run in runs:
        by_id.setdefault(run["id"], []).append(run)
    candidates = []
    for group in by_id.values():
        ordered = sorted(group, key=lambda run: run.get("attempt", 1) or 1)
        if attempts == "first":
            candidates.append(ordered[0])
        else:
            candidates.extend(ordered)
    return candidates


def run_passes_filters(run, args):
    """Whether one run survives the `--conclusion`/`--event`/`--branch` filters."""
    return all(
        value is None or run.get(field) == value
        for field, value in (
            ("conclusion", args.conclusion),
            ("event", args.event),
            ("branch", args.branch),
        )
    )


def filter_runs(runs, window=None, event=None, conclusion=None, branch=None,
                attempts="first"):
    """Select run summaries by window (inclusive dates) and run metadata.

    Attempt grouping happens before any metadata filter: with the default
    `first`, a failed first attempt is never discarded so that its run's
    successful rerun can masquerade as the representative. The lowest attempt
    number wins the run, then the winner must pass the conclusion/event/branch
    filters. With `all`, every attempt is kept as its own sample.
    """
    selected = []
    for run in select_attempts(runs, attempts):
        when = run["created_at"]
        if window is not None:
            start, end = window
            if when is None or not start <= when < end + datetime.timedelta(days=1):
                continue
        if event is not None and run.get("event") != event:
            continue
        if conclusion is not None and run.get("conclusion") != conclusion:
            continue
        if branch is not None and run.get("branch") != branch:
            continue
        selected.append(run)
    fallback = datetime.datetime.min.replace(tzinfo=datetime.timezone.utc)
    return sorted(
        selected, key=lambda run: run["created_at"] if run["created_at"] else fallback
    )


def window_summary(runs):
    """Per-job and workflow percentiles across a window of runs.

    The workflow p90 is reported alongside the median because the report
    quotes both, and a number the tool cannot print is a number no one can
    check. `percentile` is nearest-rank, so p90 is an observed run's wall
    clock, not an interpolation between two. Runner minutes are sampled
    per run and summed across the window, beside the wall-clock medians.
    """
    jobs = {}
    walls = [run["wall_seconds"] for run in runs]
    minutes = [run["runner_minutes"] for run in runs]
    for run in runs:
        for name, seconds in run["jobs"].items():
            jobs.setdefault(name, []).append(seconds)
    return {
        "runs": len(runs),
        "wall_seconds": statistics.median(walls) if runs else None,
        "wall_p90": percentile(walls, 0.90),
        "runner_minutes": statistics.median(minutes) if runs else None,
        "runner_minutes_total": sum(minutes),
        "jobs": {
            name: {
                "p50": statistics.median(values),
                "p90": percentile(values, 0.90),
                "runs": len(values),
            }
            for name, values in jobs.items()
        },
    }


def compare_windows(baseline, current):
    """Compare two window summaries per job, largest baseline first.

    Jobs that exist in only one window still get a row with `n/a` on the
    missing side, so added or removed shards stay visible.
    """
    names = set(baseline["jobs"]) | set(current["jobs"])
    rows = []
    for name in names:
        before = baseline["jobs"].get(name)
        after = current["jobs"].get(name)
        delta = after["p50"] - before["p50"] if after and before else None
        rows.append(
            {
                "job": name,
                "before": before["p50"] if before else None,
                "after": after["p50"] if after else None,
                "before_runs": before["runs"] if before else 0,
                "after_runs": after["runs"] if after else 0,
                "delta": delta,
                "percent": delta / before["p50"] * 100
                if delta is not None and before["p50"]
                else None,
            }
        )
    rows.sort(
        key=lambda row: (
            row["before"] if row["before"] is not None else -1.0,
            row["after"] if row["after"] is not None else -1.0,
        ),
        reverse=True,
    )
    return rows


def format_minutes(minutes):
    """Render runner minutes as a plain number plus unit, or `n/a`."""
    return "n/a" if minutes is None else f"{minutes:g} min"


def render_runs_markdown(runs):
    """Render one row per run plus the per-job median table."""
    lines = [
        "| Run | Date | Event | Branch | Conclusion | Wall clock | Runner min |",
        "| --- | --- | --- | --- | --- | --- | --- |",
    ]
    for run in runs:
        rerun = f" (attempt {run['attempt']})" if run["attempt"] > 1 else ""
        lines.append(
            f"| {run['id']} | {run['created_at'].date()} | {run['event']} | "
            f"{run['branch']}{rerun} | {run['conclusion']} | "
            f"{format_seconds(run['wall_seconds'])} | {run['runner_minutes']} |"
        )
    summary = window_summary(runs)
    if summary["runs"]:
        lines.append("")
        lines.append(
            f"Workflow wall clock over {summary['runs']} run(s): "
            f"p50 {format_seconds(summary['wall_seconds'])}, "
            f"p90 {format_seconds(summary['wall_p90'])}; "
            f"runner minutes p50 {format_minutes(summary['runner_minutes'])}, "
            f"summed {format_minutes(summary['runner_minutes_total'])}"
        )
        lines.append("")
        lines.append("| Job | p50 | p90 | Runs |")
        lines.append("| --- | --- | --- | --- |")
        for name, job in sorted(
            summary["jobs"].items(), key=lambda item: item[1]["p50"], reverse=True
        ):
            lines.append(
                f"| {name} | {format_seconds(job['p50'])} | "
                f"{format_seconds(job['p90'])} | {job['runs']} |"
            )
    return "\n".join(lines)


def render_compare_markdown(baseline, current, rows):
    """Render the before/after table used by the report."""
    delta = current["wall_seconds"] - baseline["wall_seconds"]
    percent = (
        delta / baseline["wall_seconds"] * 100 if baseline["wall_seconds"] else None
    )
    lines = [
        f"Baseline: {baseline['runs']} run(s), workflow p50 "
        f"{format_seconds(baseline['wall_seconds'])}, p90 "
        f"{format_seconds(baseline['wall_p90'])}",
        f"Current: {current['runs']} run(s), workflow p50 "
        f"{format_seconds(current['wall_seconds'])}, p90 "
        f"{format_seconds(current['wall_p90'])}",
        "",
        "| Job | Before (p50) | After (p50) | Delta | Delta % | Runs (before/after) |",
        "| --- | --- | --- | --- | --- | --- |",
    ]
    for row in rows:
        before = "n/a" if row["before"] is None else format_seconds(row["before"])
        after = "n/a" if row["after"] is None else format_seconds(row["after"])
        row_delta = "n/a" if row["delta"] is None else format_seconds(row["delta"])
        lines.append(
            f"| {row['job']} | {before} | {after} | "
            f"{row_delta} | {format_percent(row['percent'])} | "
            f"{row['before_runs']}/{row['after_runs']} |"
        )
    lines.append(
        f"| **workflow** | **{format_seconds(baseline['wall_seconds'])}** | "
        f"**{format_seconds(current['wall_seconds'])}** | **{format_seconds(delta)}** | "
        f"**{format_percent(percent)}** | "
        f"**{baseline['runs']}/{current['runs']}** |"
    )
    p90_delta = current["wall_p90"] - baseline["wall_p90"]
    lines.append(
        f"| **workflow (p90)** | **{format_seconds(baseline['wall_p90'])}** | "
        f"**{format_seconds(current['wall_p90'])}** | "
        f"**{format_seconds(p90_delta)}** | "
        f"**{format_percent(p90_delta / baseline['wall_p90'] * 100 if baseline['wall_p90'] else None)}** | "
        f"**{baseline['runs']}/{current['runs']}** |"
    )
    before_med = baseline.get("runner_minutes")
    after_med = current.get("runner_minutes")
    med_delta = (
        after_med - before_med
        if before_med is not None and after_med is not None else None
    )
    before_total = baseline.get("runner_minutes_total")
    after_total = current.get("runner_minutes_total")
    total_delta = (
        after_total - before_total
        if before_total is not None and after_total is not None else None
    )
    med_percent = (
        med_delta / before_med * 100
        if med_delta is not None and before_med else None
    )
    total_percent = (
        total_delta / before_total * 100
        if total_delta is not None and before_total else None
    )
    lines.append(
        f"| **runner minutes (median)** | "
        f"**{format_minutes(before_med)}** | **{format_minutes(after_med)}** | "
        f"**{format_minutes(med_delta)}** | **{format_percent(med_percent)}** | "
        f"**{baseline['runs']}/{current['runs']}** |"
    )
    lines.append(
        f"| **runner minutes (total)** | **{format_minutes(before_total)}** | "
        f"**{format_minutes(after_total)}** | "
        f"**{format_minutes(total_delta)}** | **{format_percent(total_percent)}** | "
        f"**{baseline['runs']}/{current['runs']}** |"
    )
    return "\n".join(lines)


def junit_step_seconds(document,
                       step_patterns=("Run fast shard",
                                      "bounded nextest concurrency",
                                      "Documentation tests")):
    """Map job name to the elapsed seconds of its test-execution step.

    nextest runs tests in parallel, so the *sum* of JUnit testcase times is
    not wall-clock time; only the CI step's own start/end timestamps give a
    comparable test share. Patterns match the workflow's test steps by exact
    substring ("Run fast shard", the bounded-concurrency heavy/relay-db
    steps, "Documentation tests"); install steps that merely mention nextest
    never match. Jobs without a matching step map to None.
    """
    durations = {}
    for job in document.get("jobs") or []:
        elapsed = None
        for step in job.get("steps") or []:
            name = step.get("name") or ""
            if not any(pattern in name for pattern in step_patterns):
                continue
            start = parse_timestamp(step.get("startedAt"))
            end = parse_timestamp(step.get("completedAt"))
            if start is None or end is None:
                continue
            elapsed = (end - start).total_seconds()
            break
        durations[job["name"]] = elapsed
    return durations


def step_durations(document):
    """Map job name to {step name: elapsed seconds} for every counted step.

    The `jobs` objects of `gh run view --json jobs` carry each step's start
    and completion timestamps. Steps are counted exactly like jobs in
    `job_seconds`: a skipped job or step, null timestamps, the Go zero
    time, and a non-positive duration all contribute nothing. Two counted
    steps in one job sharing a name are kept both, the second and later
    ones keyed as `<name> (#<number>)` after their 1-based step number.
    """
    counted = {}
    for job in document.get("jobs") or []:
        if (job.get("conclusion") or "") == "skipped":
            continue
        steps = {}
        for step in job.get("steps") or []:
            if (step.get("conclusion") or "") == "skipped":
                continue
            start = parse_timestamp(step.get("startedAt"))
            end = parse_timestamp(step.get("completedAt"))
            if start is None or end is None:
                continue
            if start.year <= 1 or end.year <= 1:
                continue
            seconds = (end - start).total_seconds()
            if seconds <= 0:
                continue
            name = step.get("name") or "?"
            if name in steps:
                # The same action can run twice in one job; the step
                # number disambiguates the collision. A missing number
                # degrades to `##` rather than overwriting.
                number = step.get("number")
                name = f"{name} (#{number})" if number else f"{name} ##"
            steps[name] = seconds
        counted[job["name"]] = steps
    return counted


def percentile(values, fraction):
    """Nearest-rank percentile over an unsorted list of numbers."""
    if not values:
        return None
    ordered = sorted(values)
    index = min(len(ordered) - 1, max(0, math.ceil(fraction * len(ordered))) - 1)
    return ordered[index]


def parse_junit(paths, top=5):
    """Summarise nextest JUnit XML files into counts and execution times."""
    suites = []
    slowest = []
    times = []
    failures = 0
    errors = 0
    skipped = 0
    for path in paths:
        root = ElementTree.parse(path).getroot()
        nodes = [root] if root.tag == "testsuite" else list(root)
        for node in nodes:
            if node.tag != "testsuite":
                continue
            cases = node.findall("testcase")
            suite_seconds = float(node.get("time") or 0.0)
            suites.append(
                {
                    "name": node.get("name") or path.name,
                    "tests": int(node.get("tests") or len(cases)),
                    "failures": int(node.get("failures") or 0),
                    "errors": int(node.get("errors") or 0),
                    "skipped": int(node.get("skipped") or 0),
                    "seconds": suite_seconds,
                }
            )
            failures += suites[-1]["failures"]
            errors += suites[-1]["errors"]
            skipped += suites[-1]["skipped"]
            for case in cases:
                seconds = float(case.get("time") or 0.0)
                times.append(seconds)
                slowest.append((case.get("name") or "?", seconds))
    slowest.sort(key=lambda item: item[1], reverse=True)
    return {
        "suites": suites,
        "cases": len(times),
        "failures": failures,
        "errors": errors,
        "skipped": skipped,
        "seconds": sum(times),
        "p50": statistics.median(times) if times else None,
        "p95": percentile(times, 0.95),
        "slowest": slowest[:top],
    }


# Named `Swatinem/rust-cache@v2` steps in ci.yml use "Cache cargo build"; a
# step left unnamed is logged under the action reference instead, so both
# spellings identify rust-cache. Matching by step name keeps `actions/cache`
# steps (e.g. "Cache Bun packages", "Cache Playwright browsers") out of the
# rust-cache evidence. The sccache statistics blob is printed by the
# post-step of "Enable sccache" (`sccache-action` `--show-stats
# --stats-format=json`); only that step's lines may set the sccache entry.
# Lines that match neither kind leave no trace: no fabricated records.
RUST_CACHE_STEP = "Cache cargo build"
RUST_CACHE_ACTION = "Swatinem/rust-cache"
SCCACHE_STEP = "Post Enable sccache"


def is_rust_cache_step(step):
    """Whether a log step name belongs to the `Swatinem/rust-cache` action."""
    return step == RUST_CACHE_STEP or RUST_CACHE_ACTION in step


def parse_cache_log(text):
    """Extract per-job sccache statistics and rust-cache restore outcomes.

    Only lines from the responsible steps count: rust-cache outcomes from a
    step ``is_rust_cache_step`` recognizes, and the sccache JSON blob from
    ``SCCACHE_STEP`` (the sccache post-step). All other lines (including
    `actions/cache` steps for Bun/Playwright and the cache-save upload steps)
    are ignored.
    """
    jobs = {}
    for line in text.splitlines():
        parts = line.split("\t", 2)
        if len(parts) < 2:
            continue
        job, step = parts[0], parts[1]
        message = parts[2] if len(parts) > 2 else ""
        if '"stats":' in message:
            if step != SCCACHE_STEP:
                continue
        elif RUST_CACHE_HIT in message or any(
            marker in message
            for marker in RUST_CACHE_MISS + RUST_CACHE_ERROR
        ):
            if not is_rust_cache_step(step):
                continue
        else:
            continue
        record = jobs.setdefault(job, {"job": job, "sccache": None, "rust_cache": None})
        if '"stats":' in message:
            payload = message[message.index("{") :]
            stats, _ = json.JSONDecoder().raw_decode(payload)
            values = stats.get("stats", {})
            hits = sum(values.get("cache_hits", {}).get("counts", {}).values())
            misses = sum(values.get("cache_misses", {}).get("counts", {}).values())
            errors = sum(values.get("cache_errors", {}).get("counts", {}).values())
            total = hits + misses + errors
            record["sccache"] = {
                "requests": values.get("compile_requests"),
                "executed": values.get("requests_executed"),
                "hits": hits,
                "misses": misses,
                "errors": errors,
                "hit_ratio": hits / total if total else None,
                "write_errors": values.get("cache_write_errors"),
                "compile_fails": values.get("compile_fails"),
                "location": stats.get("cache_location"),
            }
        elif RUST_CACHE_HIT in message:
            record["rust_cache"] = "hit"
        elif any(marker in message for marker in RUST_CACHE_MISS):
            record["rust_cache"] = "miss"
        elif any(marker in message for marker in RUST_CACHE_ERROR):
            record["rust_cache"] = "error"
    return list(jobs.values())


def render_junit_markdown(summary, label, job_seconds=None, step_seconds=None,
                          job_name=None):
    """Render the JUnit execution-time table and its overhead note."""
    p50 = "n/a" if summary["p50"] is None else format_seconds(summary["p50"])
    p95 = "n/a" if summary["p95"] is None else format_seconds(summary["p95"])
    lines = [
        f"{label}: {summary['cases']} test(s), {summary['failures']} failure(s), "
        f"{summary['errors']} error(s), {summary['skipped']} skipped",
        f"Execution time: total {format_seconds(summary['seconds'])}, "
        f"p50 {p50}, p95 {p95}",
    ]
    if job_seconds is not None:
        source = f" (CI job {job_name!r})" if job_name else ""
        lines.append(
            f"Job wall clock {format_seconds(job_seconds)}{source}: checkout, "
            "toolchain, cache restore, and compilation dominate it (JUnit test "
            "cases run in parallel, so their summed time is not a wall-clock "
            "share)."
        )
    if step_seconds is not None:
        share = (
            f" ({step_seconds / job_seconds * 100:.0f} % of the job wall clock)"
            if job_seconds
            else ""
        )
        lines.append(
            f"Test step elapsed {format_seconds(step_seconds)}{share}; "
            "the step includes compilation, the JUnit total bounds test wall "
            "time from above (not in JUnit)."
        )
    lines.append("")
    lines.append("| Suite | Tests | Seconds |")
    lines.append("| --- | --- | --- |")
    for suite in sorted(summary["suites"], key=lambda item: item["seconds"], reverse=True):
        lines.append(f"| {suite['name']} | {suite['tests']} | {suite['seconds']:.1f} |")
    lines.append("")
    lines.append("| Slowest test | Seconds |")
    lines.append("| --- | --- |")
    for name, seconds in summary["slowest"]:
        lines.append(f"| {name} | {seconds:.1f} |")
    return "\n".join(lines)


def render_cache_markdown(records):
    """Render per-job sccache hit/miss and rust-cache restore evidence.

    The hit ratio divides by lookups, including backend cache errors: a job
    that hits whenever the backend answers but fails half its lookups must
    not read as highly cached.
    """
    lines = [
        "| Job | sccache requests | Hits | Misses | Errors | Hit ratio | rust-cache restore |",
        "| --- | --- | --- | --- | --- | --- | --- |",
    ]
    for record in sorted(records, key=lambda item: item["job"]):
        stats = record["sccache"]
        if stats is None:
            lines.append(
                f"| {record['job']} | n/a | n/a | n/a | n/a | n/a | "
                f"{record['rust_cache'] or 'n/a'} |"
            )
            continue
        ratio = (
            f"{stats['hit_ratio'] * 100:.0f} %"
            if stats["hit_ratio"] is not None
            else "n/a"
        )
        lines.append(
            f"| {record['job']} | {stats['executed']} | {stats['hits']} | "
            f"{stats['misses']} | {stats['errors']} | {ratio} | "
            f"{record['rust_cache'] or 'n/a'} |"
        )
    return "\n".join(lines)


def gh_json(arguments):
    """Run `gh` with `--json` output and decode the result."""
    result = subprocess.run(
        ["gh", *arguments],
        cwd=ROOT,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    return json.loads(result.stdout)


def read_snapshot(path):
    """Read a run snapshot: a JSON list of `gh run view` documents."""
    documents = json.loads(Path(path).read_text())
    if not isinstance(documents, list):
        raise ValueError(f"{path} must hold a JSON list of run documents")
    return documents


def document_key(document):
    """Cache key for one stored run document: `(databaseId, attempt)`.

    Reruns of the same run share a `databaseId`, and `gh run list` returns
    only the latest attempt, so keying by id alone silently swaps which
    attempt a `--attempts all` comparison measures.
    """
    return (document["databaseId"], document.get("attempt", 1) or 1)


def write_snapshot(path, documents):
    """Write a run snapshot, accumulating runs for offline re-measurement."""
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(documents, indent=1, sort_keys=True) + "\n")


def list_arguments(args, window=None):
    """Build the `gh run list` arguments for a fetch.

    Only run-level filters that hold for every attempt are passed server-side
    (workflow, event, branch, `--created` window), so `--limit` counts
    matching runs instead of truncating the sample before they apply.
    `--conclusion` is deliberately *not* sent as `gh --status`: `gh run list`
    reports the latest attempt's conclusion, so filtering there would drop a
    run whose first attempt succeeded and whose rerun failed before
    `filter_runs` ever gets to pick an attempt. The conclusion is applied
    locally, after the requested attempts are loaded.
    """
    arguments = []
    arguments += ["--workflow", WORKFLOW]
    if args.limit:
        arguments += ["--limit", str(args.limit)]
    if args.event:
        arguments += ["--event", args.event]
    if args.branch:
        arguments += ["--branch", args.branch]
    if window is not None:
        created = (
            f"{window[0].date().isoformat()}..{window[1].date().isoformat()}"
        )
        arguments += ["--created", created]
    return arguments


def wanted_attempts(latest, attempts):
    """Which attempt numbers of a run the current selection needs.

    `gh run list` reports only the latest attempt, so every other attempt has
    to be requested by number. `first` needs attempt 1 (the representative)
    plus the latest one, whose metadata is what the listing described; `all`
    needs the whole range, otherwise intermediate reruns of a run already on
    attempt 3 would silently be missing from the aggregates.
    """
    latest = latest or 1
    if attempts == "all":
        return list(range(1, latest + 1))
    return sorted({1, latest})


# What one fetch produced: the documents the current listing named, and
# whether `gh run list` returned exactly `--limit` entries, which means the
# server may have had more and the sample is a truncation, not a census.
Fetch = collections.namedtuple("Fetch", ("documents", "truncated"))


def list_documents(args, window=None):
    """Fetch the run documents the current `gh run list` names.

    The on-disk snapshot accumulates every document ever fetched, but only
    the ones this listing named are returned: a measurement must depend on
    the query, not on which unrelated runs happen to sit in the local cache,
    or the same command would report different medians on two machines.
    """
    cache_path = Path(args.cache)
    stored = read_snapshot(cache_path) if cache_path.exists() else []
    by_key = {document_key(document): document for document in stored}
    listed = gh_json(
        ["run", "list", *list_arguments(args, window), "--json", LIST_FIELDS]
    )
    selected = {}
    fetched = 0
    for entry in listed:
        # An unfinished run has no completed job timestamps to measure.
        if not entry.get("conclusion"):
            continue
        run_id = entry["databaseId"]
        latest = entry.get("attempt", 1) or 1
        view_command = ["run", "view", str(run_id), "--json", VIEW_FIELDS]
        for attempt in wanted_attempts(latest, args.attempts):
            document = by_key.get((run_id, attempt))
            if document is None:
                document = gh_json(view_command + ["--attempt", str(attempt)])
                by_key[document_key(document)] = document
                fetched += 1
            selected[document_key(document)] = document
    if fetched:
        write_snapshot(
            cache_path, sorted(by_key.values(), key=document_key)
        )
    return Fetch(list(selected.values()), bool(args.limit) and len(listed) >= args.limit)


# Run summaries for one window, plus whether `--limit` may have cut the
# sample short. A truncated window still renders, so the flag is what keeps
# a partial median from passing for a complete one.
Loaded = collections.namedtuple("Loaded", ("runs", "truncated"))


def load_run_summaries(args, window=None, with_steps=False):
    """Summaries from a snapshot, or from a fresh window-bounded fetch.

    `runs`/`compare` measure the CI workflow only. The fetch passes
    `--workflow ci.yml` to `gh`, and snapshots are filtered back by the
    stored `workflowName`, because tag Release runs also complete `CI`-named
    jobs but must never enter these medians. Snapshot documents written
    before `workflowName` was requested are treated as unknown-workflow and
    kept, so old caches keep reproducing the report until refetched.
    """
    if args.input:
        documents, truncated = read_snapshot(args.input), False
    else:
        documents, truncated = list_documents(args, window)
    summaries = []
    for document in documents:
        name = document.get("workflowName")
        if name is not None and name != "CI":
            continue
        summaries.append(summarize_run(document, with_steps))
    return Loaded(summaries, truncated)


def truncation_warning(label, window, limit):
    """Warn that `--limit` may have cut a window's sample short.

    `gh run list` returns the newest matching runs first, so a full result
    means the window may hold older runs that never reached the medians --
    a partial sample renders exactly like a complete one.
    """
    span = f"{window[0].date()}..{window[1].date()}"
    return (
        f"the {label} window {span} filled --limit {limit}, so it may be "
        "missing older runs; raise --limit until the count stops growing"
    )


def run_attempt_state(run_id):
    """The attempt number and conclusion `gh` currently reports for a run."""
    document = gh_json(
        ["run", "view", str(run_id), "--json", "attempt,conclusion"]
    )
    return document.get("attempt", 1) or 1, document.get("conclusion")


def load_run_log(run_id, log_cache, attempt=None):
    """Return the raw log of a run, caching it for offline re-measurement.

    A rerun keeps its run id, so the cache is keyed by attempt as well --
    otherwise `cache --run` would keep reporting the superseded attempt's
    hit/miss evidence. Only a finished run is cached: an in-progress run's
    log is partial, and a partial log kept on disk never repairs itself.
    """
    log_cache = Path(log_cache)
    if log_cache.exists():
        return log_cache.read_text()
    result = subprocess.run(
        ["gh", "run", "view", str(run_id), "--log"]
        + (["--attempt", str(attempt)] if attempt else []),
        cwd=ROOT,
        check=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    log_cache.parent.mkdir(parents=True, exist_ok=True)
    log_cache.write_text(result.stdout)
    return result.stdout


EPILOG = """\
Reproducing the numbers in docs/design/test-performance-report.md:

  scripts/ci-timings compare \\
      --baseline 2026-09-14..2026-09-16 --current 2026-09-20..2026-09-21 \\
      --event pull_request --conclusion success --runs
  scripts/ci-timings junit --label "tests (unit, fast)" --run RUN_ID \
      junit-unit.xml
  scripts/ci-timings cache --run 35564038269

Fetched run metadata accumulates in target/ci-timings/ci-runs.json. Without
--input every runs/compare invocation queries `gh` first; pass the snapshot as
--input to re-measure the same tables with no network calls. A measurement
covers exactly the runs its own query named, so a fuller cache never widens
it; --limit applies per window, and a window that fills it is reported as
possibly truncated.
"""


def add_selection_arguments(parser):
    """Add the run-selection flags shared by `runs` and `compare`."""
    parser.add_argument(
        "--input",
        help="run snapshot JSON (a list of `gh run view --json` documents)",
    )
    parser.add_argument(
        "--cache",
        default=str(DEFAULT_CACHE),
        help="snapshot that fetched documents accumulate into; a measurement "
        "uses only the runs its own query named",
    )
    parser.add_argument(
        "--limit",
        type=int,
        default=40,
        help="newest matching runs to fetch per window; a window that fills "
        "it is reported as possibly truncated",
    )
    parser.add_argument("--event", help="filter by run event")
    parser.add_argument(
        "--conclusion",
        choices=("success", "failure", "cancelled", "skipped"),
        help="filter by run conclusion (applied after attempt selection)",
    )
    parser.add_argument("--branch", help="filter by head branch")
    parser.add_argument(
        "--attempts",
        choices=("first", "all"),
        default="first",
        help="keep only first attempts (default) or every rerun attempt",
    )
    parser.add_argument("--json", action="store_true", help="emit JSON output")


def select_runs(runs, args, window=None):
    """Apply the shared selection flags, defaulting to the newest `--limit`."""
    selected = filter_runs(
        runs,
        window=window,
        event=args.event,
        conclusion=args.conclusion,
        branch=args.branch,
        attempts=args.attempts,
    )
    if window is None:
        fallback = datetime.datetime.min.replace(tzinfo=datetime.timezone.utc)
        return sorted(
            selected,
            key=lambda run: run["created_at"] if run["created_at"] else fallback,
            reverse=True,
        )[: args.limit]
    return selected


def runs_in_window(runs, window):
    """The runs whose creation time falls inside an inclusive date window."""
    start, end = window
    horizon = end + datetime.timedelta(days=1)
    return [
        run for run in runs
        if run["created_at"] and start <= run["created_at"] < horizon
    ]


# The branch a diagnosis came from, carried beside its text so a caller --
# or a test -- can identify the reasoning without matching on wording.
Diagnosis = collections.namedtuple("Diagnosis", ("branch", "message"))


def empty_window_diagnosis(args, loaded, window):
    """Why `window` selected no run, judged from the loaded runs themselves.

    Every branch is read off the data rather than assumed: a window the
    loaded runs never reached, one whose candidates a filter rejected, and
    one whose runs attempt selection dropped all need opposite advice.
    Filters are judged against the candidates `select_attempts` would hand
    `filter_runs`, never against a sibling attempt that was never in the
    running -- that sibling's mismatch is not what emptied the window.
    """
    present = runs_in_window(loaded, window)
    if not present:
        if args.input:
            return Diagnosis(
                "uncovered-snapshot",
                "the snapshot given to --input holds no run in it; drop "
                "--input to fetch the window, or ask for one it covers",
            )
        return Diagnosis(
            "uncovered-fetch",
            "no run was fetched for it; `gh run list` returns the newest "
            "matching runs first, so raise --limit, or widen the window",
        )
    candidates = runs_in_window(select_attempts(loaded, args.attempts), window)
    if not candidates:
        hint = (
            "; pass --attempts all to count the attempts that do"
            if args.attempts == "first" else ""
        )
        return Diagnosis(
            "no-candidates",
            f"{len(present)} run(s) fall inside it, but --attempts "
            f"{args.attempts} kept no attempt of theirs inside it{hint}",
        )
    blocking = [
        f"--{name} {value}"
        for name, value, field in (
            ("conclusion", args.conclusion, "conclusion"),
            ("event", args.event, "event"),
            ("branch", args.branch, "branch"),
        )
        if value and any(run.get(field) != value for run in candidates)
    ]
    if not blocking:
        # `candidates` is `filter_runs`' own post-window pool, so every
        # candidate passing every filter means `filter_runs` selected them
        # and nothing asked for a diagnosis. Reaching here means the two have
        # drifted apart, which must fail loudly rather than explain itself.
        span = f"{window[0].date()}..{window[1].date()}"
        raise RuntimeError(
            f"ci-timings invariant violated: every candidate in {span} passes "
            "every filter, so the selection cannot be empty -- "
            "select_attempts and filter_runs disagree"
        )
    # A non-candidate attempt that passes everything means attempt selection
    # is holding the answer, which is a narrower fix than relaxing a filter.
    # The `not in candidates` half cannot change the result while the
    # invariant above holds -- a candidate passing every filter would have
    # been selected -- and is kept so this stays correct on its own terms
    # rather than by appeal to a property enforced elsewhere.
    rescuable = [
        run for run in present
        if run not in candidates and run_passes_filters(run, args)
    ]
    note = (
        " (a later attempt of it does pass, so --attempts all would match)"
        if rescuable else ""
    )
    return Diagnosis(
        "blocking-with-rescue" if rescuable else "blocking",
        f"{len(candidates)} run(s) fall inside it, but none passed "
        f"{', '.join(blocking)}; relax them{note}",
    )


def selection_coverage_warning(args, window, loaded, selected):
    """Return a warning when no selected run falls inside `window`.

    `runs` selects nothing rather than failing, so this is `runs`' equivalent
    of the empty-window `ValueError` that `compare` raises.
    """
    if window is None:
        return None
    if runs_in_window(selected, window):
        return None
    span = f"{window[0].date()}..{window[1].date()}"
    return (
        f"no run matched the requested window {span}: "
        f"{empty_window_diagnosis(args, loaded, window).message}"
    )


def command_runs(args):
    window = parse_window(args.window) if args.window else None
    loaded = load_run_summaries(args, window)
    runs = loaded.runs
    selected = select_runs(runs, args, window)
    warnings = []
    if loaded.truncated and window is not None:
        warnings.append(truncation_warning("requested", window, args.limit))
    coverage = selection_coverage_warning(args, window, runs, selected)
    if coverage:
        warnings.append(coverage)
    if args.json:
        print(
            json.dumps(
                {"runs": selected, "summary": window_summary(selected)},
                default=json_default,
                indent=1,
            )
        )
    else:
        print(render_runs_markdown(selected))
    for warning in warnings:
        print(f"warning: {warning}", file=sys.stderr)
    return 0


def command_compare(args):
    baseline_window = parse_window(args.baseline)
    current_window = parse_window(args.current)
    # Each window is fetched under its own `--limit`; one combined span lets
    # the newer days exhaust the limit and silently halve the baseline.
    baseline_loaded = load_run_summaries(args, baseline_window)
    current_loaded = load_run_summaries(args, current_window)
    runs = baseline_loaded.runs + current_loaded.runs
    baseline = select_runs(baseline_loaded.runs, args, baseline_window)
    current = select_runs(current_loaded.runs, args, current_window)
    baseline_summary = window_summary(baseline)
    current_summary = window_summary(current)
    if not baseline_summary["runs"] or not current_summary["runs"]:
        empty = [
            f"{label} {spec}: "
            f"{empty_window_diagnosis(args, runs, window).message}"
            for label, spec, window, chosen in (
                ("baseline", args.baseline, baseline_window, baseline),
                ("current", args.current, current_window, current),
            )
            if not chosen
        ]
        raise ValueError(
            "both windows need at least one run; " + "; ".join(empty)
        )
    for label, loaded_window, window in (
        ("baseline", baseline_loaded, baseline_window),
        ("current", current_loaded, current_window),
    ):
        if loaded_window.truncated:
            print(
                f"warning: {truncation_warning(label, window, args.limit)}",
                file=sys.stderr,
            )
    rows = compare_windows(baseline_summary, current_summary)
    if args.json:
        print(
            json.dumps(
                {
                    "baseline": {"window": args.baseline, "summary": baseline_summary},
                    "current": {"window": args.current, "summary": current_summary},
                    "rows": rows,
                },
                default=json_default,
                indent=1,
            )
        )
        return 0
    print(render_compare_markdown(baseline_summary, current_summary, rows))
    if args.runs:
        print("")
        print(f"### Baseline runs ({args.baseline})")
        print("")
        print(render_runs_markdown(baseline))
        print("")
        print(f"### Current runs ({args.current})")
        print("")
        print(render_runs_markdown(current))
    return 0


def step_summary(runs, jobs=None):
    """p50/p90 per job and step name across a window of run summaries.

    Every step sample is an elapsed wall clock from `step_durations` handed
    over by `summarize_run(with_steps=True)`. `jobs` restricts the table to
    explicitly named jobs; a repeated `--job` keeps each name. Steps that
    were skipped are already gone from the summaries, so no extra filter
    here can resurrect them.
    """
    wanted = set(jobs) if jobs else None
    per_job = {}
    for run in runs:
        for job, steps in (run.get("steps") or {}).items():
            if wanted is not None and job not in wanted:
                continue
            for name, seconds in steps.items():
                per_job.setdefault(job, {}).setdefault(name, []).append(seconds)
    return {
        job: {
            name: {
                "p50": statistics.median(values),
                "p90": percentile(values, 0.90),
                "runs": len(values),
            }
            for name, values in steps.items()
        }
        for job, steps in sorted(per_job.items())
    }


def render_steps_markdown(run_count, summary):
    """Render the per-job, per-step median table."""
    lines = [
        f"Steps over {run_count} run(s)",
        "",
        "| Job | Step | p50 | p90 | Runs |",
        "| --- | --- | --- | --- | --- |",
    ]
    rows = [
        (job, name, step)
        for job, steps in sorted(summary.items())
        for name, step in sorted(steps.items())
    ]
    if not rows:
        lines.append("| (none) | (none) | n/a | n/a | 0 |")
    for job, name, step in rows:
        lines.append(
            f"| {job} | {name} | {format_seconds(step['p50'])} | "
            f"{format_seconds(step['p90'])} | {step['runs']} |"
        )
    return "\n".join(lines)


def command_steps(args):
    """Per-job, per-step medians over the shared run selection."""
    window = parse_window(args.window) if args.window else None
    loaded = load_run_summaries(args, window, with_steps=True)
    selected = select_runs(loaded.runs, args, window)
    warnings = []
    if loaded.truncated and window is not None:
        warnings.append(truncation_warning("requested", window, args.limit))
    coverage = selection_coverage_warning(args, window, loaded.runs, selected)
    if coverage:
        warnings.append(coverage)
    summary = step_summary(selected, jobs=args.job)
    if args.json:
        print(
            json.dumps(
                {"runs": len(selected), "summary": summary},
                default=json_default,
                indent=1,
            )
        )
    else:
        print(render_steps_markdown(len(selected), summary))
    for warning in warnings:
        print(f"warning: {warning}", file=sys.stderr)
    return 0



def json_default(value):
    """Serialize datetimes in `--json` output."""
    if isinstance(value, datetime.datetime):
        return value.isoformat()
    raise TypeError(f"cannot serialize {type(value).__name__}")


def select_junit_job(document, label=None, requested=None):
    """Pick the job whose test step pairs with the given JUnit artifact.

    Preference order: the explicitly requested job name, then a job whose
    name equals the artifact label. Guessing is only safe when the run has a
    single test-bearing job -- otherwise the default label (`JUnit`) would
    quietly pair the artifact with an unrelated shard and report plausible
    but false wall-clock numbers -- so an ambiguous run demands `--job`.
    """
    step_durations = junit_step_seconds(document)
    walls = job_seconds(document)
    candidates = [
        (name, walls.get(name), step_durations[name])
        for name in sorted(step_durations)
        if step_durations[name] is not None
    ]
    if not candidates:
        raise ValueError("no job in this run has a test-execution step")
    if requested is not None:
        for name, wall, step in candidates:
            if name == requested:
                return name, wall, step
        available = ", ".join(name for name, _, _ in candidates)
        raise ValueError(
            f"job {requested!r} not found or has no test step; available: {available}"
        )
    if label is not None:
        for name, wall, step in candidates:
            if name == label:
                return name, wall, step
    if len(candidates) > 1:
        available = ", ".join(name for name, _, _ in candidates)
        raise ValueError(
            "this run has several jobs with a test step; pass --job to say "
            f"which one the artifact came from: {available}"
        )
    name, wall, step = candidates[0]
    return name, wall, step


def command_junit(args):
    paths = [Path(path) for path in args.paths]
    missing = [str(path) for path in paths if not path.exists()]
    if missing:
        raise ValueError(f"missing JUnit file(s): {', '.join(missing)}")
    summary = parse_junit(paths, top=args.top)
    job_wall = args.job_seconds
    step_seconds = None
    matched_job = None
    if args.run:
        if job_wall is not None:
            raise ValueError("pass either --run or --job-seconds, not both")
        document = gh_json(["run", "view", str(args.run), "--json", VIEW_FIELDS])
        matched_job, job_wall, step_seconds = select_junit_job(
            document, label=args.label, requested=args.job
        )
    if args.json:
        payload = dict(summary)
        if matched_job is not None:
            payload["job"] = {
                "run": args.run,
                "name": matched_job,
                "wall_seconds": job_wall,
                "step_seconds": step_seconds,
            }
        print(json.dumps(payload, indent=1))
    else:
        print(
            render_junit_markdown(
                summary, args.label, job_seconds=job_wall,
                step_seconds=step_seconds, job_name=matched_job,
            )
        )
    return 0


def command_cache(args):
    if args.input and args.run:
        raise ValueError("pass either --run or --input, not both")
    if args.input:
        text = Path(args.input).read_text()
    elif args.run:
        attempt, conclusion = run_attempt_state(args.run)
        if not conclusion:
            raise ValueError(
                f"run {args.run} has not finished; its log is partial and the "
                "cache evidence would be incomplete"
            )
        log_cache = Path(
            args.log_cache
            or f"target/ci-timings/run-{args.run}-attempt-{attempt}.log"
        )
        if not log_cache.is_absolute():
            log_cache = ROOT / log_cache
        text = load_run_log(args.run, log_cache, attempt)
    else:
        raise ValueError("pass --run <id> or --input <saved-log>")
    records = parse_cache_log(text)
    if args.json:
        print(json.dumps(records, indent=1))
    else:
        print(render_cache_markdown(records))
    return 0


def build_parser():
    """Build the parser for the `runs`, `steps`, `compare`, `junit`, and
    `cache` modes."""
    parser = argparse.ArgumentParser(
        description=__doc__,
        epilog=EPILOG,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    runs = subparsers.add_parser("runs", help="per-run and per-job wall clock")
    add_selection_arguments(runs)
    runs.add_argument(
        "--window",
        default=None,
        help="inclusive START..END window of YYYY-MM-DD dates (default: newest runs)",
    )
    runs.set_defaults(handler=command_runs)

    steps = subparsers.add_parser(
        "steps", help="per-job step medians over the run-selection flags"
    )
    add_selection_arguments(steps)
    steps.add_argument(
        "--window",
        default=None,
        help="inclusive START..END window of YYYY-MM-DD dates (default: newest runs)",
    )
    steps.add_argument(
        "--job",
        action="append",
        default=None,
        help="limit the table to the named job(s); repeat --job to keep each",
    )
    steps.set_defaults(handler=command_steps)

    compare = subparsers.add_parser(
        "compare", help="before/after per-job medians for two windows"
    )
    add_selection_arguments(compare)
    compare.add_argument(
        "--baseline", default=REPORT_BASELINE, help="inclusive baseline START..END window"
    )
    compare.add_argument(
        "--current", default=REPORT_CURRENT, help="inclusive current START..END window"
    )
    compare.add_argument(
        "--runs", action="store_true", help="also print the per-run evidence tables"
    )
    compare.set_defaults(handler=command_compare)

    junit = subparsers.add_parser(
        "junit", help="JUnit execution-time summary (no compile/setup time)"
    )
    junit.add_argument("paths", nargs="+", help="JUnit XML file(s)")
    junit.add_argument("--label", default="JUnit", help="label for the summary header")
    junit.add_argument("--top", type=int, default=5, help="slowest tests to list")
    junit.add_argument(
        "--job-seconds",
        type=float,
        default=None,
        help="CI job wall clock, to separate test execution from compile/setup",
    )
    junit.add_argument(
        "--run",
        type=int,
        default=None,
        help="GitHub Actions run id: take job wall clock and the test-step "
        "elapsed time from its metadata instead of --job-seconds",
    )
    junit.add_argument(
        "--job",
        help="with --run: name of the CI job to pair the artifact with "
        "(default: the job whose name equals --label; required when several "
        "jobs have a test step and none of them matches --label)",
    )
    junit.add_argument("--json", action="store_true", help="emit JSON output")
    junit.set_defaults(handler=command_junit)

    cache = subparsers.add_parser(
        "cache", help="sccache and rust-cache hit evidence from a run log"
    )
    cache.add_argument("--run", help="GitHub Actions run id to read the log of")
    cache.add_argument("--input", help="saved raw log file instead of --run")
    cache.add_argument(
        "--log-cache", default=None,
        help="where to cache the downloaded run log (default: keyed by run "
        "and attempt, so a rerun does not read the superseded log)"
    )
    cache.add_argument("--json", action="store_true", help="emit JSON output")
    cache.set_defaults(handler=command_cache)
    return parser


# Credential shapes that can appear in a `gh` diagnostic: its own token
# formats, an Authorization header echoed from a failed request, and a token
# carried in a URL query. Redacted before the message is printed, because a
# secret that reaches a terminal or a CI log has to be rotated, not deleted.
SECRET_PATTERNS = (
    re.compile(r"\bgh[pousr]_[A-Za-z0-9]{16,}"),
    re.compile(r"\bgithub_pat_[A-Za-z0-9_]{16,}"),
    # `Authorization: Bearer <secret>` carries a scheme word before the
    # value, so the scheme is consumed explicitly; without that the pattern
    # would redact the word "Bearer" and print the secret after it.
    re.compile(r"(?i)\bbearer\s+\S+"),
    re.compile(r"(?i)\b(?:authorization|token)\b\s*[:=]\s*(?:bearer\s+)?\S+"),
    re.compile(r"(?i)[?&](?:access_token|token)=[^&\s]+"),
)


def redact_secrets(text):
    """Replace anything credential-shaped in `text` with a marker."""
    for pattern in SECRET_PATTERNS:
        text = pattern.sub("[redacted]", text)
    return text


def describe_error(error):
    """One line for a failed command, keeping `gh`'s own diagnosis.

    A `CalledProcessError` alone says only that the exit status was
    non-zero; the reason -- expired auth, missing log scope, a rate limit,
    no network -- is in the captured stderr, and without it the user has
    nothing to act on.
    """
    detail = getattr(error, "stderr", None)
    if not detail:
        return str(error)
    detail = redact_secrets(detail).strip()
    if not detail:
        return str(error)
    first = detail.splitlines()[0]
    return f"{error}: {first}"


def main(argv=None):
    """Run one measurement mode and return the process exit code."""
    args = build_parser().parse_args(argv)
    try:
        return args.handler(args)
    except (
        OSError,
        ValueError,
        json.JSONDecodeError,
        subprocess.CalledProcessError,
    ) as error:
        print(f"ci-timings: {describe_error(error)}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
