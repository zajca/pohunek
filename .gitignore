# Rust build artifacts
/target
**/*.rs.bk

# Cargo lockfile is committed for binaries (workspace produces binaries), so it
# is intentionally NOT ignored here.

# Local runtime/state produced by the daemon during manual testing.
/logs

# Local tool/runtime caches (per-machine; not shared)
/.cache

# TypeScript/Bun workspace artifacts. `bun.lock` is intentionally committed.
node_modules/
web/node_modules/
web/**/dist/
web/**/*.tsbuildinfo

# ts-rs default export directory; committed bindings live under web/shared.
crates/protocol/bindings/

# Local agent memory written by Claude Code subagents (per-machine; not shared)
/.claude/agent-memory

# Editor/OS noise
.DS_Store
*.swp
