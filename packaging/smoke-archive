archive=
stage=
consumer=
isolation=auto
requested=
while [ "$#" -gt 0 ]; do
    case $1 in
        --archive) [ "$#" -ge 2 ] || usage; archive=$2; shift 2 ;;
        --stage) [ "$#" -ge 2 ] || usage; stage=$2; shift 2 ;;
        --consumer) [ "$#" -ge 2 ] || usage; consumer=$2; shift 2 ;;
        --runtime)
            [ "$#" -ge 2 ] || usage
            safe_id "$2" || fail "invalid runtime id: $2"
            requested="$requested $2"
            shift 2
            ;;
        --isolation) [ "$#" -ge 2 ] || usage; isolation=$2; shift 2 ;;
        --isolation=*) isolation=${1#--isolation=}; shift ;;
        *) usage ;;
    esac
done
[ -n "$archive" ] && [ -n "$stage" ] && [ -n "$consumer" ] || usage
case $isolation in
    auto | userns | sudo | sandbox) ;;
    *) fail "--isolation must be auto, userns, sudo or sandbox" ;;
esac
uname_s=$(uname -s)
case $uname_s in
    Linux) ;;
    Darwin) ;;
    *) fail "unsupported OS: $uname_s (Linux and macOS are supported)" ;;
esac

# OS-specific tool checking
common_tools="tar jq awk sed find readlink comm sort uniq tr wc cat head iconv mktemp ps"
if [ "$uname_s" = Linux ]; then
    required_tools="$common_tools sha256sum unshare setsid mkfifo ip"
else
    # macOS
    required_tools="$common_tools shasum perl sandbox-exec"
fi
for tool in $required_tools; do
    command -v "$tool" >/dev/null 2>&1 || fail "required tool is missing: $tool"
done
# On either OS, prefer sha256sum if available, else shasum
if ! command -v sha256sum >/dev/null 2>&1; then
    command -v shasum >/dev/null 2>&1 || fail "neither sha256sum nor shasum is available"
fi
[ -f "$archive" ] && [ ! -L "$archive" ] || fail "archive is not a regular file: $archive"
[ -d "$stage" ] && [ ! -L "$stage" ] || fail "stage is not a directory: $stage"
[ -f "$consumer" ] && [ -x "$consumer" ] || fail "consumer is not an executable file: $consumer"
archive=$(cd "$(dirname -- "$archive")" && pwd -P)/$(basename -- "$archive")
stage=$(cd "$stage" && pwd -P)
consumer=$(cd "$(dirname -- "$consumer")" && pwd -P)/$(basename -- "$consumer")
self=$(cd "$(dirname -- "$0")" && pwd -P)/$(basename -- "$0")
checkout=$(cd "$(dirname -- "$self")/.." && pwd -P)

umask 022
uname_s=$(uname -s)
if [ "$uname_s" = Darwin ]; then
    work=$(mktemp -d /tmp/pks.XXXXXX)
else
    work=$(mktemp -d "${TMPDIR:-/tmp}/pks.XXXXXX")
fi
chmod 700 "$work"
work=$(cd "$work" && pwd -P)
check_dir=$work
sock_root=
host_probe=
host_probe_listener_pid=
host_probe_w_listener_pid=
if [ "$uname_s" = Darwin ]; then
    sock_root=$(mktemp -d /tmp/pk.XXXX) || fail "cannot create socket root directory"
    sock_root=$(cd "$sock_root" && pwd -P)
fi
ns_pid=
chosen=
tuser=
tuid=
tuser_created=
codex_dir=
cleanup() {
    status=$?
    trap '' EXIT
    # Wake the root watchdog explicitly: a stray inherited FIFO writer must
    # not keep it blocked after the outer shell closes its own descriptor.
    if [ -n "$ns_pid" ] && [ "$chosen" = sudo ]; then
        printf 'cancel\n' >&3 || true
    fi
    exec 3>&-
    if [ -n "$ns_pid" ]; then
        if [ "$chosen" != sudo ]; then
            # Signal the private group before reaping its leader, so its ID
            # cannot be reused for an unrelated process group.
            /bin/kill -KILL -- "-$ns_pid" 2>/dev/null || kill -KILL "$ns_pid" 2>/dev/null || true
        fi
        wait "$ns_pid" 2>/dev/null || true
    fi
    # macOS: the consumer runs in its own session (setsid) inside the sandbox,
    # so killing the sandbox shell does not reach it; kill each live session
    # recorded by the inner shell before the temp tree goes away.
    if [ "$chosen" = sandbox ]; then
        for pidfile in "$work"/run/.stray_*.pid; do
            [ -f "$pidfile" ] || continue
            sid=$(cat -- "$pidfile" 2>/dev/null) || continue
            case $sid in '' | *[!0-9]*) continue ;; esac
            /bin/kill -KILL -- "-$sid" 2>/dev/null || true
        done
    fi
    # Kill the host_probe listeners if they were started.
    if [ -n "$host_probe_listener_pid" ]; then
        /bin/kill "$host_probe_listener_pid" 2>/dev/null || true
    fi
    if [ -n "$host_probe_w_listener_pid" ]; then
        /bin/kill "$host_probe_w_listener_pid" 2>/dev/null || true
    fi
    # Darwin throwaway user cleanup
    if [ -n "$tuser_created" ]; then
        /usr/bin/sudo -n /usr/bin/pkill -KILL -U "$tuid" 2>/dev/null || true
        poll=0
        while /usr/bin/pgrep -U "$tuid" >/dev/null 2>&1 && [ "$poll" -lt 50 ]; do
            sleep 0.1
            poll=$((poll + 1))
        done
        if /usr/bin/pgrep -U "$tuid" >/dev/null 2>&1; then
            printf 'smoke-archive: processes of %s survived cleanup\n' "$tuser" >&2
            status=1
        fi
        case $tuid in
            '' | *[!0-9]*) ;;
            *)
                /usr/bin/sudo -n /bin/rm -rf -- "/private/tmp/codex-daemon-$tuid" "/private/tmp/pohunek-$tuid" || true
                [ -e "/private/tmp/codex-daemon-$tuid" ] && { printf 'smoke-archive: /private/tmp/codex-daemon-%s still exists\n' "$tuid" >&2; status=1; }
                [ -e "/private/tmp/pohunek-$tuid" ] && { printf 'smoke-archive: /private/tmp/pohunek-%s still exists\n' "$tuid" >&2; status=1; }
                ;;
        esac
        /usr/bin/sudo -n /usr/bin/dscl . -delete "/Users/$tuser" 2>/dev/null || true
        if /usr/bin/dscl . -read "/Users/$tuser" >/dev/null 2>&1; then
            printf 'smoke-archive: throwaway user %s still exists\n' "$tuser" >&2
            status=1
        fi
    fi
    if [ -n "$tuser_created" ]; then
        case $work in
            /private/tmp/pks.*) /usr/bin/sudo -n /bin/rm -rf -- "$work" || true ;;
            *) printf 'smoke-archive: refusing to remove %s\n' "$work" >&2; status=1 ;;
        esac
    else
        rm -rf -- "$work"
    fi
    if [ -n "$sock_root" ]; then
        if [ -n "$tuser_created" ]; then
            case $sock_root in
                /private/tmp/pk.*) /usr/bin/sudo -n /bin/rm -rf -- "$sock_root" || true ;;
                *) printf 'smoke-archive: refusing to remove %s\n' "$sock_root" >&2; status=1 ;;
            esac
        else
            rm -rf -- "$sock_root"
        fi
    fi
    if [ -n "$host_probe" ]; then
        rm -rf -- "$host_probe"
    fi
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Nothing the daemon, worker, CLI or upstream sees may lie in the checkout.
for path in "$stage" "$work"; do
    case $path in
        "$checkout" | "$checkout"/*) fail "$path lies inside the checkout $checkout" ;;
    esac
done

# --- extraction --------------------------------------------------------------
tar -tvzf "$archive" > "$work/members-long.txt" 2>/dev/null || fail "cannot list the archive: $archive"
tar -tzf "$archive" > "$work/members.txt" 2>/dev/null || fail "cannot list the archive: $archive"
[ -s "$work/members.txt" ] || fail "the archive is empty"
while IFS= read -r line; do
    case $line in
        -* | d*) ;;
        *) fail "the archive holds a link or special member: $line" ;;
    esac
done < "$work/members-long.txt"
top=
while IFS= read -r member; do
    case $member in
        '' | /* | ../* | */../* | */.. | .. | ./* | */./* | *//* | *[!A-Za-z0-9._+@=,/-]*)
            fail "the archive holds an unsafe member path: $member"
            ;;
    esac
    first=${member%%/*}
    if [ -z "$top" ]; then
        top=$first
    elif [ "$first" != "$top" ]; then
        fail "the archive has more than one top-level entry: $first"
    fi
done < "$work/members.txt"
mkdir "$work/archive"
tar -xzf "$archive" -C "$work/archive" --no-same-owner 2>/dev/null || fail "cannot extract the archive"
root=$work/archive/$top
[ -d "$root" ] && [ ! -L "$root" ] || fail "the archive has no top-level directory"
unsafe=$(find "$root" ! -type f ! -type d -print | head -n 1)
[ -z "$unsafe" ] || fail "the extracted archive holds a link or special file: $unsafe"

# --- archive checks ----------------------------------------------------------
for member in MANIFEST packaging/verify-archive runtime-catalog-anchor.json runtime/runtime-catalog.json $binaries; do
    [ -f "$root/$member" ] || fail "the archive lacks $member"
done
"$root/packaging/verify-archive" "$root" daemon $binaries >/dev/null \
    || fail "the archive's own verify-archive refused the archive"
if [ "$uname_s" = Darwin ]; then
    script_dir=$(cd "$(dirname -- "$self")" && pwd -P)
    "$script_dir/macos/verify-signed" --adhoc "$root" >/dev/null \
        || fail "the archive's ad-hoc signatures could not be verified"
fi
manifest_covers() {
    grep -q "^sha256 [0-9a-f]\{64\} $1\$" "$root/MANIFEST" || fail "MANIFEST does not cover $1"
}
manifest_covers runtime/runtime-catalog.json

shipped=
for package in "$root"/runtime/packages/*.tar.zst; do
    [ -f "$package" ] || continue
    rt=$(basename -- "$package" .tar.zst)
    safe_id "$rt" || fail "invalid runtime package name: $package"
    manifest_covers "runtime/packages/$rt.tar.zst"
    shipped="$shipped $rt"
done
[ -n "$shipped" ] || fail "the archive ships no runtime package"
if [ -z "$requested" ]; then
    runtimes=$shipped
else
    runtimes=
    for rt in $requested; do
        case " $shipped " in
            *" $rt "*) runtimes="$runtimes $rt" ;;
            *) fail "runtime $rt is not shipped by the archive (shipped:$shipped)" ;;
        esac
    done
fi
for rt in $runtimes; do
    [ -d "$stage/$rt" ] && [ ! -L "$stage/$rt" ] \
        || fail "no staged upstream for the shipped package $rt: $stage/$rt"
done

expected_digest() {
    jq -r --arg rt "$1" '[.catalog.entries[] | select(.runtime_id == $rt)] | if length == 1 then .[0].digest else empty end' \
        "$root/runtime/runtime-catalog.json" || fail "cannot read the catalog"
}
for rt in $runtimes; do
    digest=$(expected_digest "$rt")
    case $digest in
        sha256:????????????????????????????????????????????????????????????????) ;;
        *) fail "the catalog has no single entry with a digest for runtime $rt" ;;
    esac
    [ "$digest" = "sha256:$(sha256_digest "$root/runtime/packages/$rt.tar.zst")" ] \
        || fail "the shipped package of $rt does not match its catalog digest"
done
expected_binary_sha() {
    sha256_digest "$root/$1"
}

# --- namespace ---------------------------------------------------------------
cp -- "$consumer" "$work/consumer"
chmod 755 "$work/consumer"
node_bin=$(command -v node) || fail "node is required on PATH (the upstreams are node programs)"
node_dir=$(cd "$(dirname -- "$node_bin")" && pwd -P)
if [ "$(uname -s)" = Linux ]; then
    node_real=$(readlink -f -- "$node_bin") || fail "cannot resolve node on PATH: $node_bin"
    [ -f "$node_real" ] && [ -x "$node_real" ] || fail "node on PATH is not an executable file: $node_bin"
else
    # macOS: node is pinned in compat/matrix.json and installed via actions/setup-node
    node_real="$node_bin"
fi
for path in "$node_dir" "$node_real"; do
    case $path in
        "$checkout" | "$checkout"/*) fail "node on PATH resolves inside the checkout $checkout: $path" ;;
    esac
done
uid=$(id -u)
gid=$(id -g)
mkdir "$work/run"

# Namespace setup and stage verification must never resolve tools through the
# caller's PATH, which may include writable directories populated by npm.
root_path=/usr/sbin:/usr/bin:/sbin:/bin

# macOS: validate every staged upstream before the throwaway user is created,
# so validation needs no sudo and fails exactly as inside the isolated run.
# The isolated run validates again before it executes anything.
if [ "$uname_s" = Darwin ]; then
    ( PATH=$root_path; for rt in $runtimes; do stage_check "$stage/$rt"; done ) || exit 1
fi

run_userns() {
    exec /usr/bin/setsid /usr/bin/env -i PATH="$root_path" /usr/bin/unshare --user --map-root-user --net --pid --fork --kill-child --mount-proc \
        /bin/sh "$self" __inner userns "$work" "$root" "$stage" "$work/consumer" "$node_dir" "" "" $runtimes
}
run_sudo() {
    exec /usr/bin/setsid /usr/bin/sudo -n /usr/bin/env -i PATH="$root_path" \
        /usr/bin/setsid --wait /bin/sh "$self" __sudo_supervisor "$uid" "$gid" "$work/sudo-cancel" "$work" "$root" "$stage" "$work/consumer" "$node_dir" "" "" $runtimes 3>&-
}
run_sandbox() {
    # Generate the sandbox profile with the canonical temp root path.
    # Refuse work paths containing " or \ which could break the profile.
    case $work in
        *'"'*) fail "temp root contains quote: $work" ;;
        *'\\'*) fail "temp root contains backslash: $work" ;;
    esac
    case $sock_root in
        *'"'*) fail "socket root contains quote: $sock_root" ;;
        *'\\'*) fail "socket root contains backslash: $sock_root" ;;
    esac
    case $codex_dir in
        *'"'*) fail "codex directory contains quote: $codex_dir" ;;
        *'\\'*) fail "codex directory contains backslash: $codex_dir" ;;
    esac
    profile=$(printf '%s\n' \
        '(version 1)' \
        '(allow default)' \
        '(deny network*)' \
        '(allow network* (remote ip "localhost:*"))' \
        '(allow network-bind (local ip "localhost:*"))' \
        '(allow network-inbound (local ip "localhost:*"))' \
        "(allow network* (remote unix-socket (subpath \"$sock_root\")))" \
        "(allow network-bind (local unix-socket (subpath \"$sock_root\")))" \
        "(allow network* (remote unix-socket (subpath \"$work\")))" \
        "(allow network-bind (local unix-socket (subpath \"$work\")))" \
        "(allow network* (remote unix-socket (subpath \"$codex_dir\")))" \
        "(allow network-bind (local unix-socket (subpath \"$codex_dir\")))" \
        '(allow process-exec* (literal "/bin/ps") (with no-sandbox))')
    # Unix sockets are local IPC, not egress. The socket paths for smoke's own
    # roots (sock_root and work) and the throwaway user's codex directory
    # (codex_dir) are narrowed to subpaths only, so the smoke cannot reach
    # unrelated host sockets. Codex binds its app-server socket under
    # /private/tmp/codex-daemon-<uid>, and that directory is unique to the
    # throwaway uid. The real user's sockets are unreachable by permissions
    # as well as by the profile. /bin/ps is setuid, so the sandbox cannot
    # exec it; it runs unsandboxed as a fixed read-only system tool so the
    # test-support worker-leak check can read the process table; egress
    # stays denied. DNS (/private/var/run/mDNSResponder) stays denied.
    cd /
    [ -n "$tuser" ] || fail "no throwaway user; refusing to run the macOS smoke as the invoking user"
    exec /usr/bin/sudo -n -u "$tuser" /usr/bin/sandbox-exec -p "$profile" /usr/bin/env -i PATH="$root_path" /bin/sh "$work/smoke-archive" __inner sandbox "$work" "$root" "$stage" "$work/consumer" "$node_dir" "$sock_root" "$host_probe" $runtimes
}
probe_userns() {
    /usr/bin/env -i PATH="$root_path" /usr/bin/unshare --user --map-root-user --net --pid --fork --kill-child --mount-proc /usr/bin/true >/dev/null 2>&1
}
probe_sudo() {
    [ -x /usr/bin/sudo ] && [ -x /usr/bin/unshare ] && [ -x /usr/bin/setpriv ] \
        && /usr/bin/sudo -n /usr/bin/env -i PATH="$root_path" /usr/bin/unshare \
            --net --pid --fork --kill-child --mount-proc true >/dev/null 2>&1
}
probe_sandbox() {
    /usr/bin/sandbox-exec -p '(version 1)(allow default)(deny network*)' /usr/bin/true >/dev/null 2>&1
}
probe_darwin_sudo() {
    [ -x /usr/bin/sudo ] && [ -x /usr/bin/dscl ] && /usr/bin/sudo -n /usr/bin/true >/dev/null 2>&1
}

chosen=$isolation
if [ "$chosen" = auto ]; then
    if [ "$uname_s" = Darwin ]; then
        if probe_sandbox; then
            chosen=sandbox
        else
            fail "sandbox-exec isolation is not available on this macOS system"
        fi
    else
        if probe_userns; then
            chosen=userns
        elif probe_sudo; then
            chosen=sudo
        else
            fail "no network isolation is available: unprivileged user namespaces are denied and 'sudo -n unshare' does not work; refusing to run un-isolated"
        fi
    fi
fi
echo "smoke-archive: isolation $chosen, runtimes:$runtimes"
case $chosen in
    userns) probe_userns || fail "isolation userns is not available on this host" ;;
    sudo) probe_sudo || fail "isolation sudo is not available on this host" ;;
    sandbox) probe_sandbox || fail "isolation sandbox is not available on this host" ;;
    *) fail "unknown isolation strategy: $chosen" ;;
esac
if [ "$chosen" = sandbox ]; then
    if [ "$uname_s" = Darwin ]; then
        probe_darwin_sudo || fail "the macOS smoke runs the consumer as a throwaway local user and needs passwordless sudo (sudo -n) to create it; refusing to run as the invoking user"
        create_throwaway_user
    fi
fi
if [ "$chosen" = sudo ]; then
    /usr/bin/mkfifo "$work/sudo-cancel"
    exec 3<> "$work/sudo-cancel"
fi

# Darwin sandbox: set up two host unix sockets outside the permitted roots to
# verify the sandbox cannot reach them. Socket s (mode 0755) proves that file
# permissions isolate the invoking user's sockets. Socket w (mode 0777) proves
# that the sandbox profile itself denies unix sockets, independently of permissions.
if [ "$chosen" = sandbox ]; then
    host_probe=$(mktemp -d /tmp/pkh.XXXX) || fail "cannot create host probe directory"
    host_probe=$(cd "$host_probe" && pwd -P)
    chmod 711 "$host_probe" || fail "cannot chmod host probe directory"
    /usr/bin/nc -lkU "$host_probe/s" >/dev/null 2>&1 &
    host_probe_listener_pid=$!
    /usr/bin/nc -lkU "$host_probe/w" >/dev/null 2>&1 &
    host_probe_w_listener_pid=$!
    # Wait for both sockets to be created before entering the sandbox.
    n=0
    while ([ ! -S "$host_probe/s" ] || [ ! -S "$host_probe/w" ]) && [ "$n" -lt 50 ]; do
        sleep 0.01
        n=$((n + 1))
    done
    [ -S "$host_probe/s" ] || fail "failed to create host probe socket: $host_probe/s"
    [ -S "$host_probe/w" ] || fail "failed to create host probe socket: $host_probe/w"
    chmod 755 "$host_probe/s" || fail "cannot chmod host probe socket s"
    chmod 777 "$host_probe/w" || fail "cannot chmod host probe socket w"
    if [ "$uname_s" = Darwin ] && [ -n "$tuser" ]; then
        chmod 711 "$work"
        cp -- "$self" "$work/smoke-archive"
        chmod 755 "$work/smoke-archive"
        mkdir -p "$work/t"
        /usr/bin/sudo -n /usr/sbin/chown -R "$tuser" "$work/run" "$work/t" "$sock_root" || fail "cannot set permissions for the throwaway user"
        output=$(/usr/bin/sudo -n -u "$tuser" /bin/sh -c 'for p do [ -r "$p" ] && [ -x "$p" ] || { printf "%s\n" "$p"; exit 1; }; done' sh "$root" "$stage" "$node_dir" "$node_bin" "$work/consumer" "$work/smoke-archive" 2>&1) && preflight_status=0 || preflight_status=$?
        if [ "$preflight_status" -ne 0 ]; then
            fail "the throwaway user cannot read and enter: $(printf '%s\n' "$output" | head -n 1)"
        fi
        # Verify the throwaway user can traverse the entire stage tree for each runtime
        for rt in $runtimes; do
            output=$(/usr/bin/sudo -n -u "$tuser" /bin/sh -c '
                [ -r "$1" ] && [ -x "$1" ] || { printf "stage dir not readable/executable: %s\n" "$1"; exit 1; }
                [ -r "$2" ] && [ -f "$2" ] || { printf "STAGE.sha256 not readable: %s\n" "$2"; exit 1; }
                [ -r "$3" ] && [ -f "$3" ] || { printf "STAGE.links not readable: %s\n" "$3"; exit 1; }
                /usr/bin/find "$1" -print >/dev/null 2>&1 || { printf "find failed in stage: %s\n" "$1"; exit 1; }
            ' sh "$stage/$rt" "$stage/$rt/STAGE.sha256" "$stage/$rt/STAGE.links" 2>&1) && stage_status=0 || stage_status=$?
            if [ "$stage_status" -ne 0 ]; then
                fail "the throwaway user cannot read the staged upstream $stage/$rt: $(printf '%s\n' "$output" | head -n 1); the caller must make the stage readable by other users (scripts/release-workflow/run-smoke does chmod -R go+rX on macOS)"
            fi
        done
        [ -S "$host_probe/s" ] || fail "host probe socket is missing"
        [ -S "$host_probe/w" ] || fail "host probe socket is missing"
        if /usr/bin/sudo -n -u "$tuser" /usr/bin/nc -U -w 2 "$host_probe/s" </dev/null >/dev/null 2>&1; then
            fail "the throwaway user reaches a socket of the invoking user"
        fi
        if ! printf x | /usr/bin/sudo -n -u "$tuser" /usr/bin/nc -U -w 2 "$host_probe/w" >/dev/null 2>&1; then
            fail "the throwaway user cannot reach the world-connectable probe socket outside the sandbox; the sandbox probe would prove nothing"
        fi
        [ -S "$host_probe/s" ] || fail "the host probe listener exited"
        [ -S "$host_probe/w" ] || fail "the host probe listener exited"
        /bin/kill -0 "$host_probe_listener_pid" 2>/dev/null || fail "the host probe listener exited"
        /bin/kill -0 "$host_probe_w_listener_pid" 2>/dev/null || fail "the host probe listener exited"
    fi
fi

# The namespace runs in the background so a signal reaches the trap at once.
"run_$chosen" &
ns_pid=$!
ns_status=0
wait "$ns_pid" || ns_status=$?
ns_pid=
[ "$ns_status" -eq 0 ] || fail "the isolated run failed (exit $ns_status)"

# --- reports -----------------------------------------------------------------
for rt in $runtimes; do
    report=$work/run/$rt/report.json
    [ -f "$report" ] || fail "no consumer report for runtime $rt"
    jq -e --arg rt "$rt" --arg digest "$(expected_digest "$rt")" \
        --arg a "$(expected_binary_sha pohunek)" \
        --arg b "$(expected_binary_sha pohunekd)" \
        --arg c "$(expected_binary_sha pohunek-sessiond)" \
        '.schema == 1 and .runtime == $rt and .package_digest == $digest
         and (.executables | keys) == ["pohunek", "pohunek-sessiond", "pohunekd"]
         and .executables.pohunek == $a and .executables.pohunekd == $b
         and .executables["pohunek-sessiond"] == $c' "$report" >/dev/null \
        || fail "the consumer report for $rt does not match the archive's catalog digest and binaries"
    upstream=$(jq -r '.upstream_version' "$report")
    echo "smoke-archive: $rt ok (upstream $upstream, package $(expected_digest "$rt"))"
done
echo "smoke-archive: all runtimes passed"
