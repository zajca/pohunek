#!/bin/sh
# Network-isolated smoke of a final release daemon archive.
#
# usage: smoke-archive --archive <pohunek-daemon-...tar.gz> --stage <dir>
#                      --consumer <release-consumer-test-executable>
#                      [--runtime <id>]... [--isolation auto|userns|sudo|sandbox]
#
# Proves that the archive alone - its binaries, its signed catalog and trust
# anchor, its runtime packages - installs and serves every official runtime
# through the real upstream, with no network and no source tree:
#
#   1. extracts the archive into a fresh private temp directory after refusing
#      absolute, `..`, link and special members, and runs the archive's own
#      `packaging/verify-archive` on the unpacked tree; on macOS, also verifies
#      ad-hoc signatures with `packaging/macos/verify-signed --adhoc`;
#   2. derives the runtimes from `runtime/packages/*.tar.zst` (the set is data;
#      `--runtime` only restricts it) and requires a staged upstream
#      `<stage>/<runtime>/` for every one of them (a missing stage fails);
#   3. enters a fresh isolated environment (network namespace on Linux,
#      sandbox-exec on macOS), brings loopback up, asserts that loopback is
#      the only interface and that no default route exists, and re-verifies
#      every stage against STAGE.sha256 and STAGE.links using POSIX tools only;
#   4. runs the prebuilt consumer test executable once per runtime with
#      PATH = `<stage>/<runtime>/bin` + the system node and tool directories,
#      a hermetic HOME/XDG tree, a temp working directory and only the
#      `POHUNEK_CONSUMER_*` contract variables, pointing into the extracted
#      archive (`POHUNEK_CONSUMER_CATALOG` selects smoke mode, so the archive's
#      own signed catalog and anchor are the trust);
#   5. checks every consumer report against the archive: `package_digest` equals
#      the catalog entry's digest (and the package file's bytes) and
#      `executables` equal the SHA-256 of the archive's binaries.
#
# Isolation strategies (`--isolation`, default auto picks the first that works):
#   userns  `unshare --user --map-root-user --net --pid` (Linux only): needs
#           unprivileged user namespaces (Ubuntu 24.04 blocks them through
#           AppArmor unless `kernel.apparmor_restrict_unprivileged_userns=0`).
#   sudo    `sudo -n unshare --net --pid` (Linux only), loopback brought up as
#           root, then the invoking uid/gid is restored with `setpriv` before
#           anything else runs, with all capabilities dropped.
#   sandbox `/usr/bin/sandbox-exec` with a profile denying egress (macOS only).
#           On macOS, the smoke runs the consumer as a throwaway local user
#           created with passwordless sudo; it fails closed without sudo. Codex's
#           socket directory is unique to that user; the user and its leftovers
#           are removed and verified on exit.
# When no suitable strategy is available the script fails; there is no
# un-isolated fallback.
#
# This script comes from the checkout and runs outside the namespace/sandbox up
# to step 3. "No source-tree path" is about everything the daemon, worker, CLI
# and upstream see: the archive, stage and temp paths are refused when they lie
# inside the checkout, and the consumer executable is copied to the temp
# directory and run from there. Linux and macOS (util-linux unshare/iproute2 on
# Linux, sandbox-exec on macOS, jq on both).

set -eu

# Name of the consumer test selected from the prebuilt executable; it is the
# one real out-of-process test of crates/cli/tests/release_consumer.rs.
consumer_test=the_release_binaries_serve_the_runtime_out_of_process
# The executables a daemon archive ships and the consumer report hashes.
binaries="pohunek pohunekd pohunek-sessiond"

fail() {
    printf 'smoke-archive: %s\n' "$*" >&2
    exit 1
}

usage() {
    echo "usage: smoke-archive --archive <daemon.tar.gz> --stage <dir> --consumer <executable> [--runtime <id>]... [--isolation auto|userns|sudo|sandbox]" >&2
    exit 2
}

# Helper to compute SHA-256. Uses sha256sum when available, else shasum -a 256.
sha256_digest() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum -- "$1" | cut -d' ' -f1
    else
        shasum -a 256 -- "$1" | cut -d' ' -f1
    fi
}

safe_id() {
    case $1 in
        '' | *[!a-z0-9._-]*) return 1 ;;
    esac
}

safe_stage_path() {
    case $1 in
        '' | /* | */ | *//* | . | .. | ./* | ../* | */./* | */../* | */. | */..) return 1 ;;
    esac
    return 0
}

safe_stage_target() {
    [ -n "$1" ] || return 1
    case $1 in /*) return 1 ;; esac
    target_rest=$1
    target_depth=$2
    while :; do
        component=${target_rest%%/*}
        case $component in
            '' | .) ;;
            ..)
                [ "$target_depth" -gt 0 ] || return 1
                target_depth=$((target_depth - 1))
                ;;
            *) target_depth=$((target_depth + 1)) ;;
        esac
        [ "$target_rest" != "$component" ] || break
        target_rest=${target_rest#*/}
    done
}

# ---------------------------------------------------------------------------
# Inner half: runs inside the network and PID namespaces.
# ---------------------------------------------------------------------------

stage_check() {
    stage_dir=$1
    [ -d "$stage_dir" ] && [ ! -L "$stage_dir" ] || fail "staged upstream is not a directory: $stage_dir"
    for manifest in STAGE.sha256 STAGE.links; do
        [ -f "$stage_dir/$manifest" ] && [ ! -L "$stage_dir/$manifest" ] \
            || fail "staged upstream has no regular $manifest: $stage_dir"
        iconv -f UTF-8 -t UTF-8 "$stage_dir/$manifest" >/dev/null \
            || fail "staged upstream has invalid UTF-8 in $manifest: $stage_dir"
        case $manifest in
            STAGE.sha256) allowed_controls='\012' ;;
            STAGE.links) allowed_controls='\011\012' ;;
        esac
        [ "$(LC_ALL=C tr -cd '[:cntrl:]\\' < "$stage_dir/$manifest" | LC_ALL=C tr -d "$allowed_controls" | wc -c)" -eq 0 ] \
            || fail "staged upstream has a control character or backslash in $manifest: $stage_dir"
        if [ "$manifest" = STAGE.links ]; then
            LC_ALL=C tr -d '\011' < "$stage_dir/$manifest" > "$check_dir/stage-text-check.txt"
        else
            cp -- "$stage_dir/$manifest" "$check_dir/stage-text-check.txt"
        fi
        if LC_ALL=C.UTF-8 grep -q '[[:cntrl:]]' "$check_dir/stage-text-check.txt"; then
            fail "staged upstream has a Unicode control character in $manifest: $stage_dir"
        else
            control_status=$?
            [ "$control_status" -eq 1 ] || fail "cannot check Unicode controls in $manifest: $stage_dir"
        fi
    done
    : > "$check_dir/stage-files.txt"
    : > "$check_dir/stage-links.txt"
    : > "$check_dir/stage-execs.txt"
    while :; do
        line=
        if IFS= read -r line; then
            :
        else
            [ -z "$line" ] || fail "staged upstream has an unterminated STAGE.sha256 entry: $stage_dir"
            break
        fi
        digest=${line%%  *}
        path=${line#"$digest  "}
        [ "$line" = "$digest  $path" ] && [ "${#digest}" -eq 64 ] \
            || fail "staged upstream has an invalid STAGE.sha256 entry: $stage_dir"
        case $digest in
            *[!0-9a-f]*) fail "staged upstream has an invalid STAGE.sha256 digest: $stage_dir" ;;
        esac
        safe_stage_path "$path" || fail "staged upstream has an unsafe STAGE.sha256 path: $stage_dir"
        printf '%s\n' "$path" >> "$check_dir/stage-files.txt"
    done < "$stage_dir/STAGE.sha256"
    tab=$(printf '\t')
    while :; do
        line=
        if IFS= read -r line; then
            :
        else
            [ -z "$line" ] || fail "staged upstream has an unterminated STAGE.links entry: $stage_dir"
            break
        fi
        case $line in
            "exec$tab"*)
                path=${line#"exec$tab"}
                case $path in
                    *"$tab"*) fail "staged upstream has an invalid STAGE.links entry: $stage_dir" ;;
                esac
                safe_stage_path "$path" \
                    || fail "staged upstream has an invalid STAGE.links exec path: $stage_dir/$path"
                printf '%s\n' "$path" >> "$check_dir/stage-execs.txt"
                ;;
            "link$tab"*)
                rest=${line#"link$tab"}
                case $rest in
                    *"$tab"*) ;;
                    *) fail "staged upstream has an invalid STAGE.links entry: $stage_dir" ;;
                esac
                path=${rest%%"$tab"*}
                target=${rest#*"$tab"}
                case $target in
                    *"$tab"*) fail "staged upstream has an invalid STAGE.links entry: $stage_dir" ;;
                esac
                link_parent=$path
                link_depth=0
                while :; do
                    case $link_parent in
                        */*) link_parent=${link_parent#*/}; link_depth=$((link_depth + 1)) ;;
                        *) break ;;
                    esac
                done
                safe_stage_path "$path" && safe_stage_target "$target" "$link_depth" \
                    || fail "staged upstream has an invalid STAGE.links link path or target: $stage_dir/$path"
                printf '%s\n' "$path" >> "$check_dir/stage-links.txt"
                ;;
            *) fail "staged upstream has an invalid STAGE.links entry: $stage_dir" ;;
        esac
    done < "$stage_dir/STAGE.links"
    for kind in files links execs; do
        LC_ALL=C sort "$check_dir/stage-$kind.txt" > "$check_dir/stage-$kind-sorted.txt"
        duplicate=$(LC_ALL=C uniq -d "$check_dir/stage-$kind-sorted.txt" | head -n 1)
        case $kind in
            files) kind_name=STAGE.sha256 ;;
            links) kind_name='STAGE.links link' ;;
            execs) kind_name='STAGE.links exec' ;;
        esac
        [ -z "$duplicate" ] || fail "staged upstream has a duplicate $kind_name path: $stage_dir/$duplicate"
    done
    unknown_exec=$(LC_ALL=C comm -23 "$check_dir/stage-execs-sorted.txt" "$check_dir/stage-files-sorted.txt" | head -n 1)
    [ -z "$unknown_exec" ] || fail "staged upstream has an invalid STAGE.links exec path: $stage_dir/$unknown_exec"
    conflicting_link=$(LC_ALL=C comm -12 "$check_dir/stage-links-sorted.txt" "$check_dir/stage-files-sorted.txt" | head -n 1)
    [ -z "$conflicting_link" ] || fail "staged upstream has a duplicate STAGE.links link path: $stage_dir/$conflicting_link"
    if [ "$(uname -s)" = Darwin ]; then
        stage_real=$(/usr/bin/perl -MCwd=realpath -e 'my $p = realpath($ARGV[0]); defined $p or exit 1; print $p' -- "$stage_dir") \
            || fail "cannot resolve staged upstream to a canonical path: $stage_dir"
    else
        stage_real=$(cd "$stage_dir" && pwd -P)
    fi
    # Empty directories are absent from both manifests, but their names must
    # still obey the stage tree's name contract. NUL-delimited paths preserve
    # newlines and other hostile bytes while scanning the tree in one pass.
    (cd "$stage_dir" && find . -type d -print0) > "$check_dir/stage-dirs.txt" \
        || fail "cannot enumerate staged upstream directories: $stage_dir"
    iconv -f UTF-8 -t UTF-8 "$check_dir/stage-dirs.txt" >/dev/null \
        || fail "staged upstream has an invalid UTF-8 directory name: $stage_dir"
    [ "$(LC_ALL=C tr -cd '[:cntrl:]\\' < "$check_dir/stage-dirs.txt" | LC_ALL=C tr -d '\000' | wc -c)" -eq 0 ] \
        || fail "staged upstream has an unsafe directory name: $stage_dir"
    if LC_ALL=C.UTF-8 grep -azq '[[:cntrl:]]' "$check_dir/stage-dirs.txt"; then
        fail "staged upstream has a Unicode control in a directory name: $stage_dir"
    else
        control_status=$?
        [ "$control_status" -eq 1 ] || fail "cannot check staged upstream directory names: $stage_dir"
    fi
    files=$(cat "$check_dir/stage-files-sorted.txt")
    links=$(cat "$check_dir/stage-links-sorted.txt")
    listed=$({ printf '%s\n' "$files"; printf '%s\n' "$links"; } | sed '/^$/d' | LC_ALL=C sort)
    present=$(cd "$stage_dir" && find . -path ./STAGE.sha256 -prune -o -path ./STAGE.links -prune -o ! -type d -print | sed 's|^\./||' | LC_ALL=C sort)
    printf '%s\n' "$listed" > "$check_dir/listed.txt"
    printf '%s\n' "$present" > "$check_dir/present.txt"
    unlisted=$(LC_ALL=C comm -13 "$check_dir/listed.txt" "$check_dir/present.txt")
    [ -z "$unlisted" ] || fail "staged upstream holds entries its manifests do not list: $(printf '%s' "$unlisted" | head -n 1)"
    [ "$listed" = "$present" ] || fail "staged upstream differs from its STAGE manifests: $stage_dir"
    actual_files=$(cd "$stage_dir" && find . -path ./STAGE.sha256 -prune -o -path ./STAGE.links -prune -o -type f -print | sed 's|^\./||' | LC_ALL=C sort)
    [ "$files" = "$actual_files" ] || fail "staged upstream file types differ from STAGE.sha256: $stage_dir"
    actual_links=$(cd "$stage_dir" && find . -type l -print | sed 's|^\./||' | LC_ALL=C sort)
    [ "$links" = "$actual_links" ] || fail "staged upstream link types differ from STAGE.links: $stage_dir"
    actual_execs=$(cd "$stage_dir" && find . -path ./STAGE.sha256 -prune -o -path ./STAGE.links -prune -o -type f -perm -100 -print | sed 's|^\./||' | LC_ALL=C sort)
    [ "$(cat "$check_dir/stage-execs-sorted.txt")" = "$actual_execs" ] \
        || fail "staged upstream executable bits differ from STAGE.links: $stage_dir"
    while IFS="$tab" read -r kind path target; do
        case $kind in
            link)
                [ -n "$target" ] && [ -L "$stage_dir/$path" ] \
                    || fail "staged upstream link differs from STAGE.links: $stage_dir/$path"
                actual_target=$(readlink -n -- "$stage_dir/$path" && printf '.') \
                    || fail "cannot read staged upstream link: $stage_dir/$path"
                actual_target=${actual_target%.}
                [ "$actual_target" = "$target" ] \
                    || fail "staged upstream link differs from STAGE.links: $stage_dir/$path"
                # A final realpath can re-enter the stage after an intermediate
                # component escaped it. Check every resolved prefix instead.
                link_prefix=$(dirname -- "$stage_dir/$path")
                link_rest=$target
                while :; do
                    link_component=${link_rest%%/*}
                    link_prefix=$link_prefix/$link_component
                    if [ "$(uname -s)" = Linux ]; then
                        resolved=$(readlink -e -- "$link_prefix") \
                            || fail "unresolvable link in staged upstream: $stage_dir/$path"
                    else
                        # macOS: resolve each prefix with perl, requiring existence and refusing cycles
                        resolved=$(/usr/bin/perl -MCwd=realpath -e 'my $p = realpath($ARGV[0]); defined $p && -e $p or exit 1; print $p' -- "$link_prefix") \
                            || fail "unresolvable link in staged upstream: $stage_dir/$path"
                    fi
                    case $resolved in
                        "$stage_real" | "$stage_real"/*) ;;
                        *) fail "link leaves the staged upstream: $stage_dir/$path" ;;
                    esac
                    [ "$link_rest" != "$link_component" ] || break
                    link_rest=${link_rest#*/}
                done
                ;;
            exec)
                [ -z "$target" ] && [ -f "$stage_dir/$path" ] && [ ! -L "$stage_dir/$path" ] \
                    || fail "staged upstream executable differs from STAGE.links: $stage_dir/$path"
                ;;
            *) fail "staged upstream has an invalid STAGE.links entry: $stage_dir" ;;
        esac
    done < "$stage_dir/STAGE.links"
    # Only read listed payloads after every path has been checked as a regular
    # file. `sha256sum -c` would otherwise block forever on a listed FIFO.
    (cd "$stage_dir" && if command -v sha256sum >/dev/null 2>&1; then sha256sum -c STAGE.sha256 >/dev/null 2>&1; else shasum -a 256 -c STAGE.sha256 >/dev/null 2>&1; fi) \
        || fail "staged upstream does not match STAGE.sha256: $stage_dir"
}

network_check() {
    if [ "$(uname -s)" = Darwin ]; then
        # On macOS, verify the sandbox blocks egress and loopback works, and that
        # it cannot access unrelated host sockets outside the permitted paths.
        # Test that external egress fails.
        if /usr/bin/nc -z -w 3 1.1.1.1 443 >/dev/null 2>&1; then
            fail "the sandbox does not block TCP egress to external IP"
        fi
        if /usr/bin/curl -s -o /dev/null --max-time 5 https://registry.npmjs.org >/dev/null 2>&1; then
            fail "the sandbox does not block HTTPS egress"
        fi
        # Test that loopback works: start a listener and connect to it.
        listen_port=$((20000 + $$ % 20000))
        /usr/bin/nc -l 127.0.0.1 "$listen_port" >/dev/null 2>&1 &
        listener_pid=$!
        sleep 0.5
        if /usr/bin/nc -z -w 3 127.0.0.1 "$listen_port" >/dev/null 2>&1; then
            /bin/kill "$listener_pid" 2>/dev/null || true
        else
            /bin/kill "$listener_pid" 2>/dev/null || true
            fail "loopback is not usable inside the sandbox"
        fi
        # Test that unix sockets outside the permitted paths are blocked.
        [ -n "$host_probe" ] || fail "the host unix-socket probe is missing"
        [ -S "$host_probe/s" ] || fail "the host unix-socket probe is missing"
        [ -S "$host_probe/w" ] || fail "the host unix-socket probe is missing"
        if printf x | /usr/bin/nc -U -w 2 "$host_probe/s" >/dev/null 2>&1; then
            fail "the sandbox does not block unrelated host unix sockets: $host_probe/s"
        fi
        if printf x | /usr/bin/nc -U -w 2 "$host_probe/w" >/dev/null 2>&1; then
            fail "the sandbox does not block unrelated host unix sockets: $host_probe/w"
        fi
    else
        # Linux: check iproute2 state.
        link=$(ip -o link show lo 2>/dev/null) || fail "cannot read the loopback state (iproute2 'ip' is required)"
        case $link in
            *[\<,]UP[\>,]*) ;;
            *) fail "loopback is not up inside the namespace" ;;
        esac
        ifaces=$(sed -n '3,$p' /proc/net/dev | sed 's/:.*//; s/^ *//')
        [ "$ifaces" = lo ] || fail "the namespace is not isolated, interfaces: $(printf '%s' "$ifaces" | tr '\n' ' ')"
        default_routes=$(awk 'NR > 1 && $2 == "00000000"' /proc/net/route)
        [ -z "$default_routes" ] || fail "the namespace has a default route"
    fi
}

stray_check() {
    if [ "$(uname -s)" = Darwin ]; then
        # On macOS, check the process group (session). Note: this weaker check does
        # not detect a detached helper whose executable and cwd are outside the temp
        # root (see #1010).
        if /usr/bin/pgrep -g "$stray_pgid" >/dev/null 2>&1; then
            # Found stray processes, kill the group before failing
            /bin/kill -KILL -- -"$stray_pgid" 2>/dev/null || true
            fail "a process outlived the consumer run (process group $stray_pgid)"
        fi
        # /bin/ps is denied inside the sandbox; `pgrep -lf` prints "<pid> <argv>".
        # pgrep never lists itself. This shell and its forks (the command
        # substitution) run "<self> __inner sandbox <work> ...": skip them.
        uid=$(/usr/bin/id -u)
        snapshot=$(/usr/bin/pgrep -lf -U "$uid" . 2>/dev/null) && rc=0 || rc=$?
        case $rc in
            0) ;;
            1) snapshot= ;;
            *) fail "cannot list processes (pgrep exit $rc)" ;;
        esac
        same_user=
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            pid=${line%% *}
            cmd=${line#* }
            [ "$pid" = "$$" ] && continue
            case $cmd in
                *" __inner sandbox $work "*) continue ;;
                *"$work"*) same_user="$pid $cmd"; break ;;
            esac
        done <<EOF
$snapshot
EOF
        if [ -n "$same_user" ]; then
            stray_pid=${same_user%% *}
            # Re-verify the identity right before signalling: same pid, still
            # naming the temp root.
            now_output=$(/usr/bin/pgrep -lf -U "$uid" . 2>/dev/null) && rc=0 || rc=$?
            case $rc in
                0) ;;
                1) now_output= ;;
                *) fail "cannot re-verify processes (pgrep exit $rc)" ;;
            esac
            now=$(printf '%s\n' "$now_output" | while IFS= read -r l; do if [ "${l%% *}" = "$stray_pid" ]; then printf '%s\n' "$l"; fi; done)
            case $now in
                *"$work"*)
                    /bin/kill -KILL -- "-$stray_pid" 2>/dev/null || true
                    /bin/kill -KILL "$stray_pid" 2>/dev/null || true
                    ;;
            esac
            n=0
            while /bin/kill -0 "$stray_pid" 2>/dev/null && [ "$n" -lt 50 ]; do
                sleep 0.1
                n=$((n + 1))
            done
            if /bin/kill -0 "$stray_pid" 2>/dev/null; then
                fail "a process outlived the consumer run and survived SIGKILL: $same_user"
            fi
            fail "a process outlived the consumer run: $same_user"
        fi
    else
        for proc_dir in /proc/[0-9]*; do
            pid=${proc_dir#/proc/}
            if [ "$pid" != "$$" ]; then
                fail "a process outlived the consumer run (pid $pid)"
            fi
        done
    fi
}

inner_main() {
    isolation=$1
    work=$2
    root=$3
    stage=$4
    consumer=$5
    node_dir=$6
    sock_root=$7
    host_probe=$8
    shift 8
    case "$isolation" in
        sandbox)
            check_dir=$work/t/check
            mkdir -p "$check_dir"
            ;;
        *)
            check_dir=$work
            ;;
    esac
    if [ "$isolation" = userns ]; then
        ip link set lo up || fail "cannot bring loopback up inside the namespace"
    fi
    network_check
    for rt in "$@"; do
        stage_check "$stage/$rt"
    done
    for rt in "$@"; do
        run=$work/run/$rt
        mkdir -p "$work/t" "$run/home" "$run/cwd" "$run/config" "$run/data" "$run/state" "$run/cache"

        if [ "$isolation" = sandbox ]; then
            # On macOS, run the consumer in a new session to detect stray processes.
            pidfile="$work/run/.stray_$rt.pid"
            consumer_exit=0
            /usr/bin/perl -MPOSIX -e 'my ($pidfile, $dir) = splice(@ARGV, 0, 2); POSIX::setsid() > 0 or die "setsid: $!"; open(my $fh, ">", $pidfile) or die "$pidfile: $!"; print $fh "$$\n"; close($fh); chdir($dir) or die "$dir: $!"; exec { $ARGV[0] } @ARGV or die "exec: $!"' \
                "$pidfile" "$run/cwd" \
                env -i \
                PATH="$stage/$rt/bin:$node_dir:/usr/bin:/bin" \
                HOME="$run/home" \
                XDG_CONFIG_HOME="$run/config" \
                XDG_DATA_HOME="$run/data" \
                XDG_STATE_HOME="$run/state" \
                XDG_CACHE_HOME="$run/cache" \
                TMPDIR="$work/t" \
                LANG=C.UTF-8 \
                POHUNEK_CONSUMER_BIN_DIR="$root" \
                POHUNEK_CONSUMER_RUNTIME="$rt" \
                POHUNEK_CONSUMER_PACKAGE="$root/runtime/packages/$rt.tar.zst" \
                POHUNEK_CONSUMER_CATALOG="$root/runtime/runtime-catalog.json" \
                POHUNEK_CONSUMER_STAGE_BIN="$stage/$rt/bin" \
                POHUNEK_CONSUMER_REPORT="$run/report.json" \
                POHUNEK_TEST_TEMP_ROOT="$sock_root" \
                "$consumer" --exact "$consumer_test" --nocapture || consumer_exit=$?
            stray_pgid=$(cat "$pidfile")
            rm "$pidfile"
            if [ "$consumer_exit" -ne 0 ]; then
                /bin/kill -KILL -- -"$stray_pgid" 2>/dev/null || true
                fail "the consumer run failed for runtime $rt"
            fi
        else
            (
                cd "$run/cwd"
                exec env -i \
                    PATH="$stage/$rt/bin:$node_dir:/usr/bin:/bin" \
                    HOME="$run/home" \
                    XDG_CONFIG_HOME="$run/config" \
                    XDG_DATA_HOME="$run/data" \
                    XDG_STATE_HOME="$run/state" \
                    XDG_CACHE_HOME="$run/cache" \
                    TMPDIR="$work/t" \
                    LANG=C.UTF-8 \
                    POHUNEK_CONSUMER_BIN_DIR="$root" \
                    POHUNEK_CONSUMER_RUNTIME="$rt" \
                    POHUNEK_CONSUMER_PACKAGE="$root/runtime/packages/$rt.tar.zst" \
                    POHUNEK_CONSUMER_CATALOG="$root/runtime/runtime-catalog.json" \
                    POHUNEK_CONSUMER_STAGE_BIN="$stage/$rt/bin" \
                    POHUNEK_CONSUMER_REPORT="$run/report.json" \
                    "$consumer" --exact "$consumer_test" --nocapture
            ) || fail "the consumer run failed for runtime $rt"
        fi
        stray_check
        [ -f "$run/report.json" ] || fail "the consumer wrote no report for runtime $rt"
    done
}

sudo_supervisor() {
    sudo_uid=$1
    sudo_gid=$2
    sudo_cancel=$3
    shift 3
    sudo_group=$(ps -o pgid= -p "$$" | tr -d ' ')
    [ "$sudo_group" = "$$" ] || fail "sudo supervisor has no private process group"
    [ -p "$sudo_cancel" ] && [ ! -L "$sudo_cancel" ] || fail "sudo cancellation pipe is not a FIFO"
    /usr/bin/chmod 600 "$sudo_cancel"
    /usr/bin/chown 0:0 "$sudo_cancel"
    # Linux permits opening a FIFO read/write without a peer. Hold that
    # temporary writer while opening the read end, then drop it so a writer
    # that exited before this point is observed as EOF by the watchdog.
    exec 3<> "$sudo_cancel"
    exec 4< "$sudo_cancel"
    exec 3>&-
    exec 3<&4
    exec 4<&-
    # The writer is held only by the outer shell. A root-owned FIFO keeps the
    # unprivileged consumer from delaying EOF or requesting cancellation.
    /usr/bin/unshare --net --pid --fork --kill-child --mount-proc \
        /bin/sh -c 'ip link set lo up && u=$1 && g=$2 && shift 2 && exec setpriv --reuid="$u" --regid="$g" --clear-groups --inh-caps=-all --bounding-set=-all "$@"' \
        sh "$sudo_uid" "$sudo_gid" /bin/sh "$0" __inner sudo "$@" &
    sudo_child=$!
    (
        IFS= read -r _ <&3 || :
        # The supervisor is the group leader until this signal arrives, so
        # the group ID cannot have been reused for an unrelated process.
        /bin/kill -KILL 0 2>/dev/null || true
    ) &
    sudo_watchdog=$!
    sudo_stop() {
        /bin/kill -KILL 0 2>/dev/null || true
    }
    trap sudo_stop HUP INT TERM
    sudo_status=0
    wait "$sudo_child" || sudo_status=$?
    kill "$sudo_watchdog" 2>/dev/null || true
    wait "$sudo_watchdog" 2>/dev/null || true
    trap - HUP INT TERM
    return "$sudo_status"
}

create_throwaway_user() {
    retry=0
    while [ "$retry" -lt 20 ]; do
        tuid=$(( 40000 + $(od -An -N2 -tu2 /dev/urandom | tr -d ' ') % 20000 ))
        [ -n "$(/usr/bin/dscl . -search /Users UniqueID "$tuid" 2>/dev/null)" ] && { retry=$((retry + 1)); continue; }
        [ -e "/private/tmp/codex-daemon-$tuid" ] && { retry=$((retry + 1)); continue; }
        [ -e "/private/tmp/pohunek-$tuid" ] && { retry=$((retry + 1)); continue; }
        tuser=pksmoke$tuid
        /usr/bin/dscl . -read "/Users/$tuser" >/dev/null 2>&1 && { retry=$((retry + 1)); continue; }
        break
    done
    if [ "$retry" -ge 20 ]; then
        fail "cannot find a unique throwaway uid after 20 retries"
    fi
    tuser_created=1
    /usr/bin/sudo -n /usr/bin/dscl . -create "/Users/$tuser" || fail "cannot create the throwaway user $tuser"
    /usr/bin/sudo -n /usr/bin/dscl . -create "/Users/$tuser" UniqueID "$tuid" || fail "cannot create the throwaway user $tuser"
    /usr/bin/sudo -n /usr/bin/dscl . -create "/Users/$tuser" PrimaryGroupID 20 || fail "cannot create the throwaway user $tuser"
    /usr/bin/sudo -n /usr/bin/dscl . -create "/Users/$tuser" UserShell /usr/bin/false || fail "cannot create the throwaway user $tuser"
    /usr/bin/sudo -n /usr/bin/dscl . -create "/Users/$tuser" NFSHomeDirectory /var/empty || fail "cannot create the throwaway user $tuser"
    /usr/bin/sudo -n /usr/bin/dscl . -create "/Users/$tuser" RealName "pohunek archive smoke" || fail "cannot create the throwaway user $tuser"
    /usr/bin/sudo -n /usr/bin/dscl . -create "/Users/$tuser" IsHidden 1 || fail "cannot create the throwaway user $tuser"
    poll=0
    while [ "$poll" -lt 50 ]; do
        current_uid=$(/usr/bin/id -u "$tuser" 2>/dev/null)
        if [ "$current_uid" = "$tuid" ]; then
            break
        fi
        sleep 0.1
        poll=$((poll + 1))
    done
    if [ "$poll" -ge 50 ]; then
        fail "throwaway user $tuser uid is not $tuid after polling"
    fi
    codex_dir=/private/tmp/codex-daemon-$tuid
}

if [ "${1:-}" = __inner ]; then
    shift
    inner_main "$@"
    exit 0
fi
if [ "${1:-}" = __sudo_supervisor ]; then
    shift
    sudo_supervisor "$@"
    exit 0
fi

