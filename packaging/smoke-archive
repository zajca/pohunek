#!/bin/sh
# Network-isolated smoke of a final release daemon archive.
#
# usage: smoke-archive --archive <pohunek-daemon-...tar.gz> --stage <dir>
#                      --consumer <release-consumer-test-executable>
#                      [--runtime <id>]... [--isolation auto|userns|sudo]
#
# Proves that the archive alone - its binaries, its signed catalog and trust
# anchor, its runtime packages - installs and serves every official runtime
# through the real upstream, with no network and no source tree:
#
#   1. extracts the archive into a fresh private temp directory after refusing
#      absolute, `..`, link and special members, and runs the archive's own
#      `packaging/verify-archive` on the unpacked tree;
#   2. derives the runtimes from `runtime/packages/*.tar.zst` (the set is data;
#      `--runtime` only restricts it) and requires a staged upstream
#      `<stage>/<runtime>/` for every one of them (a missing stage fails);
#   3. enters a fresh network namespace (plus a PID namespace, so no process can
#      outlive the run), brings loopback up, asserts that loopback is the only
#      interface and that no default route exists, and re-verifies every stage
#      against STAGE.sha256 and STAGE.links using POSIX tools only;
#   4. runs the prebuilt consumer test executable once per runtime with
#      PATH = `<stage>/<runtime>/bin` + the system node and tool directories,
#      a hermetic HOME/XDG tree, a temp working directory and only the
#      `POHUNEK_CONSUMER_*` contract variables, pointing into the extracted
#      archive (`POHUNEK_CONSUMER_CATALOG` selects smoke mode, so the archive's
#      own signed catalog and anchor are the trust);
#   5. checks every consumer report against the archive: `package_digest` equals
#      the catalog entry's digest (and the package file's bytes) and
#      `executables` equal the SHA-256 of the archive's binaries.
#
# Isolation strategies (`--isolation`, default auto picks the first that works):
#   userns  `unshare --user --map-root-user --net --pid`: needs unprivileged
#           user namespaces (Ubuntu 24.04 blocks them through AppArmor unless
#           `kernel.apparmor_restrict_unprivileged_userns=0`).
#   sudo    `sudo -n unshare --net --pid`, loopback brought up as root, then
#           the invoking uid/gid is restored with `setpriv` before anything else
#           runs, with all capabilities dropped.
# When neither works the script fails; there is no un-isolated fallback.
#
# This script comes from the checkout and runs outside the namespace up to
# step 3. "No source-tree path" is about everything the daemon, worker, CLI and
# upstream see: the archive, stage and temp paths are refused when they lie
# inside the checkout, and the consumer executable is copied to the temp
# directory and run from there. Linux only (util-linux unshare, iproute2, jq).

set -eu

# Name of the consumer test selected from the prebuilt executable; it is the
# one real out-of-process test of crates/cli/tests/release_consumer.rs.
consumer_test=the_release_binaries_serve_the_runtime_out_of_process
# The executables a daemon archive ships and the consumer report hashes.
binaries="pohunek pohunekd pohunek-sessiond"

fail() {
    printf 'smoke-archive: %s\n' "$*" >&2
    exit 1
}

usage() {
    echo "usage: smoke-archive --archive <daemon.tar.gz> --stage <dir> --consumer <executable> [--runtime <id>]... [--isolation auto|userns|sudo]" >&2
    exit 2
}

safe_id() {
    case $1 in
        '' | *[!a-z0-9._-]*) return 1 ;;
    esac
}

safe_stage_path() {
    case $1 in
        '' | /* | */ | *//* | . | .. | ./* | ../* | */./* | */../* | */. | */..) return 1 ;;
    esac
    return 0
}

safe_stage_target() {
    [ -n "$1" ] || return 1
    case $1 in /*) return 1 ;; esac
    target_rest=$1
    target_depth=$2
    while :; do
        component=${target_rest%%/*}
        case $component in
            '' | .) ;;
            ..)
                [ "$target_depth" -gt 0 ] || return 1
                target_depth=$((target_depth - 1))
                ;;
            *) target_depth=$((target_depth + 1)) ;;
        esac
        [ "$target_rest" != "$component" ] || break
        target_rest=${target_rest#*/}
    done
}

# ---------------------------------------------------------------------------
# Inner half: runs inside the network and PID namespaces.
# ---------------------------------------------------------------------------

stage_check() {
    stage_dir=$1
    [ -d "$stage_dir" ] && [ ! -L "$stage_dir" ] || fail "staged upstream is not a directory: $stage_dir"
    for manifest in STAGE.sha256 STAGE.links; do
        [ -f "$stage_dir/$manifest" ] && [ ! -L "$stage_dir/$manifest" ] \
            || fail "staged upstream has no regular $manifest: $stage_dir"
        iconv -f UTF-8 -t UTF-8 "$stage_dir/$manifest" >/dev/null \
            || fail "staged upstream has invalid UTF-8 in $manifest: $stage_dir"
        case $manifest in
            STAGE.sha256) allowed_controls='\012' ;;
            STAGE.links) allowed_controls='\011\012' ;;
        esac
        [ "$(LC_ALL=C tr -cd '[:cntrl:]\\' < "$stage_dir/$manifest" | LC_ALL=C tr -d "$allowed_controls" | wc -c)" -eq 0 ] \
            || fail "staged upstream has a control character or backslash in $manifest: $stage_dir"
        if [ "$manifest" = STAGE.links ]; then
            LC_ALL=C tr -d '\011' < "$stage_dir/$manifest" > "$work/stage-text-check.txt"
        else
            cp -- "$stage_dir/$manifest" "$work/stage-text-check.txt"
        fi
        if LC_ALL=C.UTF-8 grep -q '[[:cntrl:]]' "$work/stage-text-check.txt"; then
            fail "staged upstream has a Unicode control character in $manifest: $stage_dir"
        else
            control_status=$?
            [ "$control_status" -eq 1 ] || fail "cannot check Unicode controls in $manifest: $stage_dir"
        fi
    done
    : > "$work/stage-files.txt"
    : > "$work/stage-links.txt"
    : > "$work/stage-execs.txt"
    while :; do
        line=
        if IFS= read -r line; then
            :
        else
            [ -z "$line" ] || fail "staged upstream has an unterminated STAGE.sha256 entry: $stage_dir"
            break
        fi
        digest=${line%%  *}
        path=${line#"$digest  "}
        [ "$line" = "$digest  $path" ] && [ "${#digest}" -eq 64 ] \
            || fail "staged upstream has an invalid STAGE.sha256 entry: $stage_dir"
        case $digest in
            *[!0-9a-f]*) fail "staged upstream has an invalid STAGE.sha256 digest: $stage_dir" ;;
        esac
        safe_stage_path "$path" || fail "staged upstream has an unsafe STAGE.sha256 path: $stage_dir"
        printf '%s\n' "$path" >> "$work/stage-files.txt"
    done < "$stage_dir/STAGE.sha256"
    tab=$(printf '\t')
    while :; do
        line=
        if IFS= read -r line; then
            :
        else
            [ -z "$line" ] || fail "staged upstream has an unterminated STAGE.links entry: $stage_dir"
            break
        fi
        case $line in
            "exec$tab"*)
                path=${line#"exec$tab"}
                case $path in
                    *"$tab"*) fail "staged upstream has an invalid STAGE.links entry: $stage_dir" ;;
                esac
                safe_stage_path "$path" \
                    || fail "staged upstream has an invalid STAGE.links exec path: $stage_dir/$path"
                printf '%s\n' "$path" >> "$work/stage-execs.txt"
                ;;
            "link$tab"*)
                rest=${line#"link$tab"}
                case $rest in
                    *"$tab"*) ;;
                    *) fail "staged upstream has an invalid STAGE.links entry: $stage_dir" ;;
                esac
                path=${rest%%"$tab"*}
                target=${rest#*"$tab"}
                case $target in
                    *"$tab"*) fail "staged upstream has an invalid STAGE.links entry: $stage_dir" ;;
                esac
                link_parent=$path
                link_depth=0
                while :; do
                    case $link_parent in
                        */*) link_parent=${link_parent#*/}; link_depth=$((link_depth + 1)) ;;
                        *) break ;;
                    esac
                done
                safe_stage_path "$path" && safe_stage_target "$target" "$link_depth" \
                    || fail "staged upstream has an invalid STAGE.links link path or target: $stage_dir/$path"
                printf '%s\n' "$path" >> "$work/stage-links.txt"
                ;;
            *) fail "staged upstream has an invalid STAGE.links entry: $stage_dir" ;;
        esac
    done < "$stage_dir/STAGE.links"
    for kind in files links execs; do
        LC_ALL=C sort "$work/stage-$kind.txt" > "$work/stage-$kind-sorted.txt"
        duplicate=$(LC_ALL=C uniq -d "$work/stage-$kind-sorted.txt" | head -n 1)
        case $kind in
            files) kind_name=STAGE.sha256 ;;
            links) kind_name='STAGE.links link' ;;
            execs) kind_name='STAGE.links exec' ;;
        esac
        [ -z "$duplicate" ] || fail "staged upstream has a duplicate $kind_name path: $stage_dir/$duplicate"
    done
    unknown_exec=$(LC_ALL=C comm -23 "$work/stage-execs-sorted.txt" "$work/stage-files-sorted.txt" | head -n 1)
    [ -z "$unknown_exec" ] || fail "staged upstream has an invalid STAGE.links exec path: $stage_dir/$unknown_exec"
    conflicting_link=$(LC_ALL=C comm -12 "$work/stage-links-sorted.txt" "$work/stage-files-sorted.txt" | head -n 1)
    [ -z "$conflicting_link" ] || fail "staged upstream has a duplicate STAGE.links link path: $stage_dir/$conflicting_link"
    stage_real=$(cd "$stage_dir" && pwd -P)
    # Empty directories are absent from both manifests, but their names must
    # still obey the stage tree's name contract. NUL-delimited paths preserve
    # newlines and other hostile bytes while scanning the tree in one pass.
    (cd "$stage_dir" && find . -type d -print0) > "$work/stage-dirs.txt" \
        || fail "cannot enumerate staged upstream directories: $stage_dir"
    iconv -f UTF-8 -t UTF-8 "$work/stage-dirs.txt" >/dev/null \
        || fail "staged upstream has an invalid UTF-8 directory name: $stage_dir"
    [ "$(LC_ALL=C tr -cd '[:cntrl:]\\' < "$work/stage-dirs.txt" | LC_ALL=C tr -d '\000' | wc -c)" -eq 0 ] \
        || fail "staged upstream has an unsafe directory name: $stage_dir"
    if LC_ALL=C.UTF-8 grep -azq '[[:cntrl:]]' "$work/stage-dirs.txt"; then
        fail "staged upstream has a Unicode control in a directory name: $stage_dir"
    else
        control_status=$?
        [ "$control_status" -eq 1 ] || fail "cannot check staged upstream directory names: $stage_dir"
    fi
    files=$(cat "$work/stage-files-sorted.txt")
    links=$(cat "$work/stage-links-sorted.txt")
    listed=$({ printf '%s\n' "$files"; printf '%s\n' "$links"; } | sed '/^$/d' | LC_ALL=C sort)
    present=$(cd "$stage_dir" && find . -path ./STAGE.sha256 -prune -o -path ./STAGE.links -prune -o ! -type d -print | sed 's|^\./||' | LC_ALL=C sort)
    printf '%s\n' "$listed" > "$work/listed.txt"
    printf '%s\n' "$present" > "$work/present.txt"
    unlisted=$(LC_ALL=C comm -13 "$work/listed.txt" "$work/present.txt")
    [ -z "$unlisted" ] || fail "staged upstream holds entries its manifests do not list: $(printf '%s' "$unlisted" | head -n 1)"
    [ "$listed" = "$present" ] || fail "staged upstream differs from its STAGE manifests: $stage_dir"
    actual_files=$(cd "$stage_dir" && find . -path ./STAGE.sha256 -prune -o -path ./STAGE.links -prune -o -type f -print | sed 's|^\./||' | LC_ALL=C sort)
    [ "$files" = "$actual_files" ] || fail "staged upstream file types differ from STAGE.sha256: $stage_dir"
    actual_links=$(cd "$stage_dir" && find . -type l -print | sed 's|^\./||' | LC_ALL=C sort)
    [ "$links" = "$actual_links" ] || fail "staged upstream link types differ from STAGE.links: $stage_dir"
    actual_execs=$(cd "$stage_dir" && find . -path ./STAGE.sha256 -prune -o -path ./STAGE.links -prune -o -type f -perm -100 -print | sed 's|^\./||' | LC_ALL=C sort)
    [ "$(cat "$work/stage-execs-sorted.txt")" = "$actual_execs" ] \
        || fail "staged upstream executable bits differ from STAGE.links: $stage_dir"
    while IFS="$tab" read -r kind path target; do
        case $kind in
            link)
                [ -n "$target" ] && [ -L "$stage_dir/$path" ] \
                    || fail "staged upstream link differs from STAGE.links: $stage_dir/$path"
                actual_target=$(readlink -n -- "$stage_dir/$path" && printf '.') \
                    || fail "cannot read staged upstream link: $stage_dir/$path"
                actual_target=${actual_target%.}
                [ "$actual_target" = "$target" ] \
                    || fail "staged upstream link differs from STAGE.links: $stage_dir/$path"
                # A final realpath can re-enter the stage after an intermediate
                # component escaped it. Check every resolved prefix instead.
                link_prefix=$(dirname -- "$stage_dir/$path")
                link_rest=$target
                while :; do
                    link_component=${link_rest%%/*}
                    link_prefix=$link_prefix/$link_component
                    resolved=$(readlink -e -- "$link_prefix") \
                        || fail "unresolvable link in staged upstream: $stage_dir/$path"
                    case $resolved in
                        "$stage_real" | "$stage_real"/*) ;;
                        *) fail "link leaves the staged upstream: $stage_dir/$path" ;;
                    esac
                    [ "$link_rest" != "$link_component" ] || break
                    link_rest=${link_rest#*/}
                done
                ;;
            exec)
                [ -z "$target" ] && [ -f "$stage_dir/$path" ] && [ ! -L "$stage_dir/$path" ] \
                    || fail "staged upstream executable differs from STAGE.links: $stage_dir/$path"
                ;;
            *) fail "staged upstream has an invalid STAGE.links entry: $stage_dir" ;;
        esac
    done < "$stage_dir/STAGE.links"
    # Only read listed payloads after every path has been checked as a regular
    # file. `sha256sum -c` would otherwise block forever on a listed FIFO.
    (cd "$stage_dir" && sha256sum -c STAGE.sha256 >/dev/null 2>&1) \
        || fail "staged upstream does not match STAGE.sha256: $stage_dir"
}

network_check() {
    link=$(ip -o link show lo 2>/dev/null) || fail "cannot read the loopback state (iproute2 'ip' is required)"
    case $link in
        *[\<,]UP[\>,]*) ;;
        *) fail "loopback is not up inside the namespace" ;;
    esac
    ifaces=$(sed -n '3,$p' /proc/net/dev | sed 's/:.*//; s/^ *//')
    [ "$ifaces" = lo ] || fail "the namespace is not isolated, interfaces: $(printf '%s' "$ifaces" | tr '\n' ' ')"
    default_routes=$(awk 'NR > 1 && $2 == "00000000"' /proc/net/route)
    [ -z "$default_routes" ] || fail "the namespace has a default route"
}

stray_check() {
    for proc_dir in /proc/[0-9]*; do
        pid=${proc_dir#/proc/}
        if [ "$pid" != "$$" ]; then
            fail "a process outlived the consumer run (pid $pid)"
        fi
    done
}

inner_main() {
    isolation=$1
    work=$2
    root=$3
    stage=$4
    consumer=$5
    node_dir=$6
    shift 6
    if [ "$isolation" = userns ]; then
        ip link set lo up || fail "cannot bring loopback up inside the namespace"
    fi
    network_check
    for rt in "$@"; do
        stage_check "$stage/$rt"
    done
    for rt in "$@"; do
        run=$work/run/$rt
        mkdir -p "$work/t" "$run/home" "$run/cwd" "$run/config" "$run/data" "$run/state" "$run/cache"
        (
            cd "$run/cwd"
            exec env -i \
                PATH="$stage/$rt/bin:$node_dir:/usr/bin:/bin" \
                HOME="$run/home" \
                XDG_CONFIG_HOME="$run/config" \
                XDG_DATA_HOME="$run/data" \
                XDG_STATE_HOME="$run/state" \
                XDG_CACHE_HOME="$run/cache" \
                TMPDIR="$work/t" \
                LANG=C.UTF-8 \
                POHUNEK_CONSUMER_BIN_DIR="$root" \
                POHUNEK_CONSUMER_RUNTIME="$rt" \
                POHUNEK_CONSUMER_PACKAGE="$root/runtime/packages/$rt.tar.zst" \
                POHUNEK_CONSUMER_CATALOG="$root/runtime/runtime-catalog.json" \
                POHUNEK_CONSUMER_STAGE_BIN="$stage/$rt/bin" \
                POHUNEK_CONSUMER_REPORT="$run/report.json" \
                "$consumer" --exact "$consumer_test" --nocapture
        ) || fail "the consumer run failed for runtime $rt"
        stray_check
        [ -f "$run/report.json" ] || fail "the consumer wrote no report for runtime $rt"
    done
}

sudo_supervisor() {
    sudo_uid=$1
    sudo_gid=$2
    sudo_cancel=$3
    shift 3
    sudo_group=$(ps -o pgid= -p "$$" | tr -d ' ')
    [ "$sudo_group" = "$$" ] || fail "sudo supervisor has no private process group"
    [ -p "$sudo_cancel" ] && [ ! -L "$sudo_cancel" ] || fail "sudo cancellation pipe is not a FIFO"
    /usr/bin/chmod 600 "$sudo_cancel"
    /usr/bin/chown 0:0 "$sudo_cancel"
    exec 3< "$sudo_cancel"
    # The writer is held only by the outer shell. A root-owned FIFO keeps the
    # unprivileged consumer from delaying EOF or requesting cancellation.
    /usr/bin/unshare --net --pid --fork --kill-child --mount-proc \
        /bin/sh -c 'ip link set lo up && u=$1 && g=$2 && shift 2 && exec setpriv --reuid="$u" --regid="$g" --clear-groups --inh-caps=-all --bounding-set=-all "$@"' \
        sh "$sudo_uid" "$sudo_gid" /bin/sh "$0" __inner sudo "$@" &
    sudo_child=$!
    (
        IFS= read -r _ <&3 || :
        # The supervisor is the group leader until this signal arrives, so
        # the group ID cannot have been reused for an unrelated process.
        kill -KILL -- "-$sudo_group" 2>/dev/null || true
    ) &
    sudo_watchdog=$!
    sudo_stop() {
        kill -KILL -- "-$sudo_group" 2>/dev/null || true
    }
    trap sudo_stop HUP INT TERM
    sudo_status=0
    wait "$sudo_child" || sudo_status=$?
    kill "$sudo_watchdog" 2>/dev/null || true
    wait "$sudo_watchdog" 2>/dev/null || true
    trap - HUP INT TERM
    return "$sudo_status"
}

if [ "${1:-}" = __inner ]; then
    shift
    inner_main "$@"
    exit 0
fi
if [ "${1:-}" = __sudo_supervisor ]; then
    shift
    sudo_supervisor "$@"
    exit 0
fi

# ---------------------------------------------------------------------------
# Outer half: argument handling, extraction, namespace entry, report checks.
# ---------------------------------------------------------------------------

archive=
stage=
consumer=
isolation=auto
requested=
while [ "$#" -gt 0 ]; do
    case $1 in
        --archive) [ "$#" -ge 2 ] || usage; archive=$2; shift 2 ;;
        --stage) [ "$#" -ge 2 ] || usage; stage=$2; shift 2 ;;
        --consumer) [ "$#" -ge 2 ] || usage; consumer=$2; shift 2 ;;
        --runtime)
            [ "$#" -ge 2 ] || usage
            safe_id "$2" || fail "invalid runtime id: $2"
            requested="$requested $2"
            shift 2
            ;;
        --isolation) [ "$#" -ge 2 ] || usage; isolation=$2; shift 2 ;;
        --isolation=*) isolation=${1#--isolation=}; shift ;;
        *) usage ;;
    esac
done
[ -n "$archive" ] && [ -n "$stage" ] && [ -n "$consumer" ] || usage
case $isolation in
    auto | userns | sudo) ;;
    *) fail "--isolation must be auto, userns or sudo" ;;
esac
[ "$(uname -s)" = Linux ] || fail "the archive smoke needs Linux network namespaces"
for tool in tar sha256sum jq unshare setsid mkfifo ps ip awk sed find readlink comm sort uniq tr wc cat head iconv mktemp; do
    command -v "$tool" >/dev/null 2>&1 || fail "required tool is missing: $tool"
done
[ -f "$archive" ] && [ ! -L "$archive" ] || fail "archive is not a regular file: $archive"
[ -d "$stage" ] && [ ! -L "$stage" ] || fail "stage is not a directory: $stage"
[ -f "$consumer" ] && [ -x "$consumer" ] || fail "consumer is not an executable file: $consumer"
archive=$(cd "$(dirname -- "$archive")" && pwd -P)/$(basename -- "$archive")
stage=$(cd "$stage" && pwd -P)
consumer=$(cd "$(dirname -- "$consumer")" && pwd -P)/$(basename -- "$consumer")
self=$(cd "$(dirname -- "$0")" && pwd -P)/$(basename -- "$0")
checkout=$(cd "$(dirname -- "$self")/.." && pwd -P)

umask 022
work=$(mktemp -d "${TMPDIR:-/tmp}/pks.XXXXXX")
chmod 700 "$work"
work=$(cd "$work" && pwd -P)
ns_pid=
cleanup() {
    status=$?
    trap '' EXIT
    # The sudo supervisor's watchdog sees EOF even if sudo uses a PTY and
    # moves its root-owned children out of the launcher's process group.
    exec 3>&-
    if [ -n "$ns_pid" ]; then
        if [ "$chosen" != sudo ]; then
            # Signal the private group before reaping its leader, so its ID
            # cannot be reused for an unrelated process group.
            kill -KILL -- "-$ns_pid" 2>/dev/null || kill -KILL "$ns_pid" 2>/dev/null || true
        fi
        wait "$ns_pid" 2>/dev/null || true
    fi
    rm -rf -- "$work"
    exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

# Nothing the daemon, worker, CLI or upstream sees may lie in the checkout.
for path in "$stage" "$work"; do
    case $path in
        "$checkout" | "$checkout"/*) fail "$path lies inside the checkout $checkout" ;;
    esac
done

# --- extraction --------------------------------------------------------------
tar -tvzf "$archive" > "$work/members-long.txt" 2>/dev/null || fail "cannot list the archive: $archive"
tar -tzf "$archive" > "$work/members.txt" 2>/dev/null || fail "cannot list the archive: $archive"
[ -s "$work/members.txt" ] || fail "the archive is empty"
while IFS= read -r line; do
    case $line in
        -* | d*) ;;
        *) fail "the archive holds a link or special member: $line" ;;
    esac
done < "$work/members-long.txt"
top=
while IFS= read -r member; do
    case $member in
        '' | /* | ../* | */../* | */.. | .. | ./* | */./* | *//* | *[!A-Za-z0-9._+@=,/-]*)
            fail "the archive holds an unsafe member path: $member"
            ;;
    esac
    first=${member%%/*}
    if [ -z "$top" ]; then
        top=$first
    elif [ "$first" != "$top" ]; then
        fail "the archive has more than one top-level entry: $first"
    fi
done < "$work/members.txt"
mkdir "$work/archive"
tar -xzf "$archive" -C "$work/archive" --no-same-owner 2>/dev/null || fail "cannot extract the archive"
root=$work/archive/$top
[ -d "$root" ] && [ ! -L "$root" ] || fail "the archive has no top-level directory"
unsafe=$(find "$root" ! -type f ! -type d -print | head -n 1)
[ -z "$unsafe" ] || fail "the extracted archive holds a link or special file: $unsafe"

# --- archive checks ----------------------------------------------------------
for member in MANIFEST packaging/verify-archive runtime-catalog-anchor.json runtime/runtime-catalog.json $binaries; do
    [ -f "$root/$member" ] || fail "the archive lacks $member"
done
"$root/packaging/verify-archive" "$root" daemon $binaries >/dev/null \
    || fail "the archive's own verify-archive refused the archive"
manifest_covers() {
    grep -q "^sha256 [0-9a-f]\{64\} $1\$" "$root/MANIFEST" || fail "MANIFEST does not cover $1"
}
manifest_covers runtime/runtime-catalog.json

shipped=
for package in "$root"/runtime/packages/*.tar.zst; do
    [ -f "$package" ] || continue
    rt=$(basename -- "$package" .tar.zst)
    safe_id "$rt" || fail "invalid runtime package name: $package"
    manifest_covers "runtime/packages/$rt.tar.zst"
    shipped="$shipped $rt"
done
[ -n "$shipped" ] || fail "the archive ships no runtime package"
if [ -z "$requested" ]; then
    runtimes=$shipped
else
    runtimes=
    for rt in $requested; do
        case " $shipped " in
            *" $rt "*) runtimes="$runtimes $rt" ;;
            *) fail "runtime $rt is not shipped by the archive (shipped:$shipped)" ;;
        esac
    done
fi
for rt in $runtimes; do
    [ -d "$stage/$rt" ] && [ ! -L "$stage/$rt" ] \
        || fail "no staged upstream for the shipped package $rt: $stage/$rt"
done

expected_digest() {
    jq -r --arg rt "$1" '[.catalog.entries[] | select(.runtime_id == $rt)] | if length == 1 then .[0].digest else empty end' \
        "$root/runtime/runtime-catalog.json" || fail "cannot read the catalog"
}
for rt in $runtimes; do
    digest=$(expected_digest "$rt")
    case $digest in
        sha256:????????????????????????????????????????????????????????????????) ;;
        *) fail "the catalog has no single entry with a digest for runtime $rt" ;;
    esac
    [ "$digest" = "sha256:$(sha256sum -- "$root/runtime/packages/$rt.tar.zst" | cut -d' ' -f1)" ] \
        || fail "the shipped package of $rt does not match its catalog digest"
done
expected_binary_sha() {
    sha256sum -- "$root/$1" | cut -d' ' -f1
}

# --- namespace ---------------------------------------------------------------
cp -- "$consumer" "$work/consumer"
chmod 755 "$work/consumer"
node_bin=$(command -v node) || fail "node is required on PATH (the upstreams are node programs)"
node_dir=$(cd "$(dirname -- "$node_bin")" && pwd -P)
node_real=$(readlink -f -- "$node_bin") || fail "cannot resolve node on PATH: $node_bin"
[ -f "$node_real" ] && [ -x "$node_real" ] || fail "node on PATH is not an executable file: $node_bin"
for path in "$node_dir" "$node_real"; do
    case $path in
        "$checkout" | "$checkout"/*) fail "node on PATH resolves inside the checkout $checkout: $path" ;;
    esac
done
uid=$(id -u)
gid=$(id -g)
mkdir "$work/run"

# Namespace setup and stage verification must never resolve tools through the
# caller's PATH, which may include writable directories populated by npm.
root_path=/usr/sbin:/usr/bin:/sbin:/bin

run_userns() {
    exec /usr/bin/setsid /usr/bin/env -i PATH="$root_path" /usr/bin/unshare --user --map-root-user --net --pid --fork --kill-child --mount-proc \
        /bin/sh "$self" __inner userns "$work" "$root" "$stage" "$work/consumer" "$node_dir" $runtimes
}
run_sudo() {
    exec /usr/bin/setsid /usr/bin/sudo -n /usr/bin/env -i PATH="$root_path" \
        /usr/bin/setsid --wait /bin/sh "$self" __sudo_supervisor "$uid" "$gid" "$work/sudo-cancel" "$work" "$root" "$stage" "$work/consumer" "$node_dir" $runtimes 3>&-
}
probe_userns() {
    /usr/bin/env -i PATH="$root_path" /usr/bin/unshare --user --map-root-user --net --pid --fork --kill-child --mount-proc /usr/bin/true >/dev/null 2>&1
}
probe_sudo() {
    [ -x /usr/bin/sudo ] && [ -x /usr/bin/unshare ] && [ -x /usr/bin/setpriv ] \
        && /usr/bin/sudo -n /usr/bin/env -i PATH="$root_path" /usr/bin/unshare \
            --net --pid --fork --kill-child --mount-proc true >/dev/null 2>&1
}

chosen=$isolation
if [ "$chosen" = auto ]; then
    if probe_userns; then
        chosen=userns
    elif probe_sudo; then
        chosen=sudo
    else
        fail "no network isolation is available: unprivileged user namespaces are denied and 'sudo -n unshare' does not work; refusing to run un-isolated"
    fi
fi
echo "smoke-archive: isolation $chosen, runtimes:$runtimes"
case $chosen in
    userns) probe_userns || fail "isolation userns is not available on this host" ;;
    sudo) probe_sudo || fail "isolation sudo is not available on this host" ;;
esac
if [ "$chosen" = sudo ]; then
    /usr/bin/mkfifo "$work/sudo-cancel"
    exec 3<> "$work/sudo-cancel"
fi

# The namespace runs in the background so a signal reaches the trap at once.
"run_$chosen" &
ns_pid=$!
ns_status=0
wait "$ns_pid" || ns_status=$?
ns_pid=
[ "$ns_status" -eq 0 ] || fail "the isolated run failed (exit $ns_status)"

# --- reports -----------------------------------------------------------------
for rt in $runtimes; do
    report=$work/run/$rt/report.json
    [ -f "$report" ] || fail "no consumer report for runtime $rt"
    jq -e --arg rt "$rt" --arg digest "$(expected_digest "$rt")" \
        --arg a "$(expected_binary_sha pohunek)" \
        --arg b "$(expected_binary_sha pohunekd)" \
        --arg c "$(expected_binary_sha pohunek-sessiond)" \
        '.schema == 1 and .runtime == $rt and .package_digest == $digest
         and (.executables | keys) == ["pohunek", "pohunek-sessiond", "pohunekd"]
         and .executables.pohunek == $a and .executables.pohunekd == $b
         and .executables["pohunek-sessiond"] == $c' "$report" >/dev/null \
        || fail "the consumer report for $rt does not match the archive's catalog digest and binaries"
    upstream=$(jq -r '.upstream_version' "$report")
    echo "smoke-archive: $rt ok (upstream $upstream, package $(expected_digest "$rt"))"
done
echo "smoke-archive: all runtimes passed"
