#!/bin/sh
# Package built macOS binaries into a release-layout archive.
#
# usage: package --development|--release <component> <version> <bindir> <docs-dir> <output-dir>
#
# <component> is cli, daemon, or gui (the gui archive holds Pohunek.app, built
# here from <bindir>/pohunek-gui). The staged tree is audited (`audit-macho`),
# then sealed with a MANIFEST and archived reproducibly; the archive path is
# printed on stdout.
#
# `--release` signs the tree with the Developer ID identity, has Apple notarize
# it (stapling app bundles), and verifies the result before the manifest is
# written, so the manifest hashes the final signed bytes and records
# `signing developer-id`. It needs the environment of `signing-keychain`
# (MACOS_SIGNING_IDENTITY, MACOS_SIGNING_KEYCHAIN), of `notarize`
# (APPLE_NOTARY_*), and MACOS_TEAM_ID, and fails when any is missing: a release
# is never produced unsigned. Signing embeds Apple's secure timestamp, so a
# signed archive differs between runs; the unsigned content it wraps is
# reproducible.
#
# `--development` builds an unsigned archive for local use and CI acceptance
# (an app bundle gets only an ad-hoc seal so it can launch). Its name ends in
# `-unsigned-development` and its MANIFEST says `signing unsigned-development`,
# so it can never be mistaken for a release artifact and is never attached to a
# release.
#
# `SOURCE_DATE_EPOCH` stamps the archive; it defaults to the commit time of
# HEAD. Run from anywhere inside the repository on an arm64 Mac.

set -eu

fail() {
    printf 'package: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 6 ] || fail "usage: package --development|--release <component> <version> <bindir> <docs-dir> <output-dir>"
mode=$1
component=$2
version=$3
bindir=$4
docs=$5
output=$6
case $mode in
    --development | --release) ;;
    *) fail "unsupported mode: $mode (use --development or --release)" ;;
esac
case $component in
    cli) require="--require pohunek" ;;
    daemon) require="--require pohunek --require pohunekd --require pohunek-sessiond" ;;
    gui) require="--require Pohunek.app/Contents/MacOS/pohunek-gui" ;;
    *) fail "unsupported component: $component" ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
root=$(CDPATH= cd -- "$script_dir/../.." && pwd -P)
target=aarch64-apple-darwin
minimum_macos=$(tr -d ' \n' < "$script_dir/DEPLOYMENT_TARGET")

if [ "$mode" = --release ]; then
    # Checked first so a release with a missing credential fails before any
    # build output is produced.
    for variable in MACOS_SIGNING_IDENTITY MACOS_SIGNING_KEYCHAIN MACOS_TEAM_ID \
        APPLE_NOTARY_KEY_P8_BASE64 APPLE_NOTARY_KEY_ID APPLE_NOTARY_ISSUER_ID; do
        eval "value=\${$variable:-}"
        [ -n "$value" ] || fail "$variable is not set: a release is never produced unsigned"
    done
fi

# The caller's relative paths mean the caller's directory.
bindir=$(CDPATH= cd -- "$bindir" && pwd -P)
docs=$(CDPATH= cd -- "$docs" && pwd -P)
output=$(CDPATH= cd -- "$output" && pwd -P)

cd "$root"
if [ -z "${SOURCE_DATE_EPOCH:-}" ]; then
    SOURCE_DATE_EPOCH=$(git log -1 --format=%ct)
fi
export SOURCE_DATE_EPOCH

work=$(mktemp -d "${TMPDIR:-/tmp}/pohunek-package.XXXXXX")
trap 'rm -rf -- "$work"' EXIT
if [ "$component" = gui ]; then
    "$script_dir/build-app-bundle" "$bindir/pohunek-gui" "$version" "$work" > /dev/null
    bindir=$work
fi

name=$("$root/packaging/stage-archive" "$component" "$version" "$target" "$bindir" "$docs" "$output")
if [ "$mode" = --development ]; then
    suffix=-unsigned-development
    rm -rf -- "$output/$name$suffix"
    mv -- "$output/$name" "$output/$name$suffix"
    name=$name$suffix
    signing=unsigned-development
else
    signing=developer-id
fi
staging=$output/$name

if [ "$mode" = --development ] && [ "$component" = gui ]; then
    # Apple Silicon kills an app whose bundle seal is invalid. An ad-hoc seal
    # (no identity, no trust) lets a development bundle launch; the manifest
    # still says `unsigned-development`.
    codesign --force --sign - "$staging/Pohunek.app" >&2
    codesign --verify --strict --deep "$staging/Pohunek.app" >&2
fi

# shellcheck disable=SC2086
"$script_dir/audit-macho" $require --forbid-string "$root" "$staging" >&2
if [ "$mode" = --release ]; then
    "$script_dir/sign" "$staging" >&2
    "$script_dir/notarize" "$staging" >&2
    "$script_dir/verify-signed" --notarized --team-id "$MACOS_TEAM_ID" "$staging" >&2
fi
sh "$root/packaging/write-manifest" "$staging" "$component" "$version" "$target" \
    "$signing" "$minimum_macos"
sh "$root/packaging/archive" "$output" "$name" "$output"
printf '%s\n' "$output/$name.tar.gz"
