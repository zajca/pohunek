#!/bin/sh
# Package built macOS binaries into a release-layout archive.
#
# usage:
#   package --development   <component> <version> <bindir> <docs-dir> <output-dir>
#   package --stage-release <component> <version> <bindir> <docs-dir> <output-dir>
#   package --adhoc-release <component> <version> <staging-dir>
#
# <component> is cli or daemon. The staged tree is audited (`audit-macho`),
# then sealed with a MANIFEST and archived reproducibly; the archive path is
# printed on stdout.
#
# A release is made in two steps so that no built program runs after the final
# bytes exist. `--stage-release` assembles and audits the tree, which runs the
# built `pohunek` to write the shell completions, and prints the staging
# directory. `--adhoc-release` then ad-hoc signs every Mach-O file of the tree
# (`sign`), verifies the result (`verify-signed --adhoc`), and writes the
# manifest and the archive, so the manifest hashes the final signed bytes and
# records `signing adhoc`. It audits the tree again before signing (the tree
# came from another runner) and runs nothing from it. It needs no secret: an
# ad-hoc signature uses no certificate and no keychain.
#
# `--development` builds an unsigned archive for local use and CI acceptance.
# Its name ends in `-unsigned-development` and its MANIFEST says
# `signing unsigned-development`, so it can never be mistaken for a release artifact and is never attached to a
# release.
#
# `SOURCE_DATE_EPOCH` stamps the archive; it defaults to the commit time of
# HEAD. Run from anywhere inside the repository on an arm64 Mac.

set -eu

fail() {
    printf 'package: %s\n' "$*" >&2
    exit 1
}

usage="usage: package --development|--stage-release <component> <version> <bindir> <docs-dir> <output-dir>
       package --adhoc-release <component> <version> <staging-dir>"
[ "$#" -ge 1 ] || fail "$usage"
mode=$1
case $mode in
    --development | --stage-release) [ "$#" -eq 6 ] || fail "$usage" ;;
    --adhoc-release) [ "$#" -eq 4 ] || fail "$usage" ;;
    *) fail "unsupported mode: $mode
$usage" ;;
esac
component=$2
version=$3
case $component in
    cli) require="--require pohunek" ;;
    daemon) require="--require pohunek --require pohunekd --require pohunek-sessiond" ;;
    *) fail "unsupported component: $component" ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
root=$(CDPATH= cd -- "$script_dir/../.." && pwd -P)
target=aarch64-apple-darwin
minimum_macos=$(tr -d ' \n' < "$script_dir/DEPLOYMENT_TARGET")

if [ "$mode" = --adhoc-release ]; then
    staging=$(CDPATH= cd -- "$4" && pwd -P)
    output=$(dirname -- "$staging")
    name=$(basename -- "$staging")
    case $name in
        *-unsigned-development) fail "a development staging directory cannot be packaged as a release: $name" ;;
        "pohunek-$component-$version-$target") ;;
        *) fail "unexpected staging directory name: $name" ;;
    esac
    cd "$root"
    if [ -z "${SOURCE_DATE_EPOCH:-}" ]; then
        SOURCE_DATE_EPOCH=$(git log -1 --format=%ct)
    fi
    export SOURCE_DATE_EPOCH
    # The tree arrives from another runner, so what is about to be signed is
    # checked again here: only regular files and directories, and every
    # program a Mach-O file of the right platform, architecture, and target.
    unexpected=$(find "$staging" ! -type f ! -type d -print | head -n 1)
    [ -z "$unexpected" ] || fail "the staged tree holds a symbolic link or special file: $unexpected"
    # shellcheck disable=SC2086
    "$script_dir/audit-macho" $require --forbid-string "$root" "$staging" >&2
    "$script_dir/sign" "$staging" >&2
    "$script_dir/verify-signed" --adhoc "$staging" >&2
    sh "$root/packaging/write-manifest" "$staging" "$component" "$version" "$target" \
        adhoc "$minimum_macos"
    sh "$root/packaging/archive" "$output" "$name" "$output"
    printf '%s\n' "$output/$name.tar.gz"
    exit 0
fi

bindir=$4
docs=$5
output=$6
# The caller's relative paths mean the caller's directory.
bindir=$(CDPATH= cd -- "$bindir" && pwd -P)
docs=$(CDPATH= cd -- "$docs" && pwd -P)
output=$(CDPATH= cd -- "$output" && pwd -P)

cd "$root"
if [ -z "${SOURCE_DATE_EPOCH:-}" ]; then
    SOURCE_DATE_EPOCH=$(git log -1 --format=%ct)
fi
export SOURCE_DATE_EPOCH

name=$("$root/packaging/stage-archive" "$component" "$version" "$target" "$bindir" "$docs" "$output")
if [ "$mode" = --development ]; then
    suffix=-unsigned-development
    rm -rf -- "$output/$name$suffix"
    mv -- "$output/$name" "$output/$name$suffix"
    name=$name$suffix
fi
staging=$output/$name

# $require holds the per-component `--require` list; it is intentionally
# word-split into separate arguments.
# shellcheck disable=SC2086
"$script_dir/audit-macho" $require --forbid-string "$root" "$staging" >&2
if [ "$mode" = --stage-release ]; then
    printf '%s\n' "$staging"
    exit 0
fi
sh "$root/packaging/write-manifest" "$staging" "$component" "$version" "$target" \
    unsigned-development "$minimum_macos"
sh "$root/packaging/archive" "$output" "$name" "$output"
printf '%s\n' "$output/$name.tar.gz"
