#!/bin/sh
# Verify the ad-hoc signatures of an archive staging directory.
#
# usage: verify-signed --adhoc <staging-dir>
#
# Every Mach-O file must pass `codesign --verify --strict` and carry an ad-hoc
# signature (`Signature=adhoc`). An unsigned file, a signature that does not
# verify, and a certificate-signed file (a `Developer ID` authority) all fail:
# the archive's `signing adhoc` claim must describe exactly what is inside.
# Every problem is reported before the exit status 1.

set -eu

fail() {
    printf 'verify-signed: %s\n' "$*" >&2
    exit 2
}

usage="usage: verify-signed --adhoc <staging-dir>"
[ "$#" -eq 2 ] || fail "$usage"
[ "$1" = --adhoc ] || fail "$usage"
staging=$2
[ -d "$staging" ] || fail "not a directory: $staging"
for tool in codesign od find; do
    command -v "$tool" >/dev/null 2>&1 || fail "required tool not found: $tool"
done

failures=0
checked=0
problem() {
    printf 'FAIL %s: %s\n' "$1" "$2" >&2
    failures=$((failures + 1))
}

is_macho() {
    case $(od -An -tx1 -N4 "$1" 2>/dev/null | tr -d ' \n') in
        cffaedfe | cafebabe | bebafeca | feedfacf | cefaedfe | feedface | cafebabf | bfbafeca) return 0 ;;
        *) return 1 ;;
    esac
}

scratch=$(mktemp -d "${TMPDIR:-/tmp}/pohunek-verify.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

find "$staging" -type f -print | LC_ALL=C sort > "$scratch/files"
while IFS= read -r file; do
    is_macho "$file" || continue
    if ! codesign --verify --strict --verbose=2 "$file" 2>"$scratch/verify"; then
        problem "$file" "code signature does not verify: $(tr '\n' ' ' < "$scratch/verify")"
        continue
    fi
    if ! codesign -dvv "$file" >"$scratch/details" 2>&1; then
        problem "$file" "codesign cannot describe it"
        continue
    fi
    if grep -q '^Authority=' "$scratch/details"; then
        problem "$file" "signed with a certificate, not ad-hoc"
        continue
    fi
    if ! grep -q '^Signature=adhoc' "$scratch/details"; then
        problem "$file" "not ad-hoc signed"
        continue
    fi
    checked=$((checked + 1))
done < "$scratch/files"

if [ "$checked" -eq 0 ] && [ "$failures" -eq 0 ]; then
    printf 'verify-signed: no Mach-O file found below %s\n' "$staging" >&2
    exit 1
fi
if [ "$failures" -ne 0 ]; then
    printf 'verify-signed: %s problem(s)\n' "$failures" >&2
    exit 1
fi
printf 'verify-signed: %s ad-hoc signed file(s) verified\n' "$checked"
