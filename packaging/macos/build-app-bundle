#!/bin/sh
# Assemble the Pohunek.app bundle around a built pohunek-gui binary.
#
# usage: build-app-bundle <pohunek-gui-binary> <version> <output-dir>
#
# Creates <output-dir>/Pohunek.app and prints its path. The bundle gives the
# GUI the identity macOS needs for a Finder or Dock launch and for desktop
# notifications: a stable bundle identifier, a version, and the minimum macOS
# version. It carries no copy of the CLI, the daemon, or the session worker:
# the app finds the installed `pohunek` through the same executable resolution
# as a terminal-launched GUI (`pohunek_bin` in gui.toml, the login-shell PATH,
# then `~/.local/bin`, where `pohunek service install` places it).
#
# The Info.plist is written with plutil, which serializes every value; nothing
# is interpolated into XML. The bundle is not signed here (`sign` does that).

set -eu

fail() {
    printf 'build-app-bundle: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 3 ] || fail "usage: build-app-bundle <pohunek-gui-binary> <version> <output-dir>"
binary=$1
version=$2
output=$3

[ -f "$binary" ] && [ -x "$binary" ] || fail "not an executable file: $binary"
case $version in
    [0-9]*.[0-9]*.[0-9]*) ;;
    *) fail "version must be X.Y.Z: $version" ;;
esac
case $version in
    *[!0-9.]*) fail "version must be X.Y.Z: $version" ;;
esac
[ -d "$output" ] || fail "not a directory: $output"
command -v plutil >/dev/null 2>&1 || fail "plutil is required (macOS only)"

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
minimum_macos=$(tr -d ' \n' < "$script_dir/DEPLOYMENT_TARGET")

# Reverse-DNS identifier, shared with the launchd label namespace of the
# service (`io.github.zajca.pohunek.<ns>.daemon`). It never changes: it keys
# the app's notification authorization and keychain access.
bundle_identifier=io.github.zajca.pohunek.gui
executable_name=pohunek-gui

app=$output/Pohunek.app
rm -rf -- "$app"
mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
cp "$binary" "$app/Contents/MacOS/$executable_name"
chmod 0755 "$app/Contents/MacOS/$executable_name"
printf 'APPL????' > "$app/Contents/PkgInfo"

plist=$app/Contents/Info.plist
plutil -create xml1 "$plist"
set_string() {
    plutil -insert "$1" -string "$2" "$plist"
}
set_string CFBundleIdentifier "$bundle_identifier"
set_string CFBundleName Pohunek
set_string CFBundleDisplayName Pohunek
set_string CFBundleExecutable "$executable_name"
set_string CFBundlePackageType APPL
set_string CFBundleSignature '????'
set_string CFBundleInfoDictionaryVersion 6.0
set_string CFBundleShortVersionString "$version"
set_string CFBundleVersion "$version"
set_string LSMinimumSystemVersion "$minimum_macos"
set_string LSApplicationCategoryType public.app-category.developer-tools
set_string NSPrincipalClass NSApplication
plutil -insert NSHighResolutionCapable -bool true "$plist"
plutil -insert LSArchitecturePriority -array "$plist"
plutil -insert LSArchitecturePriority.0 -string arm64 "$plist"
plutil -lint "$plist" >/dev/null || fail "the generated Info.plist is invalid"

printf '%s\n' "$app"
