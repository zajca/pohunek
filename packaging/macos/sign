#!/bin/sh
# Sign every Mach-O file and app bundle of an archive staging directory with
# the Developer ID Application identity.
#
# usage: sign <staging-dir>
#
# The identity and keychain come from MACOS_SIGNING_IDENTITY and
# MACOS_SIGNING_KEYCHAIN (set by `signing-keychain create`); both are required,
# so a missing credential fails the build instead of producing an unsigned
# artifact. Signatures use the hardened runtime and a secure timestamp, which
# notarization requires. Bare binaries get the stable identifier
# `io.github.zajca.pohunek.<file name>`; an app bundle is signed after its
# executable and takes its identifier from its Info.plist. No entitlement is
# requested unless `packaging/macos/entitlements/<file name>.plist` exists.

set -eu

fail() {
    printf 'sign: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 1 ] || fail "usage: sign <staging-dir>"
staging=$1
[ -d "$staging" ] || fail "not a directory: $staging"
[ -n "${MACOS_SIGNING_IDENTITY:-}" ] || fail "MACOS_SIGNING_IDENTITY is not set"
[ -n "${MACOS_SIGNING_KEYCHAIN:-}" ] || fail "MACOS_SIGNING_KEYCHAIN is not set"
for tool in codesign od find; do
    command -v "$tool" >/dev/null 2>&1 || fail "required tool not found: $tool"
done

identifier_prefix=io.github.zajca.pohunek
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)

is_macho() {
    case $(od -An -tx1 -N4 "$1" 2>/dev/null | tr -d ' \n') in
        cffaedfe | cafebabe | bebafeca | feedfacf | cefaedfe | feedface | cafebabf | bfbafeca) return 0 ;;
        *) return 1 ;;
    esac
}

scratch=$(mktemp -d "${TMPDIR:-/tmp}/pohunek-sign.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

# Executables inside app bundles first, then the bundles; bare Mach-O files
# outside any bundle are signed on their own.
find "$staging" -type d -name '*.app' -prune -print | LC_ALL=C sort > "$scratch/apps"
find "$staging" -type f -print | LC_ALL=C sort > "$scratch/files"
signed=0
while IFS= read -r file; do
    inside_app=no
    while IFS= read -r app; do
        case $file in
            "$app"/*) inside_app=yes ;;
        esac
    done < "$scratch/apps"
    [ "$inside_app" = no ] || continue
    is_macho "$file" || continue
    name=$(basename "$file")
    printf 'signing %s\n' "$file"
    entitlements=$script_dir/entitlements/$name.plist
    if [ -f "$entitlements" ]; then
        codesign --force --options runtime --timestamp \
            --sign "$MACOS_SIGNING_IDENTITY" --keychain "$MACOS_SIGNING_KEYCHAIN" \
            --identifier "$identifier_prefix.$name" --entitlements "$entitlements" "$file"
    else
        codesign --force --options runtime --timestamp \
            --sign "$MACOS_SIGNING_IDENTITY" --keychain "$MACOS_SIGNING_KEYCHAIN" \
            --identifier "$identifier_prefix.$name" "$file"
    fi
    codesign --verify --strict --verbose=2 "$file"
    signed=$((signed + 1))
done < "$scratch/files"

while IFS= read -r app; do
    [ -n "$app" ] || continue
    [ -d "$app/Contents/MacOS" ] || fail "$app has no Contents/MacOS"
    for executable in "$app"/Contents/MacOS/*; do
        [ -f "$executable" ] || continue
        is_macho "$executable" || fail "$executable is not a Mach-O file"
        printf 'signing %s\n' "$executable"
        codesign --force --options runtime --timestamp \
            --sign "$MACOS_SIGNING_IDENTITY" --keychain "$MACOS_SIGNING_KEYCHAIN" "$executable"
    done
    printf 'signing %s\n' "$app"
    codesign --force --options runtime --timestamp \
        --sign "$MACOS_SIGNING_IDENTITY" --keychain "$MACOS_SIGNING_KEYCHAIN" "$app"
    codesign --verify --deep --strict --verbose=2 "$app"
    signed=$((signed + 1))
done < "$scratch/apps"

[ "$signed" -gt 0 ] || fail "nothing to sign below $staging"
printf 'sign: signed %s item(s)\n' "$signed"
