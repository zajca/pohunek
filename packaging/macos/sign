#!/bin/sh
# Ad-hoc sign every Mach-O file of an archive staging directory.
#
# usage: sign <staging-dir>
#
# An ad-hoc signature (`codesign --sign -`) needs no certificate, keychain, or
# secret: it seals the code so arm64 macOS will run it and a later modification
# is detectable, but it names no signer. Every bare Mach-O file gets the stable
# identifier `io.github.zajca.pohunek.<file name>`. Signing rewrites the file, so
# it must run before the manifest hashes the tree. App bundles are not part of a
# CLI or daemon archive and are refused.

set -eu

fail() {
    printf 'sign: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 1 ] || fail "usage: sign <staging-dir>"
staging=$1
[ -d "$staging" ] || fail "not a directory: $staging"
for tool in codesign od find; do
    command -v "$tool" >/dev/null 2>&1 || fail "required tool not found: $tool"
done

identifier_prefix=io.github.zajca.pohunek

is_macho() {
    case $(od -An -tx1 -N4 "$1" 2>/dev/null | tr -d ' \n') in
        cffaedfe | cafebabe | bebafeca | feedfacf | cefaedfe | feedface | cafebabf | bfbafeca) return 0 ;;
        *) return 1 ;;
    esac
}

scratch=$(mktemp -d "${TMPDIR:-/tmp}/pohunek-sign.XXXXXX")
trap 'rm -rf -- "$scratch"' EXIT

app=$(find "$staging" -type d -name '*.app' -print | head -n 1)
[ -z "$app" ] || fail "app bundles are not signed here: $app"
find "$staging" -type f -print | LC_ALL=C sort > "$scratch/files"
signed=0
while IFS= read -r file; do
    is_macho "$file" || continue
    name=$(basename "$file")
    printf 'signing %s\n' "$file"
    codesign --force --sign - --identifier "$identifier_prefix.$name" "$file"
    codesign --verify --strict --verbose=2 "$file"
    signed=$((signed + 1))
done < "$scratch/files"

[ "$signed" -gt 0 ] || fail "nothing to sign below $staging"
printf 'sign: signed %s item(s)\n' "$signed"
