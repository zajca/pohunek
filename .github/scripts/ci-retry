#!/usr/bin/env bash
# Runs a command with bounded retries for flaky CI network steps (#2198).
#
# Every attempt carries its own timeout: the command runs in its own process
# group so a stuck attempt (a hung DNS lookup, a stalled download) is killed
# together with its grandchildren, never left behind to leak into the next
# attempt. The wait between attempts starts at the backoff value and doubles
# after every failure. A missing flag is a usage error; exhausting the
# attempts exits with the last attempt's code so the caller's failure reason
# is preserved.
#
# Interface:
#   ci-retry --label <name> --attempts <n> --attempt-timeout <seconds> \
#     --backoff <seconds> -- command args...
# All flags are required. <label> names the retried unit in the log lines and
# in the `::error` annotation; it must not contain `=` or a newline because a
# failing run appends `CI_INFRA_FAILURE=<label>` to $GITHUB_ENV (when set) so
# a later lane (#2205) can link the retry to the incident follow-ups.
#
# The marker alone never proves an infrastructure cause: it fires for every
# exhausted retry, including deterministic product failures (a lockfile the
# command rejects, a missing binary). #2205 must not treat it as proof of a
# network failure without checking the step log first.
#
# Attempt timeouts are per command class, from the p99 of successful main
# runs plus headroom (cargo fetch 8 s, apt 11 s, npm 7 s, bun 3 s, rustup
# 13 s, uv 8 s, zig 57 s): 180 s for the wrapped installers. A single
# direct download already carries curl's own --max-time (120 s in the
# download actions), which is not a helper call. The worst case (three
# timed-out 180 s attempts plus the 10 s and 20 s backoff waits plus the
# KILL_GRACE_SECONDS grace after each TERM) stays inside the smallest step
# timeout that guards these steps today (10 minutes). Per-request knobs stay
# at each tool: npm's own --fetch-timeout (default 300 s, longer than one
# attempt, so it never fires inside the helper) and --fetch-retries (npm
# docs: https://docs.npmjs.com/cli/v11/using-npm/config#fetch-retries),
# CARGO_NET_RETRY with CARGO_HTTP_TIMEOUT (cargo docs:
# https://doc.rust-lang.org/cargo/reference/config.html#netretry),
# RUSTUP_DOWNLOAD_TIMEOUT (rustup docs:
# https://rust-lang.github.io/rustup/devel/environment-variables.html)
# paired with RUSTUP_MAX_RETRIES (a number the action controls, equal to
# the helper attempts), UV_HTTP_TIMEOUT (uv docs:
# https://docs.astral.sh/uv/reference/settings/#http-timeout) with
# UV_HTTP_RETRIES, BUN_CONFIG_HTTP_RETRY_COUNT (bun default 5; no timeout
# knob, source: `bun --help` has no timeout flag), curl --connect-timeout
# and --max-time. Note RUSTUP_DOWNLOAD_TIMEOUT equals the attempt timeout
# (180 = 180), so a single rustup request that runs exactly to its own
# limit also ends the attempt: the helper is the layer that always fires.
#
# Portable bash 3.2 compatible with the GitHub macOS runners. No bashisms
# beyond POSIX plus $(( )), $( ), and kill -SIGNAL -pgid.

set -u
watchdog_sleep=""

# Grace between TERM and KILL of an over-time attempt, in whole seconds.
KILL_GRACE_SECONDS=5

usage() {
    echo "usage: ci-retry --label <name> --attempts <n> --attempt-timeout <seconds> --backoff <seconds> -- command args..." >&2
    exit 2
}

label=""
attempts=""
attempt_timeout=""
backoff=""

while [ $# -gt 0 ]; do
    case "$1" in
        --label)
            [ $# -ge 2 ] || usage
            label="$2"
            shift 2
            ;;
        --attempts)
            [ $# -ge 2 ] || usage
            attempts="$2"
            shift 2
            ;;
        --attempt-timeout)
            [ $# -ge 2 ] || usage
            attempt_timeout="$2"
            shift 2
            ;;
        --backoff)
            [ $# -ge 2 ] || usage
            backoff="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -*)
            usage
            ;;
        *)
            break
            ;;
    esac
done

[ -n "$label" ] && [ -n "$attempts" ] && [ -n "$attempt_timeout" ] && [ -n "$backoff" ] && [ $# -gt 0 ] || usage

case "$label" in
    *=* | *"
"*)
        usage
        ;;
esac

case "$attempts" in
    '' | *[!0-9]* | 0*)
        usage
        ;;
esac
case "$attempt_timeout" in
    '' | *[!0-9]* | 0*)
        usage
        ;;
esac
case "$backoff" in
    '' | *[!0-9]*)
        usage
        ;;
esac

# Runs "$@" once in its own process group with a watchdog: when the attempt
# outlives $attempt_timeout the whole group gets TERM, then KILL after
# $KILL_GRACE_SECONDS. Returns the command's exit status.
run_one_attempt() {
    attempt_rc=""
    set -m
    "$@" &
    cmd_pid=$!
    set +m
    if [ -z "${cmd_pid:-}" ]; then
        printf 'ci-retry: %s could not start the command\n' "$label" >&2
        return 127
    fi
    (
        trap 'kill "$watchdog_sleep" 2>/dev/null; wait "$watchdog_sleep" 2>/dev/null' TERM
        sleep "$attempt_timeout" &
        watchdog_sleep=$!
        if wait "$watchdog_sleep" 2>/dev/null; then
            kill -TERM "-$cmd_pid" 2>/dev/null
            sleep "$KILL_GRACE_SECONDS" 2>/dev/null
            kill -KILL "-$cmd_pid" 2>/dev/null
        fi
    ) &
    watchdog_pid=$!
    set +m
    wait "$cmd_pid" 2>/dev/null
    attempt_rc=$?
    kill "$watchdog_pid" 2>/dev/null
    wait "$watchdog_pid" 2>/dev/null
    return "$attempt_rc"
}

delay="$backoff"
i=1
rc=1
while [ "$i" -le "$attempts" ]; do
    echo "ci-retry: $label attempt $i/$attempts"
    rc=0
    run_one_attempt "$@" || rc=$?
    if [ "$rc" -eq 0 ]; then
        exit 0
    fi
    echo "ci-retry: $label attempt $i/$attempts failed (exit $rc)"
    if [ "$i" -lt "$attempts" ]; then
        sleep "$delay"
        delay=$((delay * 2))
    fi
    i=$((i + 1))
done

echo "::error title=Infrastructure::$label failed after $attempts attempts (exit $rc)" >&2
if [ -n "${GITHUB_ENV:-}" ]; then
    printf 'CI_INFRA_FAILURE=%s\n' "$label" >> "$GITHUB_ENV"
fi
exit "$rc"
